{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "cv:pdf": "node scripts/cv-pdf.ts",
    "lint": "stylelint --allow-empty-input \"src/**/*.{css,astro}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "serve": "wrangler dev --port 8787 --ip 127.0.0.1 --show-interactive-dev-session=false",
    "test:e2e": "playwright test --project=chromium --project=webkit --project=firefox",
    "test:perf": "playwright test --project=lighthouse"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "astro": "^7.4.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.5.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.152.0"
  }
}
