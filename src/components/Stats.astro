---
import SkyGradient from './SkyGradient.astro';

interface Props {
  stats: { value: string; label: string }[];
}

const { stats } = Astro.props;
---

{/*
  The About stats on one band of the hero's living Blue sky, like an instrument panel: white
  numbers, each over its label, that count up the first time they're seen. A navy wash deepens the
  sky under the text.
*/}
<div class="stats" data-reveal="rise">
  <SkyGradient class="stats-sky" scale={0.5} />
  <ul class="cells" role="list">
    {stats.map(({ value, label }) => (
      <li>
        <span class="stat-num" data-count>
          {value}
        </span>
        <span class="stat-label">{label}</span>
      </li>
    ))}
  </ul>
</div>

<script>
  // Counts each stat up from zero the first time it's seen; the HTML always holds the final value.
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function countUp(element: HTMLElement): void {
    const match = /^(\d+)(.*)$/.exec(element.textContent?.trim() ?? '');
    if (!match) return;
    const target = Number(match[1]);
    const suffix = match[2] ?? '';
    const start = performance.now();
    const step = (now: number) => {
      const progress = Math.min(1, (now - start) / 1200);
      element.textContent = `${Math.round(target * (1 - (1 - progress) ** 3))}${suffix}`;
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  if (!reduced && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          observer.unobserve(entry.target);
          countUp(entry.target as HTMLElement);
        }
      },
      { threshold: 0.6 },
    );
    counters.forEach((counter) => observer.observe(counter));
  }
</script>

<style>
  .stats {
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    isolation: isolate;
  }

  .stats-sky,
  .stats::after {
    position: absolute;
    z-index: -1;
    inset: 0;
  }

  /* After the sky in paint order, so it lies over the sky and under the text. */
  .stats::after {
    background: var(--stats-wash);
    content: '';
  }

  .cells {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 22px 0;
    list-style: none;
  }

  .cells li {
    display: grid;
    align-content: start;
    gap: 4px;
    padding-inline: 22px;
    color: var(--color-on-accent);
    text-shadow: var(--stats-text-shadow);
  }

  .stat-num {
    font-size: 2.25rem;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-tight);
    line-height: 1.05;
  }

  .stat-label {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
  }

  @media (width < 40rem) {
    .cells {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4) 0;
    }
  }
</style>
