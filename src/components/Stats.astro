---
interface Props {
  stats: { value: string; label: string }[];
}

const { stats } = Astro.props;
// Each tile's small picture is chosen by its place in the list (profile.stats): years of
// experience, sectors, case studies, own products.
const amount = (value: string) => Number(/^\d+/.exec(value)?.[0] ?? 0);
---

{/*
  The About stats as widget tiles: each number counts up the first time it's seen, over its label
  and a small picture of what it counts (a run of bars for the years, a dot per sector, a stack of
  case studies, an app icon per product).
*/}
<ul class="tiles" role="list">
  {stats.map(({ value, label }, index) => (
    <li class="tile" data-reveal="rise">
      <span class="tile-num" data-count>
        {value}
      </span>
      <span class="tile-label">{label}</span>
      <span class="tile-visual" aria-hidden="true">
        {index === 0 &&
          Array.from({ length: Math.min(12, amount(value)) }, () => <i class="bar" />)}
        {index === 1 && Array.from({ length: Math.min(8, amount(value)) }, () => <i class="dot" />)}
        {index === 2 && Array.from({ length: 3 }, () => <i class="sheet" />)}
        {index === 3 && Array.from({ length: Math.min(4, amount(value)) }, () => <i class="app" />)}
      </span>
    </li>
  ))}
</ul>

<script>
  // Counts each stat up from zero the first time it's seen; the HTML always holds the final value.
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function countUp(element: HTMLElement): void {
    const match = /^(\d+)(.*)$/.exec(element.textContent?.trim() ?? '');
    if (!match) return;
    const target = Number(match[1]);
    const suffix = match[2] ?? '';
    const start = performance.now();
    const step = (now: number) => {
      const progress = Math.min(1, (now - start) / 1200);
      element.textContent = `${Math.round(target * (1 - (1 - progress) ** 3))}${suffix}`;
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  if (!reduced && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          observer.unobserve(entry.target);
          countUp(entry.target as HTMLElement);
        }
      },
      { threshold: 0.6 },
    );
    counters.forEach((counter) => observer.observe(counter));
  }
</script>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 4px;
    min-height: 150px;
    padding: 16px 16px 14px;
    border-radius: 22px;
    background: var(--color-shell);
    box-shadow: inset 0 0 0 1px var(--color-surface);
  }

  /* The number in a sky-to-navy blend. */
  .tile-num {
    background: var(--gradient-stat);
    background-clip: text;
    color: transparent;
    font-size: var(--text-2xl);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
  }

  .tile-label {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
  }

  .tile-visual {
    display: flex;
    gap: 4px;
    align-items: flex-end;
    align-self: end;
    min-height: 34px;
  }

  .bar {
    flex: 1;
    max-width: 8px;
    height: 34px;
    border-radius: 3px;
    background: var(--color-accent-light);
  }

  .bar:nth-child(odd) {
    height: 22px;
  }

  .bar:last-child {
    background: var(--color-accent);
  }

  .dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .dot:nth-child(even) {
    background: var(--color-accent-light);
  }

  .sheet {
    width: 28px;
    height: 34px;
    margin-inline-end: -16px;
    border: 1px solid var(--color-chip-edge);
    border-radius: 6px;
    background: var(--color-surface);
    box-shadow: 0 2px 6px -2px var(--color-accent-glow);
  }

  .sheet:last-child {
    background: var(--color-chip);
  }

  .app {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--gradient-sky);
    box-shadow: inset 0 0 0 1px var(--color-surface);
  }

  @media (width < 40rem) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tile {
      min-height: 132px;
    }
  }
</style>
