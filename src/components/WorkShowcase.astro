---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { caseStudyDetail } from '../lib/case-studies.ts';
import { withBase } from '../lib/paths.ts';

interface Props {
  studies: CollectionEntry<'caseStudies'>[];
  /** How many projects each tab shows; the first is featured. */
  limit: number;
}

const { studies, limit } = Astro.props;
const groups = (['client', 'product'] as const).map((kind) => ({
  kind,
  studies: studies.filter((study) => study.data.kind === kind).slice(0, limit),
}));
---

{/*
  Selected work: a bento grid on desktop (the featured project large, beside two tiles and over a
  wide one), two columns on tablets, and on phones a swipe deck of the same tiles that snaps card
  by card, with a dot per card. Covers up front, the title in white on a navy fade, the sector (or
  status) as a chip. The whole tile is the link; its name stays the title.
*/}
{groups.map((group) => (
  <div class="showcase" data-kind={group.kind}>
    <ul class="tiles" role="list">
      {group.studies.map((study, index) => (
        <li class="tile" data-reveal="rise">
          <div class="tile-media media sky-grade">
            <Image
              src={study.data.cover}
              alt=""
              widths={index === 0 ? [720, 1440] : [480, 960]}
              sizes={
                index === 0
                  ? '(min-width: 64rem) 640px, (min-width: 40rem) 100vw, 84vw'
                  : '(min-width: 64rem) 320px, (min-width: 40rem) 50vw, 84vw'
              }
              loading="lazy"
            />
          </div>
          <div class="tile-text">
            <p class="chips">
              <span>{caseStudyDetail(study.data)}</span>
            </p>
            <h3 class="tile-title">
              <a href={withBase(`/work/${study.id}`)}>{study.data.title}</a>
            </h3>
            {index === 0 && <p class="summary">{study.data.summary}</p>}
          </div>
        </li>
      ))}
    </ul>
    <p class="dots" aria-hidden="true">
      {group.studies.map(() => (
        <span />
      ))}
    </p>
  </div>
))}

<style>
  .showcase {
    display: grid;
    gap: var(--space-4);
    timeline-scope: --tile-1, --tile-2, --tile-3, --tile-4;
  }

  /* The Work | Personal projects switch in the section heading picks which showcase shows. */
  :global(section:has(input[name='work-filter'][value='product']:checked))
    .showcase[data-kind='client'],
  :global(section:has(input[name='work-filter'][value='client']:checked))
    .showcase[data-kind='product'] {
    display: none;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 240px;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    position: relative;
    display: grid;
    align-content: end;
    overflow: hidden;
    border-radius: 22px;
    box-shadow: var(--shadow-secondary);
    isolation: isolate;
    transition:
      translate var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .tile:first-child {
    grid-row: span 2;
    grid-column: span 2;
  }

  .tile:nth-child(4) {
    grid-column: 1 / -1;
  }

  /* The cover fills the tile; a navy fade over its foot carries the white text. */
  .tile-media,
  .tile::after {
    position: absolute;
    z-index: -1;
    inset: 0;
  }

  .tile::after {
    background: var(--gradient-cover-fade);
    content: '';
  }

  .tile-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 900ms var(--ease-out);
  }

  .tile-text {
    display: grid;
    gap: 8px;
    padding: 20px;
    color: var(--color-on-accent);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chips span {
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-frost);
    color: var(--color-accent-hover);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  .tile-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
  }

  .tile:first-child .tile-title {
    max-width: 24ch;
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
    line-height: 1.15;
  }

  .tile-title a {
    color: inherit;
    text-decoration: none;
  }

  .tile-title a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .tile-title a:focus-visible {
    outline: none;
  }

  .tile:has(a:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  .summary {
    max-width: 44ch;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  /* With a pointer, a tile lifts and its cover eases closer. */
  @media (hover: hover) {
    .tile:hover {
      translate: 0 -4px;
      box-shadow:
        var(--shadow-secondary),
        0 24px 40px -24px var(--color-accent-glow);
    }

    .tile:hover .tile-media img {
      scale: 1.05;
    }
  }

  .dots {
    display: none;
  }

  /* Tablets: two columns, the featured project across both. */
  @media (width < 64rem) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: minmax(220px, auto);
    }

    .tile:first-child {
      grid-row: auto;
      grid-column: 1 / -1;
      min-height: 320px;
    }
  }

  /*
   * Phones: a swipe deck. The row runs out to the frame's edges and snaps card by card, one card a
   * swipe, the next peeking in; the page itself never scrolls sideways. Each card rests at the frame's
   * inset, the last one too: cards are sized against the section (container units), so the row can
   * end with the room the last card needs (the inset plus the peek) without shrinking them. A dot
   * per card sits underneath.
   */
  @media (width < 40rem) {
    .showcase {
      container-type: inline-size;
    }

    .tiles {
      grid-template-columns: none;
      grid-auto-columns: 84cqi;
      grid-auto-flow: column;
      grid-auto-rows: 360px;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--shell-pad));
      padding: 4px calc(var(--shell-pad) + 16cqi) 8px var(--shell-pad);
      overscroll-behavior-x: contain;
      scroll-padding-inline: var(--shell-pad);
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .tile {
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    .tile:is(:first-child, :nth-child(4)) {
      grid-row: auto;
      grid-column: auto;
      min-height: 0;
    }

    .tile:first-child .tile-title {
      font-size: var(--text-lg);
    }

    .summary {
      display: none;
    }

    .dots {
      display: flex;
      gap: 6px;
      justify-content: center;
    }

    .dots span {
      width: 6px;
      height: 6px;
      border-radius: var(--radius-pill);
      background: var(--color-chip-edge);
    }
  }

  /*
   * The dot of the card in view grows into a blue pill: each card's position in the row drives its
   * dot (a scroll-driven animation; a browser without them plays it in no time, and the dots simply
   * count the cards). A snapped card sits right at the edge of its fully-in-view range, so each dot
   * is lit from halfway through its card's arrival to halfway through its leaving.
   */
  @keyframes dot-on {
    from,
    to {
      width: 18px;
      background: var(--color-accent);
    }
  }

  @media (width < 40rem) and (prefers-reduced-motion: no-preference) {
    .tile:nth-child(1) {
      view-timeline: --tile-1 inline;
    }

    .tile:nth-child(2) {
      view-timeline: --tile-2 inline;
    }

    .tile:nth-child(3) {
      view-timeline: --tile-3 inline;
    }

    .tile:nth-child(4) {
      view-timeline: --tile-4 inline;
    }

    .dots span {
      animation: dot-on linear;
    }

    /* Each timeline in a rule of its own, so the minifier can't fold it into the shorthand. */
    .dots span:nth-child(1) {
      animation-timeline: --tile-1;
      animation-range: entry 55% exit 50%;
    }

    .dots span:nth-child(2) {
      animation-timeline: --tile-2;
      animation-range: entry 55% exit 50%;
    }

    .dots span:nth-child(3) {
      animation-timeline: --tile-3;
      animation-range: entry 55% exit 50%;
    }

    .dots span:nth-child(4) {
      animation-timeline: --tile-4;
      animation-range: entry 55% exit 50%;
    }

    /* The dots follow the swipe, not the clock, so Pause animations leaves them to it. */
    :global(.motion-paused) .dots span {
      animation-play-state: running !important;
    }
  }
</style>
