---
interface Props {
  timeZone: string;
}

const { timeZone } = Astro.props;
// The build-time local time; with JavaScript it keeps ticking (content spec §5.1).
const parts = new Intl.DateTimeFormat('en-GB', {
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
  timeZone,
}).formatToParts(new Date());
const hour = parts.find((part) => part.type === 'hour')?.value ?? '00';
const minute = parts.find((part) => part.type === 'minute')?.value ?? '00';
---

<live-clock class="watch watch-face" data-time-zone={timeZone}>
  <time>
    <span data-hour>{hour}</span>
    <span class="colon">:</span>
    <span data-minute>{minute}</span>
  </time>
</live-clock>

<script>
  // A small digital watch face: hours and minutes in the owner's time zone. It wakes as each minute
  // turns, which every time zone does together, and when the page comes back into view, and leaves
  // the page alone in between.
  class LiveClock extends HTMLElement {
    connectedCallback(): void {
      const hour = this.querySelector('[data-hour]');
      const minute = this.querySelector('[data-minute]');
      const timeZone = this.dataset['timeZone'];
      if (!hour || !minute || !timeZone) return;
      const format = new Intl.DateTimeFormat('en-GB', {
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
        timeZone,
      });
      let timer = 0;
      const tick = () => {
        window.clearTimeout(timer);
        const parts = format.formatToParts(new Date());
        for (const [element, type] of [
          [hour, 'hour'],
          [minute, 'minute'],
        ] as const) {
          const value = parts.find((part) => part.type === type)?.value ?? '';
          if (element.textContent !== value) element.textContent = value;
        }
        timer = window.setTimeout(tick, 60_000 - (Date.now() % 60_000));
      };
      tick();
      // A sleeping laptop or a background tab can hold the timer back: catch up on return.
      document.addEventListener('visibilitychange', tick);
    }
  }

  customElements.define('live-clock', LiveClock);
</script>

<style>
  /* A tiny Apple Watch-style face (the shared .watch-face), with a crown on the right. */
  .watch {
    position: relative;
    display: inline-grid;
    place-items: center;
    min-width: 60px;
    height: 32px;
    padding-inline: 10px;
    border-radius: 12px;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    font-weight: var(--weight-medium);
    letter-spacing: 0.02em;
    line-height: 1;
  }

  /* The ridged digital crown, centred on the right edge. */
  .watch::after {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: -5px;
    width: 3px;
    height: 10px;
    border-radius: 0 2px 2px 0;
    background: repeating-linear-gradient(
      var(--watch-metal-light) 0 1px,
      var(--watch-metal-dark) 1px 2px
    );
    translate: 0 -50%;
    content: '';
  }

  /* Flex drops the whitespace between the digits and the colon. */
  time {
    display: inline-flex;
  }

  .colon {
    padding-inline: 1px;
    color: var(--color-accent-light);
  }
</style>
