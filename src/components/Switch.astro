---
/**
 * A pill-shaped segmented switch built from native radio buttons, so it works without JavaScript and
 * keeps arrow-key navigation. The section around it hides content with :has() on the checked value.
 */
interface Props {
  name: string;
  label: string;
  options: { value: string; label: string }[];
}

const { name, label, options } = Astro.props;
---

<fieldset>
  <legend class="visually-hidden">{label}</legend>
  <div class="switch">
    {options.map((option, index) => (
      <label>
        <input
          class="visually-hidden"
          type="radio"
          name={name}
          value={option.value}
          checked={index === 0}
        />
        <span>{option.label}</span>
      </label>
    ))}
  </div>
</fieldset>

<style>
  /* Browsers give a fieldset a min-content minimum width; reset it so the switch can wrap. */
  fieldset {
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .switch {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 4px;
    border-radius: 20px;
    background: var(--color-surface);
    box-shadow: var(--shadow-secondary);
  }

  label {
    position: relative;
    border-radius: var(--radius-pill);
    cursor: pointer;
  }

  span {
    display: block;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }

  label:hover span {
    color: var(--color-text);
  }

  input:checked + span {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  input:focus-visible + span {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
</style>
