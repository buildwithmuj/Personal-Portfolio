---
import Icon from './Icon.astro';
// A back-to-top button, bottom right, as a small watch: the top-bar clock's black glass in its
// brushed-metal rim. Without JavaScript it's a plain link that is always shown; with JavaScript it
// appears once the visitor has scrolled a screen down the page. Its blue ring closes as they near
// the end of the page, like an activity ring on a watch (CSS scroll timeline).
---

<a class="to-top" href="#page-top" aria-label="Back to top">
  <svg class="progress" viewBox="0 0 48 48" width="48" height="48" aria-hidden="true">
    <circle cx="24" cy="24" r="20"></circle>
    <circle class="done" cx="24" cy="24" r="20" pathLength="100"></circle>
  </svg>
  <Icon name="arrow-up" size={20} class="arrow" />
</a>

<script>
  // Hidden by default in CSS whenever scripting is on, so it never flashes (or sits focusable
  // mid-fade) at the top of a page before this runs; this only reveals it.
  const button = document.querySelector<HTMLAnchorElement>('.to-top');
  if (button) {
    const update = () => button.toggleAttribute('data-shown', window.scrollY >= window.innerHeight);
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  .to-top {
    position: fixed;
    z-index: 9;
    inset-block-end: var(--space-6);
    inset-inline-end: var(--space-6);
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 3px solid transparent;
    border-radius: 50%;
    background:
      linear-gradient(160deg, var(--watch-glare), transparent 45%) padding-box,
      linear-gradient(var(--color-inverse), var(--color-inverse)) padding-box,
      var(--watch-rim) border-box;
    box-shadow: 0 6px 14px -4px var(--watch-shadow);
    color: var(--color-on-inverse);
    transition:
      opacity var(--duration-base) var(--ease-standard),
      transform var(--duration-base) var(--ease-standard),
      visibility var(--duration-base);
  }

  .to-top:hover {
    transform: translateY(-2px);
  }

  /* The ring and the arrow share the button's one grid cell. */
  .to-top > svg {
    grid-area: 1 / 1;
  }

  .progress {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--watch-glare);
    stroke-width: 2;
    rotate: -90deg;
  }

  .done {
    stroke: var(--color-accent-light);
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    stroke-linecap: round;
  }

  /* The ring follows the page's scroll position; without support it shows just its faint track. */
  @keyframes scroll-ring {
    to {
      stroke-dashoffset: 0;
    }
  }

  /*
   * The timeline sits in its own rule: in one rule the minifier folds it into the animation
   * shorthand, which browsers reject.
   */
  @supports (animation-timeline: scroll()) {
    .done {
      animation: scroll-ring linear both;
    }

    .to-top .done {
      animation-timeline: scroll(root);
    }
  }

  /* It moves only as the visitor scrolls, so pausing animations (global.css) leaves it running. */
  :global(.motion-paused) .done {
    animation-play-state: running !important;
  }

  /*
   * Hidden near the top; visibility also takes it out of the tab order. With scripting on it starts
   * hidden and the script shows it; without, it stays a plain link that is always there.
   */
  @media (scripting: enabled) {
    .to-top:not([data-shown]) {
      visibility: hidden;
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (width < 40rem) {
    .to-top {
      inset-block-end: var(--space-4);
      inset-inline-end: var(--space-4);
    }
  }
</style>
