---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import TagList from './TagList.astro';

interface Props {
  href: string;
  title: string;
  summary: string;
  cover: ImageMetadata;
  coverAlt: string;
  tags: string[];
}

const { href, title, summary, cover, coverAlt, tags } = Astro.props;
---

<article class="card">
  <Image
    src={cover}
    alt={coverAlt}
    widths={[480, 960]}
    sizes="(min-width: 48rem) 50vw, 100vw"
    loading="lazy"
  />
  <h3>
    <a href={href}>{title}</a>
  </h3>
  <p>{summary}</p>
  <TagList tags={tags} />
</article>

<style>
  .card {
    display: grid;
    gap: var(--space-3);
  }

  img {
    border-radius: var(--radius-md);
  }
</style>
