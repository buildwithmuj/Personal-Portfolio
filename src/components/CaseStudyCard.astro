---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  href: string;
  title: string;
  label: string;
  cover: ImageMetadata;
  coverAlt: string;
  /** 2 on the All work page, where the cards sit directly under the page title. */
  headingLevel?: 2 | 3;
}

const { href, title, label, cover, coverAlt, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<article class="case-card">
  <div class="media">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[348, 696]}
      sizes="(min-width: 48rem) 336px, 100vw"
      loading="lazy"
    />
  </div>
  <p class="card-label">{label}</p>
  <Heading class="title">
    <a href={href}>{title}</a>
  </Heading>
</article>

<style>
  /* Measured from the reference's project cards: 4:3 image, category, then title. */
  .case-card {
    position: relative;
    display: grid;
    gap: 2px;
    border-radius: var(--radius-image);
  }

  .media {
    margin-block-end: 14px;
    overflow: hidden;
    border-radius: var(--radius-image);
    background: var(--color-surface);
  }

  img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: scale var(--duration-base) var(--ease-standard);
  }

  .case-card:hover img {
    scale: 1.03;
  }

  .card-label {
    color: var(--color-text-muted);
  }

  .title {
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  /* The whole card is clickable; the link's name stays the title. */
  .title a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .title a:focus-visible {
    outline: none;
  }

  .case-card:has(a:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 4px;
  }

  .case-card:hover .title a {
    color: var(--color-accent);
  }
</style>
