---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/paths.ts';
import { socialLabels } from '../lib/social.ts';
import LiveClock from './LiveClock.astro';
import SocialIcon from './SocialIcon.astro';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
}

const { profile } = Astro.props;
const nav = [
  { href: withBase('/#about'), label: 'About' },
  { href: withBase('/#work'), label: 'Work' },
  { href: withBase('/#method'), label: 'How I work' },
  { href: withBase('/#contact'), label: 'Contact' },
];
---

<header class="top-bar">
  <p class="where">
    <LiveClock timeZone={profile.timeZone} />
    <span class="city">{profile.locationLabel}</span>
  </p>

  <!-- Desktop: the links and social icons sit in the bar. -->
  <nav class="wide-only" aria-label="Main">
    <ul class="links" role="list">
      {nav.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
  <ul class="socials wide-only" role="list">
    {profile.socials.map((social) => (
      <li>
        <a
          class="icon-button"
          href={social.url}
          aria-label={`${profile.name} on ${socialLabels[social.platform]}`}
        >
          <SocialIcon platform={social.platform} />
        </a>
      </li>
    ))}
  </ul>

  <!-- Phones: a menu button opens the same links in a panel, as in the reference. -->
  <details class="menu">
    <summary aria-label="Menu">
      <svg
        class="open-icon"
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg
        class="close-icon"
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="m6 6 12 12M18 6 6 18"></path>
      </svg>
    </summary>
    <div class="panel">
      <nav aria-label="Main">
        <ul class="panel-links" role="list">
          {nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <ul class="socials" role="list">
        {profile.socials.map((social) => (
          <li>
            <a
              class="icon-button"
              href={social.url}
              aria-label={`${profile.name} on ${socialLabels[social.platform]}`}
            >
              <SocialIcon platform={social.platform} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </details>
</header>

<script>
  // Close the phone menu when one of its links is followed, so the section isn't hidden behind it.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('.top-bar .panel a')) {
    link.addEventListener('click', () => {
      const menu = link.closest('details');
      if (menu) menu.open = false;
    });
  }
</script>

<style>
  .top-bar {
    position: sticky;
    z-index: 10;
    top: var(--bar-offset);
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-3) var(--space-6);
    align-items: center;
    height: var(--bar-height);
    margin-block-end: calc(-1 * var(--bar-height));
    padding: var(--space-3) var(--space-4) var(--space-3) var(--button-pad-x);
    border-radius: var(--radius-card);
    background: var(--color-nav);
    backdrop-filter: blur(12px);
  }

  .where {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    font-size: var(--text-clock);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-clock);
    line-height: 1;
    white-space: nowrap;
  }

  .city {
    color: var(--color-text-muted);
    font-weight: var(--weight-regular);
    letter-spacing: normal;
  }

  .links,
  .socials {
    display: flex;
    gap: var(--space-6);
    padding: 0;
    list-style: none;
  }

  .links {
    justify-content: center;
  }

  nav a {
    color: var(--color-text);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  nav a:hover {
    color: var(--color-accent);
  }

  .socials {
    gap: var(--space-2);
  }

  .icon-button {
    display: grid;
    place-items: center;
    width: var(--icon-button);
    height: var(--icon-button);
    border-radius: var(--radius-icon);
    background: var(--color-surface);
    box-shadow: var(--shadow-secondary);
    color: var(--color-text);
  }

  .menu {
    display: none;
  }

  summary {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-button);
    color: var(--color-text);
    list-style: none;
    cursor: pointer;
  }

  /* Safari still draws the disclosure marker without this. */
  summary::-webkit-details-marker {
    display: none;
  }

  /* A closed panel still takes up layout space off-screen in some browsers; remove it entirely. */
  .menu:not([open]) .panel,
  .close-icon,
  .menu[open] .open-icon {
    display: none;
  }

  .menu[open] .close-icon {
    display: block;
  }

  @media (width < 40rem) {
    .top-bar {
      grid-template-columns: 1fr auto;
      padding-inline-end: var(--space-3);
    }

    .top-bar:has(.menu[open]) {
      border-end-start-radius: 0;
      border-end-end-radius: 0;
      background: var(--color-shell);
    }

    .wide-only {
      display: none;
    }

    .menu {
      display: block;
    }

    /* The panel continues the frosted bar downwards. */
    .panel {
      position: absolute;
      inset-inline: 0;
      inset-block-start: 100%;
      display: grid;
      gap: 40px;
      justify-items: center;
      padding: var(--space-6) var(--space-4) var(--space-8);
      border-end-start-radius: var(--radius-card);
      border-end-end-radius: var(--radius-card);
      background: var(--color-shell);
      box-shadow: 0 24px 40px -24px var(--color-grid-line);
    }

    .panel-links {
      display: grid;
      gap: var(--space-4);
      justify-items: center;
      padding: 0;
      list-style: none;
    }

    .panel-links a {
      font-size: var(--text-lg);
      font-weight: var(--weight-regular);
    }
  }
</style>
