---
import type { CollectionEntry } from 'astro:content';
import { visibleInterview } from '../lib/content.ts';
import { ICONS, ICON_VIEWBOX } from '../lib/icons.ts';
import { withBase } from '../lib/paths.ts';
import { socialLabels } from '../lib/social.ts';
import { currentWeather, type WeatherScene } from '../lib/weather.ts';
import Icon from './Icon.astro';
import LiveClock from './LiveClock.astro';
import SocialIcon from './SocialIcon.astro';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
}

const { profile } = Astro.props;
const weather =
  profile.coordinates &&
  (await currentWeather(profile.coordinates.latitude, profile.coordinates.longitude));
// Every scene the weather can show, each with its icon (src/lib/icons.ts).
const scenes: WeatherScene[] = ['clear', 'cloud', 'fog', 'drizzle', 'rain', 'storm', 'snow'];
// Home leads back to the top from anywhere, the case studies and All work included.
const nav = [
  { href: withBase('/#page-top'), label: 'Home' },
  { href: withBase('/#about'), label: 'About' },
  { href: withBase('/#work'), label: 'Work' },
  { href: withBase('/#skills'), label: 'Toolkit' },
  // Ask me, in one word, while the section shows.
  ...(visibleInterview(profile) ? [{ href: withBase('/#interview'), label: 'Ask' }] : []),
  { href: withBase('/#contact'), label: 'Contact' },
];
---

<header class="top-bar">
  <LiveClock timeZone={profile.timeZone} />

  <!-- Desktop: the links, centred on the page between the clock and the weather. -->
  <nav class="wide-only" aria-label="Main">
    <ul class="links" role="list">
      {nav.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Where the owner is: London's live weather, on the right (the clock is on the left). -->
  <p
    class="where"
    data-lat={profile.coordinates?.latitude}
    data-lon={profile.coordinates?.longitude}
  >
    <span class="city">{profile.locationLabel}</span>
    <span class="weather" hidden={!weather}>
      <svg
        class="weather-icon"
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="currentColor"
        aria-hidden="true"
        focusable="false"
      >
        <use href={`#weather-${weather?.scene ?? 'cloud'}`}></use>
      </svg>
      <span>
        <span data-temp>{weather?.temperature}</span>°
      </span>
      <span class="condition">{weather?.condition}</span>
    </span>
  </p>
  <!-- The weather icons (Framework7, src/lib/icons.ts); the weather shows the one for now. -->
  <svg class="weather-icons" aria-hidden="true" focusable="false">
    {scenes.map((scene) => (
      <symbol id={`weather-${scene}`} viewBox={ICON_VIEWBOX} set:html={ICONS[`weather-${scene}`]} />
    ))}
  </svg>

  <!--
    Phones: the menu button drops a panel from the bar with the links in large type, Book a call
    last in blue, and the CV and social links beneath them on the same grey.
  -->
  <details class="menu">
    <summary aria-label="Menu">
      <Icon name="menu" size={22} class="open-icon" />
      <Icon name="close" size={24} class="close-icon" />
    </summary>
    <div class="panel">
      <nav aria-label="Main">
        <ul class="panel-links" role="list">
          {nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
          {/* The call, the site's main action, as the last link: in blue, one tap away. */}
          <li>
            <a class="call" href={withBase('/#contact')}>
              Book a call
            </a>
          </li>
        </ul>
      </nav>
      <ul class="socials" role="list">
        {/* The CV first: on the home page it opens over the page (CvViewer.astro). */}
        <li>
          <a class="icon-button" href={withBase('/cv.pdf')} aria-label="View CV" data-cv>
            <Icon name="cv" />
          </a>
        </li>
        {profile.socials.map((social) => (
          <li>
            <a
              class="icon-button"
              href={social.url}
              aria-label={`${profile.name} on ${socialLabels[social.platform]}`}
            >
              <SocialIcon platform={social.platform} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </details>
</header>

<script>
  import { parseWeather, weatherUrl, type Weather } from '../lib/weather.ts';

  // The phone menu: following one of its links, a tap anywhere outside it, or Escape closes it
  // (Escape hands focus back to the menu button). This runs first, so nothing below can stop it.
  // A followed link hands focus to the menu button too, before the link acts (the capture phase),
  // so the CV opened from the menu gives focus back there, not to a link hidden in the closed menu.
  const menu = document.querySelector<HTMLDetailsElement>('.top-bar .menu');
  if (menu) {
    const close = () => (menu.open = false);
    document.addEventListener(
      'click',
      ({ target }) => {
        const hit = target as Element;
        if (!menu.open) return;
        const link = menu.contains(hit) && hit.closest('a');
        if (link) menu.querySelector('summary')?.focus();
        if (!menu.contains(hit) || link) close();
      },
      true,
    );
    document.addEventListener('keydown', ({ key }) => {
      if (key !== 'Escape' || !menu.open) return;
      close();
      menu.querySelector('summary')?.focus();
    });
  }

  // Live weather (see the privacy notice): the build-time reading is refreshed from Open-Meteo in
  // the visitor's browser, at most every 15 minutes per tab, so the top bar's temperature and icon
  // show London as it is now. A failed request, or one still waiting after 5 seconds, keeps the
  // build-time reading.
  const where = document.querySelector<HTMLElement>('.top-bar .where');
  const latitude = Number(where?.dataset['lat']);
  const longitude = Number(where?.dataset['lon']);
  const showWeather = (weather: Weather) => {
    const box = where?.querySelector<HTMLElement>('.weather');
    const temperature = box?.querySelector('[data-temp]');
    const condition = box?.querySelector('.condition');
    if (!box || !temperature || !condition) return;
    temperature.textContent = String(weather.temperature);
    condition.textContent = weather.condition;
    box.querySelector('use')?.setAttribute('href', `#weather-${weather.scene}`);
    box.hidden = false;
  };
  if (where?.dataset['lat'] && Number.isFinite(latitude) && Number.isFinite(longitude)) {
    let saved: { at: number; weather: Weather } | undefined;
    try {
      saved = JSON.parse(sessionStorage.getItem('weather') ?? 'null') ?? undefined;
    } catch {
      // Storage can be blocked; fetch instead.
    }
    if (saved && Date.now() - saved.at < 15 * 60 * 1000) {
      showWeather(saved.weather);
    } else {
      fetch(weatherUrl(latitude, longitude), { signal: AbortSignal.timeout(5000) })
        .then((response) => response.json())
        .then((data) => {
          const weather = parseWeather(data);
          if (!weather) return;
          showWeather(weather);
          try {
            sessionStorage.setItem('weather', JSON.stringify({ at: Date.now(), weather }));
          } catch {
            // Storage can be blocked; the next page asks again.
          }
        })
        .catch(() => undefined);
    }
  }
</script>

<style>
  .top-bar {
    position: sticky;
    z-index: 10;
    top: var(--bar-offset);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-3) var(--space-6);
    align-items: center;
    height: var(--bar-height);
    margin-block-end: calc(-1 * var(--bar-height));
    padding: var(--space-3) var(--space-4) var(--space-3) var(--button-pad-x);
    border-radius: var(--radius-card);
    view-transition-name: top-bar;
  }

  /*
   * A strip in the page colour, from the top of the window to the bar's lower edge and past the
   * cards' edges, sits behind the bar: sections scrolling up disappear under it, and nothing shows
   * around the bar's rounded corners. At the top of the page it only covers what is page colour
   * anyway, around the hero's frame.
   */
  .top-bar::before {
    position: absolute;
    z-index: -1;
    inset: calc(-1 * var(--bar-offset)) calc(-1 * var(--gutter)) 0;
    background: var(--color-page);
    content: '';
  }

  /*
   * The bar's own surface, over the strip: the grey of the section frames it sits in at the top.
   * There it is the top of the hero's frame, so its lower corners are square and it joins the frame
   * cleanly; as the page scrolls they round off, and the bar floats as a pill. Browsers without
   * scroll timelines keep the square corners.
   */
  .top-bar::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    border-end-start-radius: 0;
    border-end-end-radius: 0;
    background: var(--color-shell);
    content: '';
  }

  @keyframes bar-float {
    to {
      border-end-start-radius: var(--radius-card);
      border-end-end-radius: var(--radius-card);
    }
  }

  @supports (animation-timeline: scroll()) {
    .top-bar::after {
      animation: bar-float linear both;
    }

    /* Own rule, more specific: the shorthand can't reset the timeline (see ScrollTop). */
    :global(body) .top-bar::after {
      animation-timeline: scroll(root);
      animation-range: 0 var(--bar-offset);
    }
  }

  /* It follows the scroll, not the clock, so pausing animations leaves it running (global.css). */
  :global(.motion-paused) .top-bar::after {
    animation-play-state: running !important;
  }

  /* With the phone menu open its panel hangs below the bar, so the corners stay square. */
  .top-bar:has(.menu[open])::after {
    animation: none;
  }

  /* The clock keeps its own width at the left; the weather sits at the right. */
  .top-bar > :global(live-clock) {
    justify-self: start;
  }

  .where {
    justify-self: end;
    display: flex;
    gap: var(--space-3);
    align-items: center;
    font-size: var(--text-clock);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-clock);
    line-height: 1;
    white-space: nowrap;
  }

  .city,
  .weather {
    color: var(--color-text-muted);
    font-weight: var(--weight-regular);
    letter-spacing: normal;
  }

  /* London's weather: an icon for the conditions, the temperature, and (on wide screens) a word. */
  .weather {
    display: inline-flex;
    gap: 5px;
    align-items: center;
    margin-inline-start: calc(-1 * var(--space-1));
  }

  .weather-icon {
    flex: none;
    color: var(--color-accent);
  }

  .weather-icons {
    position: absolute;
    width: 0;
    height: 0;
  }

  .links,
  .socials {
    display: flex;
    gap: var(--space-6);
    padding: 0;
    list-style: none;
  }

  .links {
    justify-content: center;
  }

  nav a {
    color: var(--color-text);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  nav a:hover {
    color: var(--color-accent);
  }

  .socials {
    gap: var(--space-2);
  }

  .icon-button {
    display: grid;
    place-items: center;
    width: var(--icon-button);
    height: var(--icon-button);
    border-radius: var(--radius-icon);
    background: var(--color-surface);
    box-shadow: var(--shadow-secondary);
    color: var(--color-text);
  }

  .menu {
    display: none;
  }

  summary {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-button);
    color: var(--color-text);
    list-style: none;
    cursor: pointer;
  }

  /* Safari still draws the disclosure marker without this. */
  summary::-webkit-details-marker {
    display: none;
  }

  /* A closed panel still takes up layout space off-screen in some browsers; remove it entirely. */
  .menu:not([open]) .panel,
  .close-icon,
  .menu[open] .open-icon {
    display: none;
  }

  .menu[open] .close-icon {
    display: block;
  }

  /* The weather's description needs room; below this the temperature shows alone. */
  @media (width < 60rem) {
    .condition {
      display: none;
    }
  }

  /* Six links, the weather and four icons need the full column; narrower, the bar uses the menu. */
  @media (width < 48rem) {
    .top-bar {
      grid-template-columns: auto 1fr auto;
      column-gap: var(--space-3);
      padding-inline-end: var(--space-3);
    }

    /* Phones keep the temperature beside the clock, as before. */
    .where {
      justify-self: start;
    }

    .wide-only {
      display: none;
    }

    .menu {
      display: block;
    }

    .top-bar:has(.menu[open]) {
      border-end-start-radius: 0;
      border-end-end-radius: 0;
    }

    /* The panel continues the grey bar downwards: the links, the call last, then the icons. */
    .panel {
      position: absolute;
      inset-inline: 0;
      inset-block-start: 100%;
      display: grid;
      gap: var(--space-6);
      padding: var(--space-4) var(--space-4) var(--space-4);
      border-end-start-radius: var(--radius-card);
      border-end-end-radius: var(--radius-card);
      background: var(--color-shell);
      box-shadow: 0 24px 40px -24px var(--color-grid-line);
      animation: menu-in 200ms var(--ease-standard);
    }

    .panel-links {
      display: grid;
      gap: var(--space-2);
      justify-items: center;
      padding: 0;
      list-style: none;
    }

    .panel-links a {
      font-size: 2rem;
      font-weight: var(--weight-regular);
      letter-spacing: var(--tracking-tight);
    }

    .panel-links .call {
      color: var(--color-accent);
    }

    .panel-links .call:hover {
      color: var(--color-accent-hover);
    }

    .panel > .socials {
      justify-content: center;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }

  /* A one-off entrance: under paused animations it would freeze unseen on its first frame. */
  :global(.motion-paused) .menu[open] .panel {
    animation-play-state: running !important;
  }
</style>
