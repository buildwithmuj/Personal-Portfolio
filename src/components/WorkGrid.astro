---
import type { CollectionEntry } from 'astro:content';
import { caseStudyLabel } from '../lib/case-studies.ts';
import CaseStudyCard from './CaseStudyCard.astro';

interface Props {
  studies: CollectionEntry<'caseStudies'>[];
  /** The most cards to show in each tab; omit to show them all. */
  limit?: number;
}

const { studies, limit } = Astro.props;
const groups = (['client', 'product'] as const).map((kind) => {
  const all = studies.filter((study) => study.data.kind === kind);
  return { kind, studies: limit === undefined ? all : all.slice(0, limit) };
});
---

{groups.map((group) => (
  <ul class="grid" role="list" data-kind={group.kind}>
    {group.studies.map((study) => (
      <li>
        <CaseStudyCard
          href={`/work/${study.id}`}
          title={study.data.title}
          label={caseStudyLabel(study.data)}
          cover={study.data.cover}
          coverAlt={study.data.coverAlt}
        />
      </li>
    ))}
  </ul>
))}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 35px var(--gap-work);
    padding: 0;
    list-style: none;
  }

  /* The Work | Personal projects switch in the section heading picks which list shows. */
  :global(section:has(input[name='work-filter'][value='product']:checked))
    .grid[data-kind='client'],
  :global(section:has(input[name='work-filter'][value='client']:checked))
    .grid[data-kind='product'] {
    display: none;
  }

  @media (width < 40rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
