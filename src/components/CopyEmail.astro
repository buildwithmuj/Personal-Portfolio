---
import Icon from './Icon.astro';

interface Props {
  email: string;
}

const { email } = Astro.props;
---

<copy-email data-email={email}>
  <button type="button" hidden>
    <Icon name="copy" size={17} class="copy-icon" />
    <Icon name="done" size={17} class="done-icon" />
    <span class="visually-hidden">Copy email address</span>
  </button>
  <span class="visually-hidden" role="status"></span>
</copy-email>

<script>
  // Progressive enhancement: the button stays hidden unless the Clipboard API is available (spec §5).
  // A tick shows for two seconds after copying; screen readers hear the status message.
  class CopyEmail extends HTMLElement {
    connectedCallback(): void {
      const button = this.querySelector('button');
      const status = this.querySelector('[role="status"]');
      const email = this.dataset['email'];
      if (!button || !status || !email || !navigator.clipboard) return;
      button.hidden = false;
      let clearTimer: number | undefined;
      button.addEventListener('click', () => {
        window.clearTimeout(clearTimer);
        navigator.clipboard
          .writeText(email)
          .then(
            () => {
              status.textContent = 'Copied';
              this.toggleAttribute('data-copied', true);
            },
            () => {
              status.textContent = 'Copy failed. Use the email link instead.';
            },
          )
          .finally(() => {
            clearTimer = window.setTimeout(() => {
              status.textContent = '';
              this.toggleAttribute('data-copied', false);
            }, 2000);
          });
      });
    }
  }

  customElements.define('copy-email', CopyEmail);
</script>

<style>
  copy-email {
    display: inline-flex;
    flex-shrink: 0;
    margin-inline-start: auto;
  }

  button {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-secondary);
    color: var(--color-text);
    cursor: pointer;
  }

  button:hover {
    color: var(--color-accent);
  }

  .done-icon,
  copy-email[data-copied] .copy-icon {
    display: none;
  }

  copy-email[data-copied] .done-icon {
    display: block;
    color: var(--color-accent);
  }
</style>
