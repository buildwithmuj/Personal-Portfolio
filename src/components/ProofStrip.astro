---
interface Props {
  label: string;
  items: string[];
}

const { label, items } = Astro.props;
---

<div class="proof">
  <p class="proof-label">{label}</p>
  <div class="marquee">
    <ul class="track" role="list">
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
    <ul class="track" role="list" aria-hidden="true">
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
</div>

<style>
  .proof {
    display: grid;
    gap: var(--space-4);
  }

  .proof-label {
    font-weight: var(--weight-medium);
  }

  .marquee {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(
      90deg,
      transparent,
      var(--color-text) 10%,
      var(--color-text) 90%,
      transparent
    );
  }

  .track {
    display: flex;
    flex-shrink: 0;
    gap: var(--space-8);
    padding: 0 var(--space-8) 0 0;
    list-style: none;
    animation: marquee var(--marquee-duration) linear infinite;
  }

  .track li {
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }

  /* Hovering pauses it (content spec §5.2). */
  .marquee:hover .track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    to {
      transform: translateX(-100%);
    }
  }

  /* Under reduced motion the list wraps statically inside the card. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      display: block;
      mask-image: none;
    }

    .track {
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-6);
      padding: 0;
      animation: none;
    }

    .track[aria-hidden='true'] {
      display: none;
    }
  }
</style>
