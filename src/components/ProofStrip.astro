---
import { readFileSync } from 'node:fs';
import { withBase } from '../lib/paths.ts';

interface Props {
  label: string;
  items: { name: string; logo?: string | undefined; scale?: number | undefined }[];
}

const { label, items } = Astro.props;
// Client logos are navy PNGs, 84px tall (public/clients/). Each is sized to the same area rather
// than the same height, so a long wordmark (Barclays) and a compact mark (BP) look equally weighty,
// with square marks capped at MAX_HEIGHT, then nudged by the logo's optional `scale`. Sizes come
// from each PNG's header, so the strip doesn't shift as the logos load.
const AREA = 1600;
const MAX_HEIGHT = 28;
const logos = items.map(({ name, logo, scale = 1 }) => {
  if (!logo) return { name };
  const png = readFileSync(`public${logo}`);
  const aspect = png.readUInt32BE(16) / png.readUInt32BE(20);
  const height = Math.min(MAX_HEIGHT, Math.sqrt(AREA / aspect)) * scale;
  return {
    name,
    src: withBase(logo),
    width: Math.round(height * aspect),
    height: Math.round(height),
  };
});
---

<div class="proof">
  <p class="proof-label">{label}</p>
  <div class="marquee">
    <ul class="track" role="list">
      {logos.map(({ name, src, width, height }) => (
        <li>{src ? <img src={src} alt={name} width={width} height={height} /> : name}</li>
      ))}
    </ul>
    <ul class="track" role="list" aria-hidden="true">
      {logos.map(({ name, src, width, height }) => (
        <li>{src ? <img src={src} alt="" width={width} height={height} /> : name}</li>
      ))}
    </ul>
  </div>
</div>

<style>
  .proof {
    display: grid;
    gap: var(--space-6);
  }

  .proof-label {
    font-weight: var(--weight-medium);
  }

  .marquee {
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(
      90deg,
      transparent,
      var(--color-text) 10%,
      var(--color-text) 90%,
      transparent
    );
  }

  .track {
    display: flex;
    flex-shrink: 0;
    gap: var(--space-8);
    align-items: center;
    padding: 0 var(--space-8) 0 0;
    list-style: none;
    animation: marquee var(--marquee-duration) linear infinite;
  }

  .track li {
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }

  /*
   * Monochrome and quiet, as in the DigiBlu site's client strip: every logo in one ink at under
   * half strength, so they read as a set rather than as eleven brands. Hovering the strip brings
   * them up, and hovering one brings it to full strength in the brand blue.
   */
  .track img {
    display: block;
    filter: brightness(0);
    opacity: 0.4;
    transition: opacity var(--duration-base) var(--ease-standard);
  }

  .marquee:hover .track img {
    opacity: 0.65;
  }

  .marquee .track img:hover {
    filter: var(--filter-accent);
    opacity: 1;
  }

  /* Hovering pauses it (content spec §5.2). */
  .marquee:hover .track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    to {
      transform: translateX(-100%);
    }
  }

  /*
   * Only phones scroll the strip, where the logos can't all fit; wider screens, and reduced motion,
   * show them still, wrapped inside the card.
   */
  @media (prefers-reduced-motion: reduce), (width >= 40rem) {
    .marquee {
      display: block;
      mask-image: none;
    }

    .track {
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-6);
      padding: 0;
      animation: none;
    }

    .track[aria-hidden='true'] {
      display: none;
    }
  }
</style>
