---
interface Props {
  /** Hex colour stops, e.g. the Lagoon palette. */
  stops: string[];
  class?: string;
}

const { stops, class: className } = Astro.props;
---

<flow-gradient class={className} data-stops={JSON.stringify(stops)} aria-hidden="true">
  <canvas></canvas>
</flow-gradient>

<script>
  // The "Flow" gradient from the owner's Feral UI export (Lagoon): each colour stop drifts on its
  // own slow orbit, the field is warped around the centre, and every pixel blends the stops by
  // inverse distance in OKLab. Rendered small and scaled up, since the field is soft. It holds
  // still under reduced motion or the hero's pause button, and stops drawing off screen.
  const SCALE = 1.024; // 0.4 + scale 52 / 100 × 1.2
  const WARP = 0.44; // distortion 44
  const SWIRL = 0.06; // swirl 6
  const SPEED = 0.312; // speed 26 / 100 × 1.2, in time units per second
  const START = 28.5488;

  const linear = (c: number) => (c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
  const gamma = (c: number) =>
    255 * (c <= 0.0031308 ? 12.92 * c : 1.055 * Math.max(0, c) ** (1 / 2.4) - 0.055);
  const smooth = (x: number) => {
    const t = Math.min(1, Math.max(0, x));
    return t * t * (3 - 2 * t);
  };
  const fract = (x: number) => x - Math.floor(x);

  function oklab(hex: string): [number, number, number] {
    const n = parseInt(hex.slice(1), 16);
    const [r, g, b] = [n >> 16, (n >> 8) & 255, n & 255].map((c) => linear(c / 255)) as [
      number,
      number,
      number,
    ];
    const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
    const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
    const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
    return [
      0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s,
      1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s,
      0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s,
    ];
  }

  class FlowGradient extends HTMLElement {
    connectedCallback(): void {
      const canvas = this.querySelector('canvas');
      const context = canvas?.getContext('2d');
      const colours = (JSON.parse(this.dataset['stops'] ?? '[]') as string[]).map(oklab);
      if (!canvas || !context || colours.length < 2) return;
      let time = START;
      let visible = true;
      let last = 0;

      const draw = () => {
        const box = this.getBoundingClientRect();
        const width = 180;
        const height = Math.max(8, Math.round((width * box.height) / Math.max(1, box.width)));
        if (canvas.width !== width || canvas.height !== height) {
          canvas.width = width;
          canvas.height = height;
        }
        const points = colours.map((_, i) => {
          const n = i * 0.37;
          return [
            0.5 + 0.5 * Math.sin(time * (0.6 + fract(i / 3) * 0.9) + n),
            0.5 + 0.5 * Math.cos(time * (0.8 + fract((i + 1) / 4)) + n * 1.5),
          ];
        });
        const image = context.createImageData(width, height);
        for (let y = 0; y < height; y++) {
          for (let x = 0; x < width; x++) {
            let u = ((x + 0.5) / width - 0.5) / SCALE + 0.5;
            let v = ((y + 0.5) / height - 0.5) / SCALE + 0.5;
            const edge = smooth(Math.hypot(u - 0.5, v - 0.5));
            for (let k = 1; k <= 2; k++) {
              u +=
                ((WARP * (1 - edge)) / k) *
                Math.sin(time + k * 0.4 * smooth(v)) *
                Math.cos(0.2 * time + k * 2.4 * smooth(v));
              v += ((WARP * (1 - edge)) / k) * Math.cos(time + k * 2 * smooth(u));
            }
            const turn = -3 * SWIRL * edge;
            const du = u - 0.5;
            const dv = v - 0.5;
            u = Math.cos(turn) * du - Math.sin(turn) * dv + 0.5;
            v = Math.sin(turn) * du + Math.cos(turn) * dv + 0.5;
            let L = 0;
            let A = 0;
            let B = 0;
            let total = 0;
            colours.forEach((colour, i) => {
              const point = points[i] ?? [0.5, 0.5];
              const d = (u - (point[0] ?? 0.5)) ** 2 + (v - (point[1] ?? 0.5)) ** 2;
              const weight = 1 / (d ** 1.75 + 1e-4);
              L += colour[0] * weight;
              A += colour[1] * weight;
              B += colour[2] * weight;
              total += weight;
            });
            L /= total;
            A /= total;
            B /= total;
            const l = (L + 0.3963377774 * A + 0.2158037573 * B) ** 3;
            const m = (L - 0.1055613458 * A - 0.0638541728 * B) ** 3;
            const s = (L - 0.0894841775 * A - 1.291485548 * B) ** 3;
            const at = (y * width + x) * 4;
            image.data[at] = gamma(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s);
            image.data[at + 1] = gamma(-1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s);
            image.data[at + 2] = gamma(-0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s);
            image.data[at + 3] = 255;
          }
        }
        context.putImageData(image, 0, 0);
      };

      const still = () =>
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        document.documentElement.classList.contains('motion-paused');
      // About 25 frames a second is plenty for motion this slow, at half the cost of 60.
      const frame = (now: number) => {
        if (now - last >= 40) {
          if (visible && !document.hidden && !still()) {
            time += (Math.min(100, now - (last || now)) / 1000) * SPEED;
            draw();
          }
          last = now;
        }
        requestAnimationFrame(frame);
      };
      new IntersectionObserver(([entry]) => {
        visible = entry?.isIntersecting ?? true;
      }).observe(this);
      draw();
      requestAnimationFrame(frame);
    }
  }

  customElements.define('flow-gradient', FlowGradient);
</script>

<style>
  flow-gradient {
    display: block;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
