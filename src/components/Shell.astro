---
import Icon from './Icon.astro';
import SkyGradient from './SkyGradient.astro';

interface Props {
  id: string;
  heading?: string;
  /** 1 when the section heading is the page title, e.g. on the All work page. */
  headingLevel?: 1 | 2;
  intro?: string;
  labelledBy?: string;
  inset?: boolean;
  hero?: boolean;
  /** Adds a round toggle to the header; 'closed' starts the section collapsed. */
  collapsible?: 'open' | 'closed';
  /** Paints the hero's living Blue sky behind the whole section instead of the grey frame. */
  sky?: boolean;
}

const {
  id,
  heading,
  headingLevel = 2,
  intro,
  labelledBy,
  inset = false,
  hero = false,
  collapsible,
  sky = false,
} = Astro.props;
const headingId = `${id}-heading`;
const bodyId = `${id}-body`;
const Heading = headingLevel === 1 ? 'h1' : 'h2';
const words = heading?.split(/\s+/) ?? [];
---

<section
  id={id}
  class:list={['shell', { 'shell-inset': inset, 'shell-hero': hero, 'shell-sky': sky }]}
  aria-labelledby={heading ? headingId : labelledBy}
>
  {sky && <SkyGradient class="sky" scale={0.5} />}
  <slot name="lead" />
  {heading && (
    <header class="section-head" data-reveal="heading">
      <div class="section-title">
        <Heading id={headingId}>
          {words.map((word, index) => (
            <>
              {index > 0 && ' '}
              <span class="w">
                <span>{word}</span>
              </span>
            </>
          ))}
        </Heading>
        {intro && <p>{intro}</p>}
      </div>
      <slot name="actions" />
      {collapsible && (
        <button
          class="collapse"
          type="button"
          aria-expanded="true"
          aria-controls={bodyId}
          data-start={collapsible}
          hidden
        >
          {/* A down chevron (to open it) while it's collapsed; an up chevron (to close it) while open. */}
          <Icon name="chevron-down" size={17} class="when-closed" />
          <Icon name="chevron-up" size={17} class="when-open" />
          <span class="visually-hidden">{heading}</span>
        </button>
      )}
    </header>
  )}
  {collapsible ? (
    <div id={bodyId} class="shell-body">
      <slot />
    </div>
  ) : (
    <slot />
  )}
</section>

<script>
  // Collapsible sections. The toggle only appears with JavaScript, so without it every section
  // stays open; with it, a section marked 'closed' starts collapsed. Clicking the title also
  // toggles, for a bigger target on phones; the button is the one keyboards and screen readers use.
  for (const button of document.querySelectorAll<HTMLButtonElement>('.collapse')) {
    const body = document.getElementById(button.getAttribute('aria-controls') ?? '');
    if (!body) continue;
    const show = (open: boolean) => {
      body.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
    };
    const toggle = () => show(button.ariaExpanded !== 'true');
    show(button.dataset['start'] !== 'closed');
    button.hidden = false;
    button.addEventListener('click', toggle);
    button.parentElement?.querySelector('.section-title')?.addEventListener('click', toggle);
  }
</script>
