---
interface Props {
  id: string;
  heading?: string;
  /** 1 when the section heading is the page title, e.g. on the All work page. */
  headingLevel?: 1 | 2;
  intro?: string;
  labelledBy?: string;
  /** Tinted bands alternate with white ones down the page. */
  tint?: boolean;
}

const { id, heading, headingLevel = 2, intro, labelledBy, tint = false } = Astro.props;
const headingId = `${id}-heading`;
const Heading = headingLevel === 1 ? 'h1' : 'h2';
const words = heading?.split(/\s+/) ?? [];
const hasAside = Boolean(intro) || Astro.slots.has('actions');
---

<section
  id={id}
  class:list={['band', { 'band-tint': tint }]}
  aria-labelledby={heading ? headingId : labelledBy}
>
  <div class="container">
    {heading && (
      <header class="section-head" data-reveal="heading">
        <Heading id={headingId}>
          {words.map((word, index) => (
            <>
              {index > 0 && ' '}
              <span class="w">
                <span>{word}</span>
              </span>
            </>
          ))}
        </Heading>
        {hasAside && (
          <div class="section-aside">
            {intro && <p>{intro}</p>}
            <slot name="actions" />
          </div>
        )}
      </header>
    )}
    <slot />
  </div>
</section>
