---
interface Props {
  id: string;
  heading?: string;
  /** 1 when the section heading is the page title, e.g. on the All work page. */
  headingLevel?: 1 | 2;
  intro?: string;
  labelledBy?: string;
  join?: 'top' | 'bottom';
  inset?: boolean;
  hero?: boolean;
  reveal?: boolean;
}

const {
  id,
  heading,
  headingLevel = 2,
  intro,
  labelledBy,
  join,
  inset = false,
  hero = false,
  reveal = true,
} = Astro.props;
const headingId = `${id}-heading`;
const Heading = headingLevel === 1 ? 'h1' : 'h2';
---

<section
  id={id}
  class:list={[
    'shell',
    { 'shell-inset': inset, 'shell-hero': hero, reveal },
    join && `shell-join-${join}`,
  ]}
  aria-labelledby={heading ? headingId : labelledBy}
>
  {heading && (
    <header class="section-head">
      <div class="section-title">
        <Heading id={headingId}>{heading}</Heading>
        {intro && <p>{intro}</p>}
      </div>
      <slot name="actions" />
    </header>
  )}
  <slot />
</section>
