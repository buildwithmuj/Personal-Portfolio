---
interface Props {
  id: string;
  heading?: string;
  /** 1 when the section heading is the page title, e.g. on the All work page. */
  headingLevel?: 1 | 2;
  intro?: string;
  labelledBy?: string;
  inset?: boolean;
  hero?: boolean;
  /** Adds a Show / Hide toggle to the header; 'closed' starts the section collapsed. */
  collapsible?: 'open' | 'closed';
}

const {
  id,
  heading,
  headingLevel = 2,
  intro,
  labelledBy,
  inset = false,
  hero = false,
  collapsible,
} = Astro.props;
const headingId = `${id}-heading`;
const bodyId = `${id}-body`;
const Heading = headingLevel === 1 ? 'h1' : 'h2';
const words = heading?.split(/\s+/) ?? [];
---

<section
  id={id}
  class:list={['shell', { 'shell-inset': inset, 'shell-hero': hero }]}
  aria-labelledby={heading ? headingId : labelledBy}
>
  <slot name="lead" />
  {heading && (
    <header class="section-head" data-reveal="heading">
      <div class="section-title">
        <Heading id={headingId}>
          {words.map((word, index) => (
            <>
              {index > 0 && ' '}
              <span class="w">
                <span>{word}</span>
              </span>
            </>
          ))}
        </Heading>
        {intro && <p>{intro}</p>}
      </div>
      <slot name="actions" />
      {collapsible && (
        <button
          class="btn btn-secondary collapse"
          type="button"
          aria-expanded="true"
          aria-controls={bodyId}
          data-start={collapsible}
          hidden
        >
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="m6 15 6-6 6 6"></path>
          </svg>
          <span data-label>Hide</span>
          <span class="visually-hidden">{` ${heading}`}</span>
        </button>
      )}
    </header>
  )}
  {collapsible ? (
    <div id={bodyId}>
      <slot />
    </div>
  ) : (
    <slot />
  )}
</section>

<script>
  // Collapsible sections. The toggle only appears with JavaScript, so without it every section
  // stays open; with it, a section marked 'closed' starts collapsed.
  for (const button of document.querySelectorAll<HTMLButtonElement>('.collapse')) {
    const body = document.getElementById(button.getAttribute('aria-controls') ?? '');
    const label = button.querySelector('[data-label]');
    if (!body || !label) continue;
    const show = (open: boolean) => {
      body.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Hide' : 'Show';
    };
    show(button.dataset['start'] !== 'closed');
    button.hidden = false;
    button.addEventListener('click', () => show(button.ariaExpanded !== 'true'));
  }
</script>
