---
/**
 * The availability pill: a white pill with a softly glowing green dot, in the hero, the phone menu
 * and Let's work together. Given `short`, phones show that shorter line instead, its last word
 * rotating (the hero's role-rotator), while screen readers still get the whole line.
 */
interface Props {
  text: string;
  short?: { lead: string; words: string[] } | undefined;
  class?: string;
}

const { text, short, class: className } = Astro.props;
// The rotating word's box is sized to the longest word, so the pill doesn't change width.
const longestWord = short?.words.reduce((longest, word) =>
  word.length > longest.length ? word : longest,
);
---

<p class:list={['availability', className]}>
  <span class="available-dot" aria-hidden="true"></span>
  <span class="availability-full">{text}</span>
  {short && (
    <span class="availability-short" aria-hidden="true">
      {short.lead}{' '}
      <role-rotator class="pill-words" data-roles={JSON.stringify(short.words)}>
        <span>{short.words[0]}</span>
        <span class="sizer">{longestWord}</span>
      </role-rotator>
    </span>
  )}
</p>

<style>
  .availability {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    margin: 0;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: var(--shadow-secondary);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  .availability-short {
    display: none;
  }

  .pill-words {
    display: inline-grid;
    overflow: hidden;
    vertical-align: bottom;
  }

  .pill-words > span {
    grid-area: 1 / 1;
  }

  .pill-words > .sizer {
    visibility: hidden;
  }

  /* The dot glows outwards every two seconds; it holds still under reduced motion or the pause. */
  .available-dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-available);
  }

  @keyframes available-pulse {
    to {
      box-shadow: 0 0 0 6px transparent;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .available-dot {
      box-shadow: 0 0 0 0 var(--color-available-glow);
      animation: available-pulse 2s var(--ease-out) infinite;
    }
  }

  /* Phones show the shorter line; the whole one stays for screen readers, visually hidden. */
  @media (width < 40rem) {
    .availability-short {
      display: inline;
    }

    .availability-full:has(~ .availability-short) {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
