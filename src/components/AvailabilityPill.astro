---
/**
 * The availability pill: a white pill with a steady, softly glowing green dot, in the hero and in
 * Let's work together. The same whole line everywhere, phones included: nothing in it moves.
 */
interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;
---

<p class:list={['availability', className]}>
  <span class="available-dot" aria-hidden="true"></span>
  <span class="availability-text">{text}</span>
</p>

<style>
  .availability {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    margin: 0;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: var(--shadow-secondary);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }

  /* A steady green dot in a soft glow: it says "available" without needing to move. */
  .available-dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-available);
    box-shadow: 0 0 0 3px var(--color-available-glow);
  }
</style>
