---
import type { CollectionEntry } from 'astro:content';
import Shell from '../Shell.astro';
import SocialIcon from '../SocialIcon.astro';

interface Props {
  testimonials: CollectionEntry<'testimonials'>['data'][];
  heading: string;
  intro: string;
}

const { testimonials, heading, intro } = Astro.props;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((part) => part[0] ?? '')
    .join('')
    .slice(0, 2);
const monthYear = new Intl.DateTimeFormat('en-GB', {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const sources = { linkedin: 'LinkedIn', x: 'X', email: 'email' } as const;
// Newest first, as in a feed; undated quotes go last.
const posts = testimonials.toSorted((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));
---

<Shell
  id="testimonials"
  heading={heading}
  intro={intro}
  collapsible="open"
  icon="M10 11H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v6c0 2.5-1.5 4-4 5M19 11h-4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v6c0 2.5-1.5 4-4 5"
>
  <ul class="posts" role="list">
    {posts.map((testimonial, index) => (
      <li class="post" data-reveal="rise">
        <figure>
          <figcaption class="author">
            <span class="avatar" data-tone={(index % 4) + 1} aria-hidden="true">
              {initials(testimonial.name)}
            </span>
            <span class="who">
              <span class="name">{testimonial.name}</span>
              <span class="role">{testimonial.role}</span>
            </span>
            {(testimonial.source === 'linkedin' || testimonial.source === 'x') && (
              <span class="source">
                <SocialIcon platform={testimonial.source} />
              </span>
            )}
          </figcaption>
          <blockquote>
            <p>{testimonial.quote}</p>
          </blockquote>
          {(testimonial.date || testimonial.source) && (
            <p class="meta">
              {testimonial.date && (
                <time datetime={testimonial.date}>
                  {monthYear.format(new Date(`${testimonial.date}-01T00:00:00Z`))}
                </time>
              )}
              {testimonial.date && testimonial.source && ' · '}
              {testimonial.source && `via ${sources[testimonial.source]}`}
            </p>
          )}
        </figure>
      </li>
    ))}
  </ul>
</Shell>

<style>
  /*
   * Testimonials as posts, in the manner of a social feed: an author row (initials avatar, name, and
   * role where a handle would be), the words, then when and where they were given. The cards flow
   * into two columns like a feed on wide screens and one on phones.
   */
  .posts {
    padding: 0;
    columns: 2 20rem;
    column-gap: var(--space-4);
    list-style: none;
  }

  .post {
    margin-block-end: var(--space-4);
    break-inside: avoid;
  }

  figure {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-4) var(--space-4) var(--space-3);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }

  .author {
    display: flex;
    gap: var(--space-3);
    align-items: center;
  }

  .avatar {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--gradient-avatar-1);
    color: var(--color-avatar-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .avatar[data-tone='2'] {
    background: var(--gradient-avatar-2);
  }

  .avatar[data-tone='3'] {
    background: var(--gradient-avatar-3);
  }

  .avatar[data-tone='4'] {
    background: var(--gradient-avatar-4);
  }

  .who {
    display: grid;
    flex: 1;
    min-width: 0;
    line-height: 1.3;
  }

  .name {
    font-weight: var(--weight-medium);
  }

  .role {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .source {
    align-self: flex-start;
    color: var(--color-text-muted);
  }

  blockquote {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-body);
  }

  .meta {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
