---
import type { CollectionEntry } from 'astro:content';
import Shell from '../Shell.astro';

interface Props {
  testimonials: CollectionEntry<'testimonials'>['data'][];
  heading: string;
  intro: string;
}

const { testimonials, heading, intro } = Astro.props;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((part) => part[0] ?? '')
    .join('')
    .slice(0, 2);
---

<Shell
  id="testimonials"
  heading={heading}
  intro={intro}
  collapsible="open"
  icon="M10 11H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v6c0 2.5-1.5 4-4 5M19 11h-4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v6c0 2.5-1.5 4-4 5"
>
  <div class="spotlight">
    <ul class="quotes" role="list">
      {testimonials.map((testimonial) => (
        <li class="quote">
          <figure>
            <blockquote>
              <p>{testimonial.quote}</p>
            </blockquote>
            <figcaption>
              <span class="name">{testimonial.name}</span>
              <span class="role">{testimonial.role}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <fieldset class="people">
      <legend class="visually-hidden">Choose whose words to read</legend>
      <div class="avatars">
        {testimonials.map((testimonial, index) => (
          <label>
            <input
              class="visually-hidden"
              type="radio"
              name="testimonial"
              value={String(index)}
              checked={index === 0}
            />
            <span class="avatar" aria-hidden="true">
              {initials(testimonial.name)}
            </span>
            <span class="visually-hidden">{testimonial.name}</span>
          </label>
        ))}
        {testimonials.length > 1 && (
          <button class="pause" type="button" hidden>
            <svg
              viewBox="0 0 24 24"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <path class="when-playing" d="M9 6v12M15 6v12"></path>
              <path class="when-paused" d="M8 5.5v13l10-6.5z"></path>
            </svg>
            <span class="visually-hidden">Pause testimonials</span>
          </button>
        )}
      </div>
    </fieldset>
  </div>
</Shell>

<script>
  // Moves to the next person every five seconds, in order, looping. It waits while the pointer or
  // keyboard focus is inside, and the button pauses it; picking someone pauses it too (WCAG 2.2.2).
  // Never under reduced motion.
  const spotlight = document.querySelector<HTMLElement>('.spotlight');
  const button = spotlight?.querySelector<HTMLButtonElement>('.pause');
  const label = button?.querySelector('span');
  const radios = [...(spotlight?.querySelectorAll<HTMLInputElement>('.avatars input') ?? [])];
  if (spotlight && button && label && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const pause = (paused: boolean) => {
      button.toggleAttribute('data-paused', paused);
      label.textContent = `${paused ? 'Play' : 'Pause'} testimonials`;
    };
    button.hidden = false;
    button.addEventListener('click', () => pause(!button.hasAttribute('data-paused')));
    spotlight.addEventListener('change', () => pause(true));
    window.setInterval(() => {
      if (button.hasAttribute('data-paused') || spotlight.matches(':hover, :focus-within')) return;
      const next = radios[(radios.findIndex((radio) => radio.checked) + 1) % radios.length];
      if (next) next.checked = true;
    }, 5000);
  }
</script>

<style>
  /*
   * A spotlight: one quote at a time, large, with a row of avatars to switch between people.
   * Native radio buttons do the switching, so it works without JavaScript; browsers without :has()
   * simply show every quote.
   */
  .spotlight {
    display: grid;
    gap: var(--space-6);
    padding: var(--card-pad);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .quotes {
    padding: 0;
    list-style: none;
  }

  .spotlight:has(.avatars > :nth-child(1) input:checked) .quotes > :not(:nth-child(1)),
  .spotlight:has(.avatars > :nth-child(2) input:checked) .quotes > :not(:nth-child(2)),
  .spotlight:has(.avatars > :nth-child(3) input:checked) .quotes > :not(:nth-child(3)),
  .spotlight:has(.avatars > :nth-child(4) input:checked) .quotes > :not(:nth-child(4)),
  .spotlight:has(.avatars > :nth-child(5) input:checked) .quotes > :not(:nth-child(5)),
  .spotlight:has(.avatars > :nth-child(6) input:checked) .quotes > :not(:nth-child(6)) {
    display: none;
  }

  @keyframes quote-in {
    from {
      transform: translateY(12px);
    }
  }

  .quote {
    animation: quote-in 500ms var(--ease-out);
  }

  figure {
    display: grid;
    gap: var(--space-6);
  }

  blockquote {
    position: relative;
    margin: 0;
    padding-block-start: var(--space-8);
  }

  /* A large indigo quotation mark above the words. */
  blockquote::before {
    position: absolute;
    inset-block-start: -0.35em;
    inset-inline-start: -0.04em;
    color: var(--color-accent);
    content: '\201C';
    font-size: 4rem;
    line-height: 1;
  }

  blockquote p {
    max-width: 36rem;
    font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.5rem);
    font-weight: var(--weight-medium);
    letter-spacing: -0.015em;
    line-height: 1.4;
  }

  figcaption {
    display: grid;
  }

  .name {
    font-weight: var(--weight-medium);
  }

  .role {
    color: var(--color-text-muted);
  }

  .people {
    min-inline-size: 0;
    margin: 0;
    padding: var(--space-6) 0 0;
    border: 0;
    border-block-start: 1px solid var(--color-hairline);
  }

  .avatars {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  label {
    cursor: pointer;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--gradient-avatar-1);
    color: var(--color-avatar-text);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  label:nth-child(4n + 2) .avatar {
    background: var(--gradient-avatar-2);
  }

  label:nth-child(4n + 3) .avatar {
    background: var(--gradient-avatar-3);
  }

  label:nth-child(4n) .avatar {
    background: var(--gradient-avatar-4);
  }

  label:hover .avatar {
    transform: scale(1.06);
  }

  /* The selected person gets an indigo ring. */
  input:checked + .avatar {
    box-shadow:
      0 0 0 3px var(--color-surface),
      0 0 0 5px var(--color-accent);
  }

  input:focus-visible + .avatar {
    outline: 3px solid var(--color-focus);
    outline-offset: 5px;
  }

  /* Pause / play for the rotation, at the end of the avatar row. */
  .pause {
    display: grid;
    place-items: center;
    align-self: center;
    width: 32px;
    height: 32px;
    margin-inline-start: auto;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-shell);
    color: var(--color-text);
    cursor: pointer;
  }

  .pause:hover {
    color: var(--color-accent);
  }

  .pause[data-paused] .when-playing,
  .pause:not([data-paused]) .when-paused {
    display: none;
  }
</style>
