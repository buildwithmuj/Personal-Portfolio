---
import type { CollectionEntry } from 'astro:content';
import { splitQuote } from '../../lib/testimonials.ts';
import Shell from '../Shell.astro';
import SocialIcon from '../SocialIcon.astro';
import Icon from '../Icon.astro';

interface Props {
  testimonials: CollectionEntry<'testimonials'>['data'][];
  heading: string;
  intro: string;
}

const { testimonials, heading, intro } = Astro.props;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((part) => part[0] ?? '')
    .join('')
    .slice(0, 2);
---

<Shell id="testimonials" heading={heading} intro={intro} collapsible="open">
  <div class="wall">
    <ul class="posts" role="list">
      {testimonials.map((testimonial, index) => (
        <li class="post">
          <figure>
            <figcaption class="author">
              <span class="avatar" data-tone={(index % 4) + 1} aria-hidden="true">
                {initials(testimonial.name)}
              </span>
              <span class="who">
                <span class="name">{testimonial.name}</span>
                <span class="role">{testimonial.role}</span>
              </span>
            </figcaption>
            <blockquote>
              <p>
                {splitQuote(testimonial.quote, testimonial.highlight).map((part, at) =>
                  at === 1 && part ? <mark>{part}</mark> : part,
                )}
              </p>
            </blockquote>
            {(testimonial.source === 'linkedin' || testimonial.source === 'x') &&
              (testimonial.url ? (
                <a class="source" href={testimonial.url}>
                  <SocialIcon platform={testimonial.source} />
                  {testimonial.source === 'x' ? 'See it on X' : 'Verified on LinkedIn'}
                </a>
              ) : (
                <p class="source">
                  <SocialIcon platform={testimonial.source} />
                  {testimonial.source === 'x' ? 'Posted on X' : 'LinkedIn'}
                </p>
              ))}
          </figure>
        </li>
      ))}
    </ul>
    {testimonials.length > 1 && (
      <fieldset class="pager">
        <legend class="visually-hidden">Choose whose words to read</legend>
        {testimonials.map((testimonial, index) => (
          <label>
            <input
              class="visually-hidden"
              type="radio"
              name="testimonial"
              value={String(index)}
              checked={index === 0}
            />
            <span class="dot" aria-hidden="true"></span>
            <span class="visually-hidden">{testimonial.name}</span>
          </label>
        ))}
        <button class="pause" type="button" hidden>
          <Icon name="pause" size={14} class="when-playing" />
          <Icon name="play" size={14} class="when-paused" />
          <span class="visually-hidden">Pause testimonials</span>
        </button>
      </fieldset>
    )}
  </div>
</Shell>

<script>
  // On phones one card shows at a time, and every three seconds the next one takes its place,
  // looping. It waits while the pointer or keyboard focus is inside, the button pauses it, and
  // picking a dot pauses it too (WCAG 2.2.2). Wider screens show every card, so it never runs there,
  // nor under reduced motion or the footer's pause button.
  const wall = document.querySelector<HTMLElement>('.wall');
  const button = wall?.querySelector<HTMLButtonElement>('.pause');
  const label = button?.querySelector('span');
  const radios = [...(wall?.querySelectorAll<HTMLInputElement>('.pager input') ?? [])];
  const phone = matchMedia('(width < 48rem)');
  if (wall && button && label && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const pause = (paused: boolean) => {
      button.toggleAttribute('data-paused', paused);
      label.textContent = `${paused ? 'Play' : 'Pause'} testimonials`;
    };
    button.hidden = false;
    button.addEventListener('click', () => pause(!button.hasAttribute('data-paused')));
    wall.addEventListener('change', () => pause(true));
    window.setInterval(() => {
      if (!phone.matches || button.hasAttribute('data-paused')) return;
      if (wall.matches(':hover, :focus-within')) return;
      if (document.documentElement.classList.contains('motion-paused')) return;
      const next = radios[(radios.findIndex((radio) => radio.checked) + 1) % radios.length];
      if (next) next.checked = true;
    }, 3000);
  }
</script>

<style>
  /*
   * Testimonials as social posts: an author row (initials avatar, name, and the role where a handle
   * would be), a faint rule, the words with their key phrase in a sky highlighter, then where it
   * was given ("Verified on LinkedIn", a link to it, when the recommendation's address is known). On wide
   * screens the cards sit in a grid of equal rows; on phones they stack in one place and show one
   * at a time, chosen by the dots (native radio buttons, so it works without JavaScript). Sizes
   * follow the Portfolik reference at 1440px: 14px words on 21px lines, a 14px name over a 12px
   * role, a 42px avatar, 28px of padding and 10px between cards.
   */
  .posts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 10px;
    padding: 0;
    list-style: none;
  }

  figure {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-4);
    height: 100%;
    margin: 0;
    padding: 28px;
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .author {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    padding-block-end: var(--space-4);
    border-block-end: 1px dashed var(--color-hairline);
  }

  .avatar {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--color-avatar-1);
    color: var(--color-avatar-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .avatar[data-tone='2'] {
    background: var(--color-avatar-2);
  }

  .avatar[data-tone='3'] {
    background: var(--color-avatar-3);
    color: var(--color-avatar-text-light);
  }

  .avatar[data-tone='4'] {
    background: var(--color-avatar-4);
    color: var(--color-avatar-text-light);
  }

  .who {
    display: grid;
    flex: 1;
    gap: 2px;
    min-width: 0;
    line-height: 1.3;
  }

  .name {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .role {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  blockquote {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  /*
   * The marker: a sky highlighter stroke under the key phrase, in the chips' sky edge colour. With
   * motion allowed, it sweeps across line by line as the card comes up the screen. A browser without
   * scroll-driven animation plays it in no time at all, so there it simply shows.
   */
  mark {
    margin: 0 -2px;
    padding: 0 2px;
    border-radius: 3px;
    background: linear-gradient(var(--color-chip-edge) 0 0) 0 88% / 100% 46% no-repeat;
    color: inherit;
  }

  @keyframes marker {
    from {
      background-size: 0% 46%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    mark {
      animation: marker linear both;
    }

    /* In a rule of its own, so the minifier can't fold it into the shorthand (see ScrollTop). */
    blockquote mark {
      animation-timeline: view();
      animation-range: entry 100% cover 45%;
    }
  }

  /* Scroll-linked, not a loop, so it follows the page even with animations paused (global.css). */
  :global(.motion-paused) mark {
    animation-play-state: running !important;
  }

  /* Where it was given: a link to it when its address is known, or just its name. */
  .source {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    justify-self: start;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  a.source {
    color: var(--color-accent);
    text-decoration: none;
  }

  /* The dots and the pause button: phones only. */
  .pager {
    display: none;
  }

  @media (width < 48rem) {
    figure {
      padding: var(--space-6);
    }

    .pager {
      display: flex;
      gap: var(--space-2);
      align-items: center;
      justify-content: center;
      margin: var(--space-4) 0 0;
      padding: 0;
      border: 0;
    }

    label {
      display: grid;
      place-items: center;
      min-width: 24px;
      min-height: 24px;
      cursor: pointer;
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: var(--radius-pill);
      background: var(--color-chip-edge);
      transition:
        width var(--duration-base) var(--ease-standard),
        background-color var(--duration-base) var(--ease-standard);
    }

    input:checked + .dot {
      width: 20px;
      background: var(--color-accent);
    }

    input:focus-visible + .dot {
      outline: 3px solid var(--color-focus);
      outline-offset: 3px;
    }

    .pause {
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      margin-inline-start: var(--space-2);
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: var(--color-surface);
      color: var(--color-text);
      cursor: pointer;
    }

    .pause[hidden] {
      display: none;
    }

    .pause[data-paused] .when-playing,
    .pause:not([data-paused]) .when-paused {
      display: none;
    }

    /* One card at a time, all in one grid cell (as tall as the tallest); without :has(), a list. */
    @supports selector(:has(*)) {
      .posts {
        grid-template-columns: minmax(0, 1fr);
      }

      .post {
        grid-area: 1 / 1;
        transition:
          opacity var(--duration-base) var(--ease-standard),
          visibility var(--duration-base);
      }

      .wall:has(.pager label:nth-of-type(1) input:checked) .post:not(:nth-child(1)),
      .wall:has(.pager label:nth-of-type(2) input:checked) .post:not(:nth-child(2)),
      .wall:has(.pager label:nth-of-type(3) input:checked) .post:not(:nth-child(3)),
      .wall:has(.pager label:nth-of-type(4) input:checked) .post:not(:nth-child(4)),
      .wall:has(.pager label:nth-of-type(5) input:checked) .post:not(:nth-child(5)),
      .wall:has(.pager label:nth-of-type(6) input:checked) .post:not(:nth-child(6)) {
        visibility: hidden;
        opacity: 0;
      }
    }
  }
</style>
