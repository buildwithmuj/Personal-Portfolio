---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../lib/paths.ts';
import { splitQuote } from '../../lib/testimonials.ts';
import Shell from '../Shell.astro';
import SocialIcon from '../SocialIcon.astro';
import WindowBar from '../WindowBar.astro';

interface Props {
  testimonials: CollectionEntry<'testimonials'>['data'][];
  heading: string;
  intro: string;
  /** The owner, who sits in on the call, listening. */
  owner: { name: string; avatar?: string | undefined };
}

const { testimonials, heading, intro, owner } = Astro.props;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((part) => part[0] ?? '')
    .join('')
    .slice(0, 2);
const firstName = (name: string) => name.split(/\s+/)[0];
---

{/*
  Feedback (what people say), as a calm call in a window like the Toolkit's (WindowBar): a seat for each person
  and one for the owner, listening, and beneath them the words of whoever is speaking. Picking a
  seat makes that person speak: the seats are native radio buttons, so it works the same on every
  screen and without JavaScript. Only the window's minimise and close buttons need the script.
*/}
<Shell id="testimonials" heading={heading} intro={intro} collapsible="open">
  <div class="window">
    {/* No title in the bar: the section's heading already says what this is. */}
    <WindowBar minimise={{ label: `Minimise ${heading}` }} close={{ label: `Close ${heading}` }} />
    <div class="call">
      <fieldset class="seats">
        <legend class="visually-hidden">Choose whose words to read</legend>
        {testimonials.map((testimonial, index) => (
          <label class="seat">
            <input
              class="visually-hidden"
              type="radio"
              name="testimonial"
              value={String(index)}
              checked={index === 0}
            />
            <span class="avatar" data-tone={(index % 4) + 1} aria-hidden="true">
              {initials(testimonial.name)}
            </span>
            <span class="seat-name">
              <span class="bars" aria-hidden="true">
                <i />
                <i />
                <i />
              </span>
              <span aria-hidden="true">{firstName(testimonial.name)}</span>
              <span class="visually-hidden">{testimonial.name}</span>
            </span>
          </label>
        ))}
        <span class="seat me" aria-hidden="true">
          {owner.avatar && (
            <img class="avatar" src={withBase(owner.avatar)} alt="" width="48" height="48" />
          )}
          <span class="seat-name">{firstName(owner.name)}</span>
        </span>
      </fieldset>
      <ul class="said" role="list">
        {testimonials.map((testimonial) => (
          <li class="words">
            <figure>
              <blockquote>
                <p>
                  {splitQuote(testimonial.quote, testimonial.highlight).map((part, at) =>
                    at === 1 && part ? <mark>{part}</mark> : part,
                  )}
                </p>
              </blockquote>
              <figcaption>
                <span>
                  <b>{testimonial.name}</b>
                  {testimonial.role && ` · ${testimonial.role}`}
                </span>
                {(testimonial.source === 'linkedin' || testimonial.source === 'x') &&
                  (testimonial.url ? (
                    <a class="source" href={testimonial.url}>
                      <SocialIcon platform={testimonial.source} />
                      {testimonial.source === 'x' ? 'See it on X' : 'Verified on LinkedIn'}
                    </a>
                  ) : (
                    <span class="source">
                      <SocialIcon platform={testimonial.source} />
                      {testimonial.source === 'x' ? 'Posted on X' : 'LinkedIn'}
                    </span>
                  ))}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Shell>

<script>
  // The window's minimise and close buttons (WindowBar.astro) put it away: the section collapses,
  // as its own toggle does, and focus goes to that toggle, which opens it again.
  const toggle = document.querySelector<HTMLButtonElement>('#testimonials .collapse');
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    '#testimonials .window-bar button',
  )) {
    if (!toggle) break;
    button.onclick = () => {
      toggle.click();
      toggle.focus();
    };
    button.disabled = false;
  }
</script>

<style>
  .window {
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .call {
    display: grid;
    gap: var(--space-6);
    padding: 28px 32px 30px;
  }

  /* The seats: as many to a row as fit, the owner's last. */
  .seats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(88px, 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .seat {
    display: grid;
    gap: var(--space-2);
    justify-items: center;
    padding: 14px 6px 10px;
    border: 1px solid transparent;
    border-radius: 14px;
    background: var(--color-shell);
    font-size: var(--text-xs);
    transition:
      background-color var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard);
  }

  label {
    cursor: pointer;
  }

  .me {
    color: var(--color-text-muted);
  }

  /* The one speaking: a pale sky seat, their name in blue beside three small sound bars. */
  .seat:has(:checked) {
    border-color: var(--color-chip-edge);
    background: var(--color-chip);
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-avatar-1);
    color: var(--color-avatar-text);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
  }

  .avatar[data-tone='2'] {
    background: var(--color-avatar-2);
  }

  .avatar[data-tone='3'] {
    background: var(--color-avatar-3);
    color: var(--color-avatar-text-light);
  }

  .avatar[data-tone='4'] {
    background: var(--color-avatar-4);
    color: var(--color-avatar-text-light);
  }

  /* The owner's photo is a cut-out, so it sits on the sky like the hero's. */
  img.avatar {
    background: var(--gradient-sky);
    object-fit: cover;
  }

  input:focus-visible + .avatar {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .seat-name {
    display: inline-flex;
    gap: 5px;
    align-items: center;
  }

  :checked ~ .seat-name {
    color: var(--color-accent-hover);
    font-weight: var(--weight-medium);
  }

  .bars {
    display: none;
    gap: 2px;
    align-items: center;
    height: 9px;
  }

  :checked ~ .seat-name .bars {
    display: inline-flex;
  }

  .bars i {
    width: 2px;
    height: 100%;
    border-radius: 1px;
    background: var(--color-accent);
    animation: seat-speak 1100ms ease-in-out infinite alternate;
  }

  .bars i:nth-child(2) {
    animation-delay: -370ms;
  }

  .bars i:nth-child(3) {
    animation-delay: -740ms;
  }

  @keyframes seat-speak {
    from {
      transform: scaleY(0.35);
    }
  }

  /* What's said: every person's words, in turn, until :has() can show only the speaker's (below). */
  .said {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  figure {
    margin: 0;
  }

  blockquote {
    margin: 0;
    font-size: var(--text-xl);
    letter-spacing: -0.011em;
    line-height: 1.5;
  }

  blockquote p {
    max-width: none;
    margin: 0;
  }

  /*
   * The marker: a sky highlighter stroke under the key phrase, in the chips' sky edge colour. With
   * motion allowed, it sweeps across line by line as the words come up the screen. A browser
   * without scroll-driven animation plays it in no time at all, so there it simply shows.
   */
  mark {
    margin: 0 -2px;
    padding: 0 2px;
    border-radius: 3px;
    background: linear-gradient(var(--color-chip-edge) 0 0) 0 88% / 100% 46% no-repeat;
    color: inherit;
  }

  @keyframes marker {
    from {
      background-size: 0% 46%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    mark {
      animation: marker linear both;
    }

    /* In a rule of its own, so the minifier can't fold it into the shorthand (see ScrollTop). */
    blockquote mark {
      animation-timeline: view();
      animation-range: entry 100% cover 45%;
    }
  }

  /* Scroll-linked, not a loop, so it follows the page even with animations paused (global.css). */
  :global(.motion-paused) mark {
    animation-play-state: running !important;
  }

  /* Who said it and, at the right, where: a link to it when its address is known, or its name. */
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    align-items: center;
    justify-content: space-between;
    margin-block-start: var(--space-4);
    padding-block-start: var(--space-4);
    border-block-start: 1px dashed var(--color-hairline);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  figcaption b {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  .source {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  a.source {
    color: var(--color-accent);
    text-decoration: none;
  }

  /*
   * Only the speaker's words show, and the window is as tall as they are: a shorter quote leaves no
   * empty space beneath it (it once kept the longest quote's height). They fade in as a new person
   * speaks.
   */
  @supports selector(:has(*)) {
    .words {
      animation: said-in var(--duration-base) var(--ease-standard);
    }

    .call:has(label:nth-of-type(1) :checked) .words:not(:nth-child(1)),
    .call:has(label:nth-of-type(2) :checked) .words:not(:nth-child(2)),
    .call:has(label:nth-of-type(3) :checked) .words:not(:nth-child(3)),
    .call:has(label:nth-of-type(4) :checked) .words:not(:nth-child(4)),
    .call:has(label:nth-of-type(5) :checked) .words:not(:nth-child(5)),
    .call:has(label:nth-of-type(6) :checked) .words:not(:nth-child(6)) {
      display: none;
    }
  }

  @keyframes said-in {
    from {
      opacity: 0;
    }
  }

  /* A one-off entrance: under paused animations it would freeze unseen on its first frame. */
  :global(.motion-paused) .words {
    animation-play-state: running !important;
  }

  @media (width < 48rem) {
    .call {
      gap: var(--space-4);
      padding: 16px 14px 18px;
    }

    /* Every seat in one row where they fit, so the words start sooner (two rows below 360px). */
    .seats {
      grid-template-columns: repeat(auto-fit, minmax(44px, 1fr));
      gap: 4px;
    }

    .seat {
      gap: 4px;
      padding: 8px 2px 6px;
      font-size: 0.6875rem;
    }

    .avatar {
      width: 38px;
      height: 38px;
      font-size: var(--text-sm);
    }

    blockquote {
      font-size: var(--text-base);
    }

    figcaption {
      margin-block-start: var(--space-3);
      padding-block-start: var(--space-3);
    }
  }
</style>
