---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../lib/paths.ts';
import Icon from '../Icon.astro';
import Shell from '../Shell.astro';
import SkyGradient from '../SkyGradient.astro';
import Switch from '../Switch.astro';
import WindowBar from '../WindowBar.astro';

interface Props {
  skills: CollectionEntry<'skills'>['data'];
  heading: string;
  intro: string;
}

const { skills, heading, intro } = Astro.props;
const groups = [
  { value: 'tools', label: 'Tools' },
  { value: 'skills', label: 'Skills' },
  { value: 'certifications', label: 'Certifications' },
];
// The taskbar holds the tools pinned to it; the rest wait in its tray, behind the arrow.
const pinned = skills.tools.filter((tool) => !tool.tray);
const tray = skills.tools.filter((tool) => tool.tray);
// A folder's back (with its tab) and its front, on a 240 × 200 grid.
const FOLDER_BACK =
  'M0 14Q0 0 14 0H88Q97 0 103 7L114 21Q120 28 130 28H226Q240 28 240 42V186Q240 200 226 200H14Q0 200 0 186Z';
const FOLDER_FRONT = 'M0 70Q0 58 12 58H228Q240 58 240 70V186Q240 200 226 200H14Q0 200 0 186Z';
---

{/*
  The Toolkit, as Windows: the tools on a taskbar under a patch of the live sky (five pinned to it,
  the rest in a tray its arrow opens, as Windows keeps its hidden icons), the skills as a
  slide deck in a window (a slide per phase), the certifications as folders in a window, each
  opening its certificate in a viewer. One group shows at a time in one card, picked with the switch
  (the tools to start) or by a window's minimise and close buttons.
*/}
<Shell id="skills" heading={heading} intro={intro} collapsible="open">
  <Switch slot="actions" name="toolkit-group" label="Show" options={groups} />
  <div class="card toolkit" data-reveal="rise">
    <div class="panel" data-panel="tools">
      <h3 class="visually-hidden">Tools</h3>
      <div class="desk">
        <SkyGradient class="desk-sky" scale={0.5} />
        <ul class="taskbar" role="list">
          {/* The Start button, only the look: the Windows 11 logo, four panes in one blue gradient. */}
          <li class="start" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <defs>
                <linearGradient id="start-blue" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#2ab6f6" />
                  <stop offset="1" stop-color="#0063c7" />
                </linearGradient>
              </defs>
              <path
                fill="url(#start-blue)"
                d="M0 0h11.4v11.4H0zM12.6 0H24v11.4H12.6zM0 12.6h11.4V24H0zM12.6 12.6H24V24H12.6z"
              />
            </svg>
          </li>
          {pinned.map((tool) => (
            <li class="tool">
              <span class="tool-icon">
                <img src={withBase(tool.logo)} alt="" width="34" height="34" loading="lazy" />
              </span>
              <span class="tool-name">{tool.name}</span>
            </li>
          ))}
          {tray.length > 0 && (
            <li>
              <details>
                <summary aria-label="More tools">
                  <span class="tool-icon">
                    <Icon name="chevron-up" size={18} />
                  </span>
                  <span class="more-name">More</span>
                </summary>
                <ul class="tray" role="list">
                  {tray.map((tool) => (
                    <li class="tool">
                      <span class="tool-icon">
                        <img
                          src={withBase(tool.logo)}
                          alt=""
                          width="34"
                          height="34"
                          loading="lazy"
                        />
                      </span>
                      <span class="tool-name">{tool.name}</span>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          )}
        </ul>
      </div>
    </div>
    <div class="panel" data-panel="skills">
      <h3 class="visually-hidden">Skills</h3>
      <WindowBar
        title="Skills.pptx"
        minimise={{ to: 'tools', label: 'Minimise Skills and go back to Tools' }}
        close={{ to: 'certifications', label: 'Close Skills and show Certifications' }}
      />
      {/* Only the look of a slide app's tabs. */}
      <div class="ribbon" aria-hidden="true">
        <span>File</span>
        <span class="on">Home</span>
        <span>Insert</span>
        <span>Design</span>
        <span>Slide Show</span>
        <span>View</span>
      </div>
      <div class="deck">
        <fieldset class="phases">
          <legend class="visually-hidden">Phase</legend>
          {skills.groups.map(({ group }, index) => (
            <label>
              <input
                class="visually-hidden"
                type="radio"
                name="skill-phase"
                value={`phase-${index + 1}`}
                checked={index === 0}
              />
              <span class="slide-number" aria-hidden="true">
                {index + 1}
              </span>
              <span class="thumb">{group}</span>
            </label>
          ))}
        </fieldset>
        <div class="skill-groups">
          {skills.groups.map(({ group, lead, items }, index) => (
            <div class="skill-group">
              <div class="slide-head">
                <h4>{group}</h4>
                {lead && <p class="lead">{lead}</p>}
                <span class="slide-mark" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
              </div>
              <ul class="pills" role="list">
                {items.map((skill) => (
                  <li class="skill">{skill}</li>
                ))}
              </ul>
              <p class="slide-foot" aria-hidden="true">
                <span>{skills.groups.map(({ group: name }) => name).join(' → ')}</span>
                <span class="slide-count">
                  {index + 1} of {skills.groups.length}
                </span>
              </p>
            </div>
          ))}
        </div>
      </div>
      <div class="status" aria-hidden="true">
        <span>{skills.groups.length} slides</span>
        <span class="zoom">100%</span>
      </div>
    </div>
    <div class="panel" data-panel="certifications">
      <h3 class="visually-hidden">Certifications</h3>
      <WindowBar
        minimise={{ to: 'tools', label: 'Minimise Certifications and go back to Tools' }}
        close={{ to: 'tools', label: 'Close Certifications and go back to Tools' }}
      />
      <ul class="cert-cards" role="list">
        {skills.certifications.map(({ title, issuer, short }) => (
          <li>
            {/* Disabled until the viewer's script is ready: without JavaScript it opens nothing. */}
            <button
              class="cert-card"
              type="button"
              aria-label={`View certificate: ${title}, ${issuer}`}
              disabled
            >
              <span class="folder" aria-hidden="true">
                <svg class="folder-back" viewBox="0 0 240 200">
                  <path d={FOLDER_BACK} />
                </svg>
                <span class="sheet"></span>
                <svg class="folder-front" viewBox="0 0 240 200">
                  <path d={FOLDER_FRONT} />
                </svg>
              </span>
              <span class="name" aria-hidden="true">
                {short}
              </span>
              <span class="issuer" aria-hidden="true">
                {issuer}
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <dialog class="cert-view" aria-label="Certificates">
    <div class="bar">
      <p class="count" aria-live="polite">
        1 of {skills.certifications.length}
      </p>
      <button class="round close" type="button" aria-label="Close certificates">
        <Icon name="close" />
      </button>
    </div>
    <div class="track">
      {skills.certifications.map(({ title, issuer, image }) => (
        <figure class="slide">
          {image ? (
            <img
              class="certificate"
              src={withBase(image)}
              alt={`${title} certificate, from ${issuer}`}
              loading="lazy"
            />
          ) : (
            <div class="certificate placeholder">
              <span class="seal">
                <Icon name="skills" size={30} />
              </span>
              <p class="kind">Certification</p>
              <p class="title">{title}</p>
              <p class="by">{issuer}</p>
            </div>
          )}
        </figure>
      ))}
    </div>
    <div class="steps">
      <button class="round prev" type="button" aria-label="Previous certificate">
        <Icon name="chevron-down" />
      </button>
      <button class="round next" type="button" aria-label="Next certificate">
        <Icon name="chevron-down" />
      </button>
    </div>
  </dialog>
</Shell>

<script>
  // The windows' minimise and close buttons (WindowBar.astro): each shows the group it leads to,
  // and focus follows to that group's tab.
  for (const button of document.querySelectorAll<HTMLButtonElement>('#skills [data-show]')) {
    const pick = document.querySelector<HTMLInputElement>(
      `#skills [name="toolkit-group"][value="${button.dataset['show']}"]`,
    );
    if (!pick) continue;
    button.onclick = () => {
      pick.checked = true;
      pick.focus();
    };
    button.disabled = false;
  }

  // The taskbar's tray closes as Windows' does: on Escape, with focus back on its arrow, or on a
  // click anywhere else.
  const tray = document.querySelector<HTMLDetailsElement>('#skills .taskbar details');
  if (tray) {
    document.addEventListener('click', ({ target }) => {
      if (tray.open && !tray.contains(target as Node)) tray.open = false;
    });
    tray.addEventListener('keydown', ({ key }) => {
      if (key !== 'Escape' || !tray.open) return;
      tray.open = false;
      tray.querySelector('summary')?.focus();
    });
  }

  // The certificates. A folder opens the viewer on its own certificate; the arrows, the arrow keys
  // or a swipe move through the rest, wrapping round, and the close button, Escape or a click
  // beside it close it. The count changes only when the certificate does, so a screen reader
  // hears it once.
  const viewer = document.querySelector<HTMLDialogElement>('.cert-view');
  const track = viewer?.querySelector<HTMLElement>('.track');
  const count = viewer?.querySelector('.count');
  if (viewer && track && count) {
    const total = track.children.length;
    const at = () => Math.round(track.scrollLeft / track.clientWidth);
    const tally = () => {
      const text = `${at() + 1} of ${total}`;
      if (count.textContent !== text) count.textContent = text;
    };
    // 'auto' takes the track's own scroll-behavior: smooth, or instant under reduced motion.
    const go = (index: number, behavior: ScrollBehavior = 'auto') =>
      track.scrollTo({ left: ((index + total) % total) * track.clientWidth, behavior });
    track.onscroll = tally;
    document.querySelectorAll<HTMLButtonElement>('.cert-card').forEach((card, index) => {
      card.onclick = () => {
        viewer.showModal();
        go(index, 'instant');
        tally();
      };
      card.disabled = false;
    });
    viewer.onclick = ({ target }) => {
      const element = target as Element;
      if (element === viewer || element.closest('.close')) viewer.close();
      else if (element.closest('.prev')) go(at() - 1);
      else if (element.closest('.next')) go(at() + 1);
    };
    viewer.onkeydown = (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      go(at() + (event.key === 'ArrowLeft' ? -1 : 1));
    };
  }
</script>

<style>
  /*
   * The three groups share one cell of the card, so it holds the tallest group's height and never
   * jumps. Only the picked group shows (the tools to start); the others are hidden outright, so no
   * pointer, keyboard or screen reader lands in a group that's out of sight: the switch picks
   * another, as tabs do. Without :has() every group shows, one after another.
   */
  .toolkit {
    display: grid;
    overflow: hidden;
  }

  @supports selector(:has(*)) {
    .panel {
      grid-area: 1 / 1;
      visibility: hidden;
    }
  }

  .taskbar,
  .tray,
  .pills,
  .cert-cards {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * Tools: a Windows taskbar along the foot of a patch of the live sky, filling the card to its edges
   * (past its padding): a Start button, which is only the look, then each pinned tool with its
   * name, and last an arrow that opens the tray holding the rest.
   */
  .panel[data-panel='tools'] {
    margin: calc(-1 * var(--card-pad));
  }

  /*
   * The sky stops where the taskbar starts, and the bar is one solid pale sky. (It was frosted
   * glass over the moving sky: that shimmered as the sky moved, and left a thin blue line round the
   * card's lower corners.)
   */
  .desk {
    display: grid;
    grid-template-rows: 1fr auto;
    height: 100%;
    min-height: 220px;
    container-type: inline-size;
  }

  /*
   * The sky takes the height the bar leaves it and asks for none of its own: a canvas has a size of
   * its own, which would otherwise set the row's height, and the sky redraws to the row's height.
   */
  .desk-sky {
    contain: size;
  }

  .taskbar {
    --slot: min(44px, 12cqi);

    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: start;
    justify-content: center;
    padding: 4px 12px;
    background: var(--taskbar);
  }

  /* Sized from the sky's width (up to 44px). */
  .tool-icon {
    display: grid;
    place-items: center;
    width: var(--slot);
    height: var(--slot);
    border-radius: 6px;
  }

  /*
   * Every button on the bar is the same width, the Start button included, so the icons are evenly
   * spaced, as on Windows, and as close as the longest name allows. Each name is always there to
   * read, under its icon; under a pointer the whole button lights up.
   */
  .start,
  .tool,
  summary {
    display: grid;
    justify-items: center;
    width: calc(var(--slot) + 22px);
    border-radius: 6px;
    transition: background-color 150ms var(--ease-standard);
  }

  .start {
    height: var(--slot);
    place-items: center;
  }

  .start svg {
    width: 52%;
    height: 52%;
  }

  .tool-icon img {
    width: 58%;
    height: 58%;
    object-fit: contain;
  }

  .tool-name,
  .more-name {
    padding: 2px 0 4px;
    color: var(--color-text);
    font-size: 0.625rem;
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }

  @media (hover: hover) {
    .tool:hover,
    summary:hover {
      background: var(--taskbar-hover);
    }

    .tray .tool:hover {
      background: var(--win-hover);
    }
  }

  /*
   * The arrow at the end of the bar, as Windows keeps its hidden icons: a button (the summary of a
   * details element, so it works without JavaScript) that opens a small white tray over the sky,
   * centred above the bar, with the tools that aren't pinned. The arrow turns over while it's open.
   */
  summary {
    cursor: pointer;
  }

  /* Safari still draws the disclosure marker without this. */
  summary::-webkit-details-marker {
    display: none;
  }

  [open] summary :global(.icon) {
    rotate: 180deg;
  }

  /* The bar ends a few pixels above the card's clipped edge: the focus ring goes inside. */
  summary:focus-visible {
    outline-offset: -3px;
  }

  /* Four to a row, as Windows lays out its hidden icons; a long name takes two lines. */
  .tray {
    position: absolute;
    inset-block-end: calc(100% + 10px);
    inset-inline-start: 50%;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 4px;
    width: min(100% - 16px, 340px);
    padding: 8px 10px 4px;
    border-radius: 12px;
    background: var(--color-surface);
    box-shadow: var(--shadow-secondary);
    translate: -50% 0;
  }

  .tray .tool {
    align-content: start;
    width: auto;
  }

  .tray .tool-name {
    padding-inline: 0;
    line-height: 1.15;
    text-align: center;
    white-space: normal;
  }

  /* On the narrowest phones, three to a row, so no two names meet. */
  @container (width < 260px) {
    .tray {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /*
   * On a phone the bar keeps to one row, as a real taskbar does: the icons alone, close together,
   * their names still read out to screen readers (and shown in the tray).
   */
  @container (width < 480px) {
    .taskbar {
      gap: 2px;
      padding-inline: 8px;
    }

    .start,
    .tool,
    summary {
      width: var(--slot);
    }

    .tool,
    summary {
      padding-block: 4px;
    }

    .start {
      height: calc(var(--slot) + 8px);
    }

    .taskbar > .tool .tool-name,
    .more-name {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }

  /*
   * Skills: a slide deck open in a Windows window, the card as the window. Its slides are the
   * phases, in the order a project runs (skills.yaml's groups): their thumbnails down the side are
   * the phases' own radios, each a small slide, and the slide picked fills the canvas: its title
   * and a line about the phase beside a large pale slide number, its skills as white pills with Ask
   * me's glow, and a footer along its foot with the phases in order and its place in the deck.
   * Pointing at a pill lights it blue. On phones the thumbnails run beneath.
   */
  .panel[data-panel='skills'] {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    margin: calc(-1 * var(--card-pad));
  }

  /*
   * The rest of the window, so the grey workspace sits inside a whole one: the app's tabs under the
   * title bar, the open one underlined in the deck's orange, and a status bar along the foot with
   * the number of slides and the zoom. Both are only the look.
   */
  .ribbon,
  .status {
    display: flex;
    gap: var(--space-4);
    overflow: hidden;
    padding: 7px 16px;
    color: var(--color-text-muted);
    font-size: 11px;
    white-space: nowrap;
  }

  .on {
    color: var(--color-text);
    box-shadow: 0 7px 0 -5px var(--slide-picked);
  }

  .status {
    justify-content: space-between;
  }

  /* The zoom's slider: a line with its knob in the middle. */
  .zoom::before {
    display: inline-block;
    width: 64px;
    height: 7px;
    margin-inline-end: var(--space-2);
    background:
      radial-gradient(circle, currentcolor 3px, transparent 3.5px),
      linear-gradient(currentcolor 0 0) center / 100% 1px no-repeat;
    content: '';
  }

  .deck {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    gap: 16px;
    padding: 16px;
    background: var(--color-shell);
  }

  .phases {
    display: grid;
    gap: 10px;
    align-content: start;
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .phases label {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    gap: 6px;
    cursor: pointer;
  }

  .slide-number {
    color: var(--color-text-muted);
    font-size: 11px;
    text-align: end;
  }

  .thumb {
    display: grid;
    gap: 5px;
    place-content: center;
    place-items: center;
    aspect-ratio: 16 / 9;
    padding: 4px;
    border: 2px solid transparent;
    border-radius: 4px;
    background: var(--color-surface);
    box-shadow: 0 1px 3px var(--slide-shadow);
    font-size: 11px;
    font-weight: var(--weight-medium);
    text-align: center;
  }

  /* Two faint lines under the word: the slide's pills, in miniature. */
  .thumb::after {
    width: 34px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-chip-edge);
    box-shadow: 0 6px var(--color-chip);
    content: '';
  }

  .phases input:checked ~ .thumb {
    border-color: var(--slide-picked);
  }

  .phases input:focus-visible ~ .thumb {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .skill-groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  /* The slide: its head, its pills, and its footer held to the foot. */
  .skill-group {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 16px;
    aspect-ratio: 16 / 9;
    padding: 20px 24px 14px;
    border-radius: 2px;
    background: var(--color-surface);
    box-shadow: 0 2px 10px var(--slide-shadow);
  }

  /* The title and its line at the left, the slide's number large and pale at the right. */
  .slide-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px var(--space-4);
    padding-block-end: 12px;
    border-block-end: 3px solid;
    border-image: var(--gradient-sky) 1;
  }

  .skill-group h4 {
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-style: italic;
    font-weight: var(--weight-regular);
  }

  .lead {
    max-width: none;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .slide-mark {
    grid-area: 1 / 2 / span 2;
    align-self: end;
    color: var(--color-chip-edge);
    font-size: 2.5rem;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-tight);
    line-height: 0.9;
  }

  .slide-foot {
    display: flex;
    gap: var(--space-4);
    justify-content: space-between;
    max-width: none;
    margin: 0;
    padding-block-start: 10px;
    border-block-start: 1px solid var(--color-hairline);
    color: var(--color-text-muted);
    font-size: 11px;
  }

  /* One slide at a time where :has() can tell which is picked; without it, every slide in turn. */
  @supports selector(:has(*)) {
    .skill-group {
      display: none;
      grid-area: 1 / 1;
    }

    .deck:has(label:nth-of-type(1) input:checked) .skill-group:nth-child(1),
    .deck:has(label:nth-of-type(2) input:checked) .skill-group:nth-child(2),
    .deck:has(label:nth-of-type(3) input:checked) .skill-group:nth-child(3),
    .deck:has(label:nth-of-type(4) input:checked) .skill-group:nth-child(4) {
      display: grid;
    }
  }

  .pills {
    --glow:
      0 0 0 1px var(--color-chip), 0 8px 24px -6px var(--color-accent-glow),
      0 0 16px var(--color-accent-glow);

    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-content: start;
  }

  .skill {
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: var(--glow);
    font-size: var(--text-sm);
    transition:
      background-color 250ms var(--ease-out),
      color 250ms var(--ease-out),
      translate 250ms var(--ease-out);
  }

  .skill:hover {
    background: var(--color-chip);
    color: var(--color-accent-hover);
    translate: 0 -2px;
  }

  /*
   * Certifications: soft folders, Apple Files style, in one row (three across on phones), one calm
   * pale-sky shape each with the name and issuer set beneath. Pointing at one (or focusing it)
   * tips its front forward and a certificate rises out. The card is a Windows window around them:
   * minimise, maximise and close on its title bar (WindowBar.astro), and no title.
   */

  /* The window fills the card to its edges; the skills set its height, and the folders sit in the
     middle of what's left under the title bar. */
  .panel[data-panel='certifications'] {
    display: grid;
    grid-template-rows: auto 1fr;
