---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../lib/paths.ts';
import Icon from '../Icon.astro';
import Shell from '../Shell.astro';
import SkyGradient from '../SkyGradient.astro';
import Switch from '../Switch.astro';
import WindowBar from '../WindowBar.astro';

interface Props {
  skills: CollectionEntry<'skills'>['data'];
  heading: string;
  intro: string;
}

const { skills, heading, intro } = Astro.props;
const groups = [
  { value: 'tools', label: 'Tools' },
  { value: 'skills', label: 'Skills' },
  { value: 'certifications', label: 'Certifications' },
];
// A folder's back (with its tab) and its front, on a 240 × 200 grid.
const FOLDER_BACK =
  'M0 14Q0 0 14 0H88Q97 0 103 7L114 21Q120 28 130 28H226Q240 28 240 42V186Q240 200 226 200H14Q0 200 0 186Z';
const FOLDER_FRONT = 'M0 70Q0 58 12 58H228Q240 58 240 70V186Q240 200 226 200H14Q0 200 0 186Z';
---

{/*
  The Toolkit, as Windows: the tools on a taskbar across a patch of the live sky, the skills as a
  slide deck in a window (a slide per phase), the certifications as folders in a window, each
  opening its certificate in a viewer. One group shows at a time in one card, picked with the switch
  (the tools to start) or by a window's minimise and close buttons.
*/}
<Shell id="skills" heading={heading} intro={intro} collapsible="open">
  <Switch slot="actions" name="toolkit-group" label="Show" options={groups} />
  <div class="card toolkit" data-reveal="rise">
    <div class="panel" data-panel="tools">
      <h3 class="visually-hidden">Tools</h3>
      <div class="desk">
        <SkyGradient class="desk-sky" scale={0.5} />
        <ul class="taskbar" role="list">
          <li class="start" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </li>
          {skills.tools.map((tool) => (
            <li class="tool">
              <span class="tool-icon">
                <img src={withBase(tool.logo)} alt="" width="34" height="34" loading="lazy" />
              </span>
              <span class="tool-name">{tool.name}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="panel" data-panel="skills">
      <h3 class="visually-hidden">Skills</h3>
      <WindowBar
        minimise={{ to: 'tools', label: 'Minimise Skills and go back to Tools' }}
        close={{ to: 'certifications', label: 'Close Skills and show Certifications' }}
      />
      <div class="deck">
        <fieldset class="phases">
          <legend class="visually-hidden">Phase</legend>
          {skills.groups.map(({ group }, index) => (
            <label>
              <input
                class="visually-hidden"
                type="radio"
                name="skill-phase"
                value={`phase-${index + 1}`}
                checked={index === 0}
              />
              <span class="slide-number" aria-hidden="true">
                {index + 1}
              </span>
              <span class="thumb">{group}</span>
            </label>
          ))}
        </fieldset>
        <div class="skill-groups">
          {skills.groups.map(({ group, items }, index) => (
            <div class="skill-group">
              <p class="slide-count" aria-hidden="true">
                {index + 1} of {skills.groups.length}
              </p>
              <h4>{group}</h4>
              <ul class="pills" role="list">
                {items.map((skill) => (
                  <li class="skill">{skill}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="panel" data-panel="certifications">
      <h3 class="visually-hidden">Certifications</h3>
      <WindowBar
        minimise={{ to: 'tools', label: 'Minimise Certifications and go back to Tools' }}
        close={{ to: 'tools', label: 'Close Certifications and go back to Tools' }}
      />
      <ul class="cert-cards" role="list">
        {skills.certifications.map(({ title, issuer, short }) => (
          <li>
            {/* Disabled until the viewer's script is ready: without JavaScript it opens nothing. */}
            <button
              class="cert-card"
              type="button"
              aria-label={`View certificate: ${title}, ${issuer}`}
              disabled
            >
              <span class="folder" aria-hidden="true">
                <svg class="folder-back" viewBox="0 0 240 200">
                  <path d={FOLDER_BACK} />
                </svg>
                <span class="sheet"></span>
                <svg class="folder-front" viewBox="0 0 240 200">
                  <path d={FOLDER_FRONT} />
                </svg>
              </span>
              <span class="name" aria-hidden="true">
                {short}
              </span>
              <span class="issuer" aria-hidden="true">
                {issuer}
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <dialog class="cert-view" aria-label="Certificates">
    <div class="bar">
      <p class="count" aria-live="polite">
        1 of {skills.certifications.length}
      </p>
      <button class="round close" type="button" aria-label="Close certificates">
        <Icon name="close" />
      </button>
    </div>
    <div class="track">
      {skills.certifications.map(({ title, issuer, image }) => (
        <figure class="slide">
          {image ? (
            <img
              class="certificate"
              src={withBase(image)}
              alt={`${title} certificate, from ${issuer}`}
              loading="lazy"
            />
          ) : (
            <div class="certificate placeholder">
              <Icon name="skills" size={34} />
              <p class="kind">Certificate</p>
              <p class="title">{title}</p>
              <p>{issuer}</p>
            </div>
          )}
        </figure>
      ))}
    </div>
    <div class="steps">
      <button class="round prev" type="button" aria-label="Previous certificate">
        <Icon name="chevron-down" />
      </button>
      <button class="round next" type="button" aria-label="Next certificate">
        <Icon name="chevron-down" />
      </button>
    </div>
  </dialog>
</Shell>

<script>
  // The windows' minimise and close buttons (WindowBar.astro): each shows the group it leads to,
  // and focus follows to that group's tab.
  for (const button of document.querySelectorAll<HTMLButtonElement>('#skills [data-show]')) {
    const pick = document.querySelector<HTMLInputElement>(
      `#skills [name="toolkit-group"][value="${button.dataset['show']}"]`,
    );
    if (!pick) continue;
    button.onclick = () => {
      pick.checked = true;
      pick.focus();
    };
    button.disabled = false;
  }

  // The certificates. A folder opens the viewer on its own certificate; the arrows, the arrow keys
  // or a swipe move through the rest, wrapping round, and the close button, Escape or a click
  // beside it close it. The count changes only when the certificate does, so a screen reader
  // hears it once.
  const viewer = document.querySelector<HTMLDialogElement>('.cert-view');
  const track = viewer?.querySelector<HTMLElement>('.track');
  const count = viewer?.querySelector('.count');
  if (viewer && track && count) {
    const total = track.children.length;
    const at = () => Math.round(track.scrollLeft / track.clientWidth);
    const tally = () => {
      const text = `${at() + 1} of ${total}`;
      if (count.textContent !== text) count.textContent = text;
    };
    // 'auto' takes the track's own scroll-behavior: smooth, or instant under reduced motion.
    const go = (index: number, behavior: ScrollBehavior = 'auto') =>
      track.scrollTo({ left: ((index + total) % total) * track.clientWidth, behavior });
    track.onscroll = tally;
    document.querySelectorAll<HTMLButtonElement>('.cert-card').forEach((card, index) => {
      card.onclick = () => {
        viewer.showModal();
        go(index, 'instant');
        tally();
      };
      card.disabled = false;
    });
    viewer.onclick = ({ target }) => {
      const element = target as Element;
      if (element === viewer || element.closest('.close')) viewer.close();
      else if (element.closest('.prev')) go(at() - 1);
      else if (element.closest('.next')) go(at() + 1);
    };
    viewer.onkeydown = (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      go(at() + (event.key === 'ArrowLeft' ? -1 : 1));
    };
  }
</script>

<style>
  /*
   * The three groups share one cell of the card, so it holds the tallest group's height and never
   * jumps. Only the picked group shows (the tools to start); the others are hidden outright, so no
   * pointer, keyboard or screen reader lands in a group that's out of sight: the switch picks
   * another, as tabs do. Without :has() every group shows, one after another.
   */
  .toolkit {
    display: grid;
    overflow: hidden;
  }

  @supports selector(:has(*)) {
    .panel {
      grid-area: 1 / 1;
      visibility: hidden;
    }
  }

  .taskbar,
  .pills,
  .cert-cards {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * Tools: a Windows taskbar along the foot of a patch of the live sky, filling the card to its edges
   * (past its padding): a Start button, which is only the look, then each tool with its name.
   */
  .panel[data-panel='tools'] {
    margin: calc(-1 * var(--card-pad));
  }

  .desk {
    position: relative;
    display: grid;
    align-items: end;
    height: 100%;
    min-height: 220px;
    isolation: isolate;
    container-type: inline-size;
  }

  .desk-sky {
    position: absolute;
    z-index: -1;
    inset: 0;
  }

  .taskbar {
    --slot: min(44px, 12cqi);

    display: flex;
    gap: 4px;
    align-items: start;
    justify-content: center;
    padding: 4px 12px;
    border-block-start: 1px solid var(--taskbar-edge);
    background: var(--taskbar);
    backdrop-filter: blur(24px) saturate(1.3);
  }

  /* Sized from the sky's width (up to 44px), so the bar always fits across, even at 320px. */
  .start,
  .tool-icon {
    width: var(--slot);
    height: var(--slot);
    border-radius: 6px;
  }

  .start {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    padding: calc(var(--slot) * 0.27);
  }

  .start i {
    border-radius: 1px;
    background: var(--color-accent);
  }

  /*
   * Each tool's name is always there to read: under its icon on a narrow bar (a phone), beside it
   * where the bar has room, as Windows shows an app's name on its taskbar button. Under a pointer
   * the whole button lights up.
   */
  .tool {
    display: grid;
    justify-items: center;
    border-radius: 6px;
    transition: background-color 150ms var(--ease-standard);
  }

  .tool-icon {
    display: grid;
    place-items: center;
  }

  .tool-icon img {
    width: 58%;
    height: 58%;
    object-fit: contain;
  }

  .tool-name {
    padding-block: 2px 4px;
    color: var(--color-text);
    font-size: 0.625rem;
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }

  @container (width >= 620px) {
    .tool {
      display: flex;
      align-items: center;
      padding-inline-end: 12px;
    }

    .tool-name {
      padding: 0;
      font-size: var(--text-xs);
    }
  }

  @media (hover: hover) {
    .tool:hover {
      background: var(--taskbar-hover);
    }
  }

  /*
   * Skills: a slide deck open in a Windows window, the card as the window. Its slides are the
   * phases, in the order a project runs (skills.yaml's groups): their thumbnails down the side are
   * the phases' own radios, and the slide picked fills the canvas, its skills as white pills with
   * Ask me's glow. Pointing at a pill lights it blue. On phones the thumbnails run beneath.
   */
  .panel[data-panel='skills'] {
    display: grid;
    grid-template-rows: auto 1fr;
    margin: calc(-1 * var(--card-pad));
  }

  .deck {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    gap: 16px;
    padding: 16px;
    background: var(--color-shell);
  }

  .phases {
    display: grid;
    gap: 10px;
    align-content: start;
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .phases label {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    gap: 6px;
    cursor: pointer;
  }

  .slide-number {
    color: var(--color-text-muted);
    font-size: 11px;
    text-align: end;
  }

  .thumb {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    padding: 4px;
    border: 2px solid transparent;
    border-radius: 4px;
    background: var(--color-surface);
    box-shadow: 0 1px 3px var(--slide-shadow);
    font-size: 11px;
    font-weight: var(--weight-medium);
    text-align: center;
  }

  .phases input:checked ~ .thumb {
    border-color: var(--slide-picked);
  }

  .phases input:focus-visible ~ .thumb {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .skill-groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  .skill-group {
    display: grid;
    gap: 12px;
    align-content: start;
    aspect-ratio: 16 / 9;
    padding: 20px 24px;
    border-radius: 2px;
    background: var(--color-surface);
    box-shadow: 0 2px 10px var(--slide-shadow);
  }

  .slide-count {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .skill-group h4 {
    margin: 0;
    padding-block-end: 10px;
    border-block-end: 3px solid;
    border-image: var(--gradient-sky) 1;
    color: var(--color-accent);
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-style: italic;
    font-weight: var(--weight-regular);
  }

  /* One slide at a time where :has() can tell which is picked; without it, every slide in turn. */
  @supports selector(:has(*)) {
    .skill-group {
      display: none;
      grid-area: 1 / 1;
    }

    .deck:has(label:nth-of-type(1) input:checked) .skill-group:nth-child(1),
    .deck:has(label:nth-of-type(2) input:checked) .skill-group:nth-child(2),
    .deck:has(label:nth-of-type(3) input:checked) .skill-group:nth-child(3),
    .deck:has(label:nth-of-type(4) input:checked) .skill-group:nth-child(4) {
      display: grid;
    }
  }

  .pills {
    --glow:
      0 0 0 1px var(--color-chip), 0 8px 24px -6px var(--color-accent-glow),
      0 0 16px var(--color-accent-glow);

    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .skill {
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: var(--glow);
    font-size: var(--text-sm);
    transition:
      background-color 250ms var(--ease-out),
      color 250ms var(--ease-out),
      translate 250ms var(--ease-out);
  }

  .skill:hover {
    background: var(--color-chip);
    color: var(--color-accent-hover);
    translate: 0 -2px;
  }

  /*
   * Certifications: soft folders, Apple Files style, four across (two by two on phones), one calm
   * pale-sky shape each with the name and issuer set beneath. Pointing at one (or focusing it)
   * tips its front forward and a certificate rises out. The card is a Windows window around them:
   * minimise, maximise and close on its title bar (WindowBar.astro), and no title.
   */

  /* The window fills the card to its edges; the skills set its height, and the folders sit in the
     middle of what's left under the title bar. */
  .panel[data-panel='certifications'] {
    display: grid;
    grid-template-rows: auto 1fr;
    margin: calc(-1 * var(--card-pad));
  }

  .cert-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6) var(--space-4);
    align-self: center;
    padding: var(--space-6) var(--card-pad) var(--card-pad);
  }

  .cert-card {
    display: grid;
    gap: 2px;
    justify-items: center;
    width: 100%;
    padding: 6px 4px 8px;
    border: 0;
    border-radius: 14px;
    background: none;
    color: var(--color-text);
    font: inherit;
    text-align: center;
    cursor: pointer;
  }

  .folder {
    position: relative;
    display: block;
    width: 82%;
    aspect-ratio: 240 / 200;
    margin-block-end: 10px;
    filter: drop-shadow(0 8px 12px var(--color-accent-glow));
    perspective: 500px;
  }

  .folder-back,
  .folder-front {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .folder-back {
    fill: var(--color-accent-light);
  }

  .sheet {
    position: absolute;
    inset: 16% 10% 20%;
    border-radius: 6px;
    background: var(--color-surface);
    box-shadow: 0 1px 3px var(--color-accent-glow);
    transition: translate 380ms var(--ease-out);
  }

  .folder-front {
    fill: var(--color-chip-edge);
    transform-origin: 50% 100%;
    transition: transform 380ms var(--ease-out);
  }

  .cert-card:is(:hover, :focus-visible) .folder-front {
    transform: rotateX(-24deg);
  }

  .cert-card:is(:hover, :focus-visible) .sheet {
    translate: 0 -16%;
  }

  .name {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: 1.25;
  }

  .issuer {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  /* The viewer: certificates on the grey, one at a time, the arrows beneath and a count above. */
  .cert-view {
    width: min(100% - 32px, 52rem);
    max-width: none;
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-card);
    background: var(--color-shell);
    color: var(--color-text);
  }

  .cert-view[open] {
    animation: cert-view-in 300ms var(--ease-standard);
  }

  @keyframes cert-view-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }

  /* A one-off entrance: under paused animations it would freeze unseen on its first frame. */
  :global(.motion-paused) .cert-view[open] {
    animation-play-state: running !important;
  }

  .cert-view::backdrop {
    background: var(--color-scrim);
    backdrop-filter: blur(6px);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 12px 0 24px;
  }

  .count {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .round {
    display: grid;
    place-items: center;
    width: var(--icon-button);
    height: var(--icon-button);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: var(--shadow-secondary);
    color: var(--color-text);
    cursor: pointer;
  }

  .prev :global(.icon) {
    rotate: 90deg;
  }

  .next :global(.icon) {
    rotate: -90deg;
  }

  .track {
    display: flex;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .slide {
    flex: 0 0 100%;
    margin: 0;
    padding: 16px 24px;
    scroll-snap-align: start;
  }

  /* Each certificate in the viewer in one of four blues. */
  .slide:nth-child(4n + 1) {
    --cert: var(--cert-1);
  }

  .slide:nth-child(4n + 2) {
    --cert: var(--cert-2);
  }

  .slide:nth-child(4n + 3) {
    --cert: var(--cert-3);
  }

  .slide:nth-child(4n + 4) {
    --cert: var(--cert-4);
  }

  /* A certificate, landscape; until its image comes, a card ruled in its folder's blue. */
  .certificate {
    display: block;
    width: 100%;
    max-height: 62dvh;
    margin-inline: auto;
    border-radius: 6px;
    box-shadow: var(--shadow-secondary);
    object-fit: contain;
  }

  .placeholder {
    display: grid;
    gap: 8px;
    place-content: center;
    justify-items: center;
    aspect-ratio: 1.414;
    padding: 24px;
    border: 2px solid var(--cert);
    background: var(--color-surface);
    box-shadow:
      inset 0 0 0 6px var(--color-surface),
      inset 0 0 0 7px var(--cert),
      var(--shadow-secondary);
    color: var(--color-text-muted);
    text-align: center;
  }

  .placeholder p {
    margin: 0;
  }

  .placeholder :global(.icon) {
    color: var(--cert);
  }

  .kind {
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .title {
    max-width: 22ch;
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 3.5vw, 2rem);
    line-height: 1.15;
  }

  .steps {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    padding: 4px 0 20px;
  }

  /* The picked group shows. */
  :global(#skills:has(input[value='tools']:checked)) .panel[data-panel='tools'],
  :global(#skills:has(input[value='skills']:checked)) .panel[data-panel='skills'],
  :global(#skills:has(input[value='certifications']:checked)) .panel[data-panel='certifications'] {
    visibility: visible;
  }

  /*
   * Phones. The slide sits on top, its thumbnails in a row beneath; the pills are smaller, and the
   * folders two by two.
   */
  @media (width < 40rem) {
    .deck {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      padding: 12px;
    }

    .phases {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      order: 2;
    }

    .skill-group {
      aspect-ratio: auto;
      min-height: 180px;
      padding: 16px;
    }

    .skill-group h4 {
      font-size: 1.25rem;
    }

    .pills {
      gap: 7px;
    }

    .skill {
      padding: 6px 11px;
      font-size: var(--text-xs);
    }

    .cert-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .desk {
      min-height: 190px;
    }
  }
</style>
