---
import type { CollectionEntry } from 'astro:content';
import Shell from '../Shell.astro';

interface Props {
  skills: CollectionEntry<'skills'>['data'];
  heading: string;
  intro: string;
}

const { skills, heading, intro } = Astro.props;
---

<Shell
  id="skills"
  heading={heading}
  intro={intro}
  collapsible="open"
  icon="M6 5h8a3 3 0 0 1 0 6H6a3 3 0 0 1 0-6zM10 13h8a3 3 0 0 1 0 6h-8a3 3 0 0 1 0-6z"
>
  <div class="card" data-reveal="rise">
    <h3 class="label">Skills</h3>
    <ul class="chips" role="list">
      {skills.skills.map((skill) => (
        <li class="chip skill">{skill}</li>
      ))}
    </ul>
    <h3 class="label">Certifications</h3>
    <ul class="chips" role="list">
      {skills.certifications.map((certification) => (
        <li class="chip cert">{certification}</li>
      ))}
    </ul>
  </div>
</Shell>

<style>
  /*
   * Skills and certifications as flat, soft sky chips in two short groups: pale sky for skills,
   * white with a sky edge for certifications. No shading or motion beyond the section's rise.
   */
  .label {
    margin-block-end: var(--space-3);
  }

  .chips + .label {
    margin-block-start: var(--space-6);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .chip {
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    color: var(--color-accent-hover);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .skill {
    background: var(--color-chip);
  }

  .cert {
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-chip-edge);
  }
</style>
