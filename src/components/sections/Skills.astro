---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../lib/paths.ts';
import Icon from '../Icon.astro';
import Shell from '../Shell.astro';
import SkyGradient from '../SkyGradient.astro';
import Switch from '../Switch.astro';

interface Props {
  skills: CollectionEntry<'skills'>['data'];
  heading: string;
  intro: string;
}

const { skills, heading, intro } = Astro.props;
const groups = [
  { value: 'tools', label: 'Tools' },
  { value: 'skills', label: 'Skills' },
  { value: 'certifications', label: 'Certifications' },
];
// A folder's back (with its tab) and its front, on a 240 × 200 grid.
const FOLDER_BACK =
  'M0 14Q0 0 14 0H88Q97 0 103 7L114 21Q120 28 130 28H226Q240 28 240 42V186Q240 200 226 200H14Q0 200 0 186Z';
const FOLDER_FRONT = 'M0 70Q0 58 12 58H228Q240 58 240 70V186Q240 200 226 200H14Q0 200 0 186Z';
---

{/*
  The Toolkit: the tools in a dock on a patch of the live sky, the skills as pills under three
  headings, the certifications as folders, each opening its certificate in a viewer. One group shows at a
  time in one card, turning to the next every three seconds (in CSS, below) until the visitor
  picks one with the switch.
*/}
<Shell id="skills" heading={heading} intro={intro} collapsible="open">
  <Switch slot="actions" name="toolkit-group" label="Show" options={groups} start={null} />
  <div class="card toolkit" data-reveal="rise">
    <div class="panel" data-panel="tools">
      <h3 class="visually-hidden">Tools</h3>
      <div class="desk">
        <SkyGradient class="desk-sky" scale={0.5} />
        <ul class="dock" role="list">
          {skills.tools.map((tool) => (
            <li class="tool">
              <span class="tool-name">{tool.name}</span>
              <span class="tool-icon">
                <img src={withBase(tool.logo)} alt="" width="34" height="34" loading="lazy" />
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="panel" data-panel="skills">
      <h3 class="visually-hidden">Skills</h3>
      <fieldset class="phases">
        <legend class="visually-hidden">Phase</legend>
        {skills.groups.map(({ group }, index) => (
          <label>
            <input
              class="visually-hidden"
              type="radio"
              name="skill-phase"
              value={`phase-${index + 1}`}
              checked={index === 0}
            />
            <span>{group}</span>
          </label>
        ))}
      </fieldset>
      <div class="skill-groups">
        {skills.groups.map(({ group, items }) => (
          <div class="skill-group">
            <h4>{group}</h4>
            <ul class="pills" role="list">
              {items.map((skill) => (
                <li class="skill">{skill}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <div class="panel" data-panel="certifications">
      <h3 class="visually-hidden">Certifications</h3>
      <ul class="cert-cards" role="list">
        {skills.certifications.map(({ title, issuer, short }) => (
          <li>
            {/* Disabled until the viewer's script is ready: without JavaScript it opens nothing. */}
            <button
              class="cert-card"
              type="button"
              aria-label={`View certificate: ${title}, ${issuer}`}
              disabled
            >
              <span class="folder" aria-hidden="true">
                <svg class="folder-back" viewBox="0 0 240 200">
                  <path d={FOLDER_BACK} />
                </svg>
                <span class="sheet"></span>
                <svg class="folder-front" viewBox="0 0 240 200">
                  <path d={FOLDER_FRONT} />
                </svg>
              </span>
              <span class="name" aria-hidden="true">
                {short}
              </span>
              <span class="issuer" aria-hidden="true">
                {issuer}
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <dialog class="cert-view" aria-label="Certificates">
    <div class="bar">
      <p class="count" aria-live="polite">
        1 of {skills.certifications.length}
      </p>
      <button class="round close" type="button" aria-label="Close certificates">
        <Icon name="close" />
      </button>
    </div>
    <div class="track">
      {skills.certifications.map(({ title, issuer, image }) => (
        <figure class="slide">
          {image ? (
            <img
              class="certificate"
              src={withBase(image)}
              alt={`${title} certificate, from ${issuer}`}
              loading="lazy"
            />
          ) : (
            <div class="certificate placeholder">
              <Icon name="skills" size={34} />
              <p class="kind">Certificate</p>
              <p class="title">{title}</p>
              <p>{issuer}</p>
              <p class="note">Placeholder: the certificate itself is on its way</p>
            </div>
          )}
        </figure>
      ))}
    </div>
    <div class="steps">
      <button class="round prev" type="button" aria-label="Previous certificate">
        <Icon name="chevron-down" />
      </button>
      <button class="round next" type="button" aria-label="Next certificate">
        <Icon name="chevron-down" />
      </button>
    </div>
  </dialog>
</Shell>

<script>
  // Focusing anything in a group (a folder, or on a phone a phase) picks that group, so focus never
  // sits on a group that's out of sight.
  document.querySelector('#skills .toolkit')?.addEventListener('focusin', ({ target }) => {
    const group = (target as Element).closest<HTMLElement>('.panel')?.dataset.panel;
    const pick = document.querySelector<HTMLInputElement>(`#skills [value="${group}"]`);
    if (pick) pick.checked = true;
  });

  // The certificates. A folder opens the viewer on its own certificate; the arrows, the arrow keys
  // or a swipe move through the rest, wrapping round, and the close button, Escape or a click
  // beside it close it. The count changes only when the certificate does, so a screen reader
  // hears it once.
  const viewer = document.querySelector<HTMLDialogElement>('.cert-view');
  const track = viewer?.querySelector<HTMLElement>('.track');
  const count = viewer?.querySelector('.count');
  if (viewer && track && count) {
    const total = track.children.length;
    const at = () => Math.round(track.scrollLeft / track.clientWidth);
    const tally = () => {
      const text = `${at() + 1} of ${total}`;
      if (count.textContent !== text) count.textContent = text;
    };
    // 'auto' takes the track's own scroll-behavior: smooth, or instant under reduced motion.
    const go = (index: number, behavior: ScrollBehavior = 'auto') =>
      track.scrollTo({ left: ((index + total) % total) * track.clientWidth, behavior });
    track.onscroll = tally;
    document.querySelectorAll<HTMLButtonElement>('.cert-card').forEach((card, index) => {
      card.onclick = () => {
        viewer.showModal();
        go(index, 'instant');
        tally();
      };
      card.disabled = false;
    });
    viewer.onclick = ({ target }) => {
      const element = target as Element;
      if (element === viewer || element.closest('.close')) viewer.close();
      else if (element.closest('.prev')) go(at() - 1);
      else if (element.closest('.next')) go(at() + 1);
    };
    viewer.onkeydown = (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      go(at() + (event.key === 'ArrowLeft' ? -1 : 1));
    };
  }
</script>

<style>
  /*
   * The three groups share one cell of the card, so it holds the tallest group's height and never
   * jumps. The groups not showing are transparent rather than hidden, so screen readers still read
   * every group, in order (on phones, all but the picked phase of the skills are hidden).
   */
  .toolkit {
    display: grid;
    overflow: hidden;
  }

  .panel {
    grid-area: 1 / 1;
    opacity: 0;
    pointer-events: none;
  }

  .dock,
  .pills,
  .cert-cards {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /*
   * Tools: a dock on a patch of the live sky, filling the card to its edges (past its padding).
   * With a pointer, the icon pointed at swells and its name pops up above, its neighbours swelling
   * a little less, like the Mac's dock. Without hover (phones, tablets) the names sit under the
   * icons, and a gentle wave runs along the dock every few seconds.
   */
  .panel[data-panel='tools'] {
    margin: calc(-1 * var(--card-pad));
  }

  .desk {
    position: relative;
    display: grid;
    place-items: end center;
    height: 100%;
    min-height: 220px;
    padding: 0 16px 22px;
    isolation: isolate;
    container-type: inline-size;
  }

  .desk-sky {
    position: absolute;
    z-index: -1;
    inset: 0;
  }

  .dock {
    display: flex;
    gap: 10px;
    align-items: end;
    padding: 10px 12px;
    border: 1px solid var(--color-frost);
    border-radius: 24px;
    background: var(--color-frost);
    box-shadow: 0 18px 40px -16px var(--watch-shadow);
    backdrop-filter: blur(12px);
  }

  .tool {
    position: relative;
    display: grid;
    justify-items: center;
  }

  /* Sized from the sky's width (up to 60px), so the dock always fits across, even at 320px. */
  .tool-icon {
    display: grid;
    place-items: center;
    width: min(60px, 14cqi);
    height: min(60px, 14cqi);
    border-radius: 16px;
    background: var(--color-surface);
    box-shadow: var(--shadow-secondary);
    transform-origin: 50% 100%;
    transition:
      scale 300ms var(--ease-out),
      translate 300ms var(--ease-out);
  }

  .tool-icon img {
    width: 56%;
    height: 56%;
    object-fit: contain;
  }

  /* The names: under the icons by default, as tooltips where there's hover (below). */
  .tool-name {
    grid-row: 2;
    padding-block-start: 4px;
    color: var(--color-text);
    font-size: 0.625rem;
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }

  @media (hover: hover) {
    .tool-name {
      position: absolute;
      bottom: calc(100% + 36px);
      padding: 3px 10px;
      border-radius: var(--radius-pill);
      background: var(--color-inverse);
      color: var(--color-on-inverse);
      font-size: var(--text-xs);
      opacity: 0;
      pointer-events: none;
      translate: 0 6px;
      transition:
        opacity 200ms var(--ease-out),
        translate 200ms var(--ease-out);
    }

    .tool:hover .tool-name {
      opacity: 1;
      translate: 0 0;
    }

    .tool:hover .tool-icon {
      scale: 1.45;
      translate: 0 -8px;
    }

    .tool:has(+ .tool:hover) .tool-icon,
    .tool:hover + .tool .tool-icon {
      scale: 1.2;
      translate: 0 -3px;
    }
  }

  /* Without hover, a wave runs along the dock every six seconds, each icon a moment after the last. */
  @keyframes tool-wave {
    0%,
    16%,
    100% {
      scale: 1;
      translate: 0 0;
    }

    8% {
      scale: 1.2;
      translate: 0 -5px;
    }
  }

  @media (hover: none) {
    .tool-icon {
      animation: tool-wave 6s var(--ease-out) infinite;
      animation-delay: calc(var(--i, 0) * 140ms);
    }
  }

  .tool:nth-child(2) {
    --i: 1;
  }

  .tool:nth-child(3) {
    --i: 2;
  }

  .tool:nth-child(4) {
    --i: 3;
  }

  .tool:nth-child(5) {
    --i: 4;
  }

  .tool:nth-child(6) {
    --i: 5;
  }

  .tool:nth-child(7) {
    --i: 6;
  }

  .tool:nth-child(8) {
    --i: 7;
  }

  /*
   * Skills: every skill as a white pill with Ask me's glow, under three quiet headings in the
   * order a project runs (skills.yaml's groups). Pointing at a pill lights it blue.
   */
  .skill-groups {
    display: grid;
    gap: 16px;
  }

  .skill-group {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
  }

  .skill-group h4 {
    margin: 0;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* The phase control shows only on phones (below). */
  .phases {
    display: none;
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .pills {
    --glow:
      0 0 0 1px var(--color-chip), 0 8px 24px -6px var(--color-accent-glow),
      0 0 16px var(--color-accent-glow);

    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .skill {
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: var(--glow);
    font-size: var(--text-sm);
    transition:
      background-color 250ms var(--ease-out),
      color 250ms var(--ease-out),
      translate 250ms var(--ease-out);
  }

  .skill:hover {
    background: var(--color-chip);
    color: var(--color-accent-hover);
    translate: 0 -2px;
  }

  /*
   * Certifications: soft folders, Apple Files style, four across (two by two on phones), one calm
   * pale-sky shape each with the name and issuer set beneath. Pointing at one (or focusing it)
   * tips its front forward and a certificate rises out.
   */

  /* The skills set the card's height, so the folders sit in its middle. */
  .panel[data-panel='certifications'] {
    align-self: center;
  }

  .cert-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6) var(--space-4);
    padding-block-start: var(--space-2);
  }

  .cert-card {
    display: grid;
    gap: 2px;
    justify-items: center;
    width: 100%;
    padding: 6px 4px 8px;
    border: 0;
    border-radius: 14px;
    background: none;
    color: var(--color-text);
    font: inherit;
    text-align: center;
    cursor: pointer;
  }

  .folder {
    position: relative;
    display: block;
    width: 82%;
    aspect-ratio: 240 / 200;
    margin-block-end: 10px;
    filter: drop-shadow(0 8px 12px var(--color-accent-glow));
    perspective: 500px;
  }

  .folder-back,
  .folder-front {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .folder-back {
    fill: var(--color-accent-light);
  }

  .sheet {
    position: absolute;
    inset: 16% 10% 20%;
    border-radius: 6px;
    background: var(--color-surface);
    box-shadow: 0 1px 3px var(--color-accent-glow);
    transition: translate 380ms var(--ease-out);
  }

  .folder-front {
    fill: var(--color-chip-edge);
    transform-origin: 50% 100%;
    transition: transform 380ms var(--ease-out);
  }

  .cert-card:is(:hover, :focus-visible) .folder-front {
    transform: rotateX(-24deg);
  }

  .cert-card:is(:hover, :focus-visible) .sheet {
    translate: 0 -16%;
  }

  .name {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: 1.25;
  }

  .issuer {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  /* The viewer: certificates on the grey, one at a time, the arrows beneath and a count above. */
  .cert-view {
    width: min(100% - 32px, 52rem);
    max-width: none;
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-card);
    background: var(--color-shell);
    color: var(--color-text);
  }

  .cert-view[open] {
    animation: cert-view-in 300ms var(--ease-standard);
  }

  @keyframes cert-view-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }

  /* A one-off entrance: under paused animations it would freeze unseen on its first frame. */
  :global(.motion-paused) .cert-view[open] {
    animation-play-state: running !important;
  }

  .cert-view::backdrop {
    background: var(--color-scrim);
    backdrop-filter: blur(6px);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 12px 0 24px;
  }

  .count {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .round {
    display: grid;
    place-items: center;
    width: var(--icon-button);
    height: var(--icon-button);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: var(--shadow-secondary);
    color: var(--color-text);
    cursor: pointer;
  }

  .prev :global(.icon) {
    rotate: 90deg;
  }

  .next :global(.icon) {
    rotate: -90deg;
  }

  .track {
    display: flex;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .slide {
    flex: 0 0 100%;
    margin: 0;
    padding: 16px 24px;
    scroll-snap-align: start;
  }

  /* Each certificate in the viewer in one of four blues. */
  .slide:nth-child(4n + 1) {
    --cert: var(--cert-1);
  }

  .slide:nth-child(4n + 2) {
    --cert: var(--cert-2);
  }

  .slide:nth-child(4n + 3) {
    --cert: var(--cert-3);
  }

  .slide:nth-child(4n + 4) {
    --cert: var(--cert-4);
  }

  /* A certificate, landscape; until the real one comes, a placeholder ruled in its card's blue. */
  .certificate {
    display: block;
    width: 100%;
    max-height: 62dvh;
    margin-inline: auto;
    border-radius: 6px;
    box-shadow: var(--shadow-secondary);
    object-fit: contain;
  }

  .placeholder {
    display: grid;
    gap: 8px;
    place-content: center;
    justify-items: center;
    aspect-ratio: 1.414;
    padding: 24px;
    border: 2px solid var(--cert);
    background: var(--color-surface);
    box-shadow:
      inset 0 0 0 6px var(--color-surface),
      inset 0 0 0 7px var(--cert),
      var(--shadow-secondary);
    color: var(--color-text-muted);
    text-align: center;
  }

  .placeholder p {
    margin: 0;
  }

  .placeholder :global(.icon) {
    color: var(--cert);
  }

  .kind {
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .title {
    max-width: 22ch;
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 3.5vw, 2rem);
    line-height: 1.15;
  }

  .note {
    margin-block-start: 8px;
    padding: 4px 10px;
    border: 1px dashed var(--color-chip-edge);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
  }

  .steps {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    padding: 4px 0 20px;
  }

  /*
   * On its own, the card turns to the next group every three seconds (a nine-second loop, each
   * group a third of it), and the switch's tabs light up in step. Hovering or focusing the section
   * pauses it, as does the footer's pause (global.css); picking a group stops it on that group.
   */

  /* The group in view takes clicks (its cards), and the others let them through. */
  @keyframes toolkit-turn {
    0% {
      opacity: 0;
      pointer-events: none;
    }

    4%,
    30% {
      opacity: 1;
      pointer-events: auto;
    }

    33.3%,
    100% {
      opacity: 0;
      pointer-events: none;
    }
  }

  @keyframes toolkit-tab {
    0%,
    33.3% {
      background: var(--color-accent);
      color: var(--color-on-accent);
    }

    33.4%,
    100% {
      background: transparent;
      color: var(--color-text-muted);
    }
  }

  .panel,
  :global(#skills .switch span) {
    animation: toolkit-turn 9s infinite both;
  }

  :global(#skills .switch span) {
    animation-name: toolkit-tab;
  }

  /*
   * Each later group starts part-way round the loop, rather than after a delay: waiting out a delay,
   * a tab would sit in its lit first frame.
   */
  .panel[data-panel='skills'],
  :global(#skills .switch label:nth-of-type(2) span) {
    animation-delay: -6s;
  }

  .panel[data-panel='certifications'],
  :global(#skills .switch label:nth-of-type(3) span) {
    animation-delay: -3s;
  }

  :global(#skills:is(:hover, :focus-within)) .panel,
  :global(#skills:is(:hover, :focus-within) .switch span) {
    animation-play-state: paused;
  }

  /* A picked group stays; the rest stay out of sight. */
  :global(#skills:has([name='toolkit-group']:checked)) .panel,
  :global(#skills:has([name='toolkit-group']:checked) .switch span) {
    animation: none;
  }

  :global(#skills:has(input[value='tools']:checked)) .panel[data-panel='tools'],
  :global(#skills:has(input[value='skills']:checked)) .panel[data-panel='skills'],
  :global(#skills:has(input[value='certifications']:checked)) .panel[data-panel='certifications'] {
    opacity: 1;
    pointer-events: auto;
  }

  /* Under reduced motion the card holds still on the tools, until another group is picked. */
  @media (prefers-reduced-motion: reduce) {
    .panel,
    :global(#skills .switch span) {
      animation-name: none;
    }

    :global(#skills:not(:has([name='toolkit-group']:checked))) .panel[data-panel='tools'] {
      opacity: 1;
      pointer-events: auto;
    }

    :global(#skills:not(:has([name='toolkit-group']:checked)) .switch label:first-of-type span) {
      background: var(--color-accent);
      color: var(--color-on-accent);
    }
  }

  /*
   * Phones. The skills show one phase at a time, picked from a segmented control (the phases' own
   * radios), rather than every group's pills in a long column; the control names the phase, so its
   * heading is left to screen readers. The pills are smaller, the folders two by two, and the dock
   * closer together.
   */
  @media (width < 40rem) {
    .phases {
      display: flex;
      margin-block-end: 14px;
      padding: 3px;
      border-radius: 10px;
      background: var(--color-shell);
    }

    .phases label {
      flex: 1;
    }

    .phases span {
      display: block;
      padding: 7px 4px;
      border-radius: 8px;
      font-size: var(--text-xs);
      text-align: center;
      cursor: pointer;
    }

    .phases input:checked + span {
      background: var(--color-surface);
      box-shadow: var(--shadow-secondary);
      font-weight: var(--weight-medium);
    }

    .phases input:focus-visible + span {
      outline: 2px solid var(--color-focus);
      outline-offset: 2px;
    }

    .skill-group {
      display: none;
      grid-template-columns: minmax(0, 1fr);
    }

    .skill-group h4 {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

