---
import { withBase } from '../../lib/paths.ts';
import Icon from '../Icon.astro';
import Shell from '../Shell.astro';
import SkyGradient from '../SkyGradient.astro';
import VoiceIntro from '../VoiceIntro.astro';

interface Props {
  heading: string;
  intro: string;
  questions: { question: string; answer: string; audio?: string | undefined }[];
  name: string;
  email: string;
}

const { heading, intro, questions, name, email } = Astro.props;
const firstName = name.split(' ')[0];
// On phones this many questions show before the "more" pill.
const SHOWN = 3;
---

{/*
  Ask me: a card after an AI chat, and not one. It opens on a greeting under a ball of the living
  sky; a question pill shows the owner's written answer in the greeting's place, signed by a small
  ball. Typing fades the pills that don't fit, and Enter or the arrow shows the best fit (src/lib/
  ask.ts). A visitor's own question always has somewhere to go: a blue "Ask your own" pill leads to
  the field; a question with no written answer is quoted back with a button to email it (or to book
  a call); and under an answer found by typing, a line still offers to send the question as typed.
  On phones the first three questions show, with a pill that opens the rest in place. Without
  JavaScript, every question and answer shows in turn. An answer the owner has recorded (its `audio` in
  profile.yaml) gets a "Hear my answer" button under it.
*/}
<Shell id="interview" heading={heading} intro={intro} collapsible="open">
  <ask-me class="card ask" data-email={email} data-reveal="rise">
    <div class="top">
      <div class="hello" hidden>
        <span class="float" aria-hidden="true">
          <span class="orb">
            <SkyGradient class="orb-sky" />
          </span>
          <span class="orb-shadow"></span>
        </span>
        <p>
          Ask me <em>anything.</em>
        </p>
      </div>
      <div class="answers" aria-live="polite">
        {questions.map(({ question, answer, audio }) => (
          <article class="answer">
            <h3 class="asked">{question}</h3>
            <p>{answer}</p>
            {audio && (
              <VoiceIntro as="p" src={withBase(audio)} play="Hear my answer" pause="Pause answer" />
            )}
          </article>
        ))}
        <div class="miss" hidden>
          <h3 class="quoted"></h3>
          <p>I haven't written that one up yet, but I'd like to answer it.</p>
          <a class="btn btn-primary" href={`mailto:${email}`} data-own>
            Email me this question
          </a>
          <p class="fine">
            Opens your email with the question filled in. Or <a href="#contact">book a call</a> and
            ask me there.
          </p>
        </div>
      </div>
      <p class="signed">
        <span class="orb orb-small" aria-hidden="true">
          <SkyGradient class="orb-sky" />
        </span>
        <span>
          Answered by <b>{firstName}</b>
        </span>
      </p>
      <p class="not" hidden>
        Not what you asked?{' '}
        <a href={`mailto:${email}`} data-own>
          Send me your question
        </a>
      </p>
    </div>
    <div class="asker" hidden>
      <ul class="pills" role="list" aria-label="Questions I've answered">
        {questions.map(({ question }, index) => (
          <li class:list={{ extra: index >= SHOWN }}>
            <button type="button" aria-pressed="false">
              {question}
            </button>
          </li>
        ))}
        {questions.length > SHOWN && (
          <li class="more-item">
            <button
              class="more"
              type="button"
              aria-expanded="false"
              data-label={`${questions.length - SHOWN} more questions`}
            >
              {questions.length - SHOWN} more questions
            </button>
          </li>
        )}
        <li>
          <button class="own" type="button">
            Ask your own
          </button>
        </li>
      </ul>
      <form class="field">
        <input
          type="text"
          aria-label="Ask me a question"
          autocomplete="off"
          enterkeyhint="send"
          placeholder="Ask me a question…"
        />
        <button class="send" type="submit" aria-label="Ask">
          <Icon name="arrow-up" size={18} />
        </button>
      </form>
    </div>
  </ask-me>
</Shell>

<script>
  import { askMailto, matchQuestions, queryWords } from '../../lib/ask.ts';

  // One answer at a time, in the greeting's place: from a pill, or from a typed question sent with
  // Enter or the arrow. Typing fades the pills that don't fit it.
  class AskMe extends HTMLElement {
    connectedCallback() {
      const [hello, asker, signed, miss] = ['.hello', '.asker', '.signed', '.miss'].map((query) =>
        this.querySelector<HTMLElement>(query),
      );
      const form = this.querySelector('form');
      const input = this.querySelector('input');
      const [quoted, not] = ['.quoted', '.not'].map((query) =>
        this.querySelector<HTMLElement>(query),
      );
      const list = this.querySelector('.pills');
      if (!hello || !asker || !signed || !miss || !form || !input || !quoted || !not || !list)
        return;
      // The questions' own pills (pressed or not), apart from "more" and "Ask your own".
      const pills = [...list.querySelectorAll<HTMLButtonElement>('[aria-pressed]')];
      const answers = [...this.querySelectorAll<HTMLElement>('.answer')];
      const items = answers.map(({ children }) => ({
        question: children[0]?.textContent ?? '',
        answer: children[1]?.textContent ?? '',
      }));

      // Shows answer `index`, or with -1 the offer to email the question instead. A typed question
      // is quoted in that offer, and stays sendable under an answer it found.
      const show = (index: number, typed = '') => {
        // An answer being read aloud stops as another takes its place.
        this.querySelector<HTMLElement>('voice-intro[data-playing] button')?.click();
        answers.forEach((answer, at) => (answer.hidden = at !== index));
        pills.forEach((pill, at) => (pill.ariaPressed = String(at === index)));
        hello.hidden = true;
        miss.hidden = index >= 0;
        signed.hidden = index < 0;
        not.hidden = index < 0 || !typed;
        if (!typed) return;
        quoted.textContent = `“${typed}”`;
        for (const link of this.querySelectorAll<HTMLAnchorElement>('[data-own]')) {
          link.href = askMailto(this.dataset['email'] ?? '', typed);
        }
      };
      // While a question is being typed every pill shows (on phones, those behind "more" too), so
      // the one that fits is there to see.
      const fade = () => {
        const fits = matchQuestions(input.value, items);
        pills.forEach((pill, at) => pill.classList.toggle('faded', !fits.includes(at)));
        list.classList.toggle('typing', Boolean(input.value.trim()));
      };

      pills.forEach((pill, index) => (pill.onclick = () => show(index)));
      input.oninput = fade;
      form.onsubmit = (event) => {
        event.preventDefault();
        const typed = input.value.trim();
        if (!typed) return;
        // A question of only common words ("Who are you?") has nothing to search on: it gets the
        // offer to send it, not silence.
        const [best = -1] = queryWords(typed).length ? matchQuestions(typed, items) : [];
        show(best, typed);
        if (best >= 0) input.value = '';
        fade();
      };

      // On phones the questions past the third wait behind this pill, which opens them in place.
      const more = list.querySelector<HTMLButtonElement>('.more');
      if (more) {
        more.onclick = () => {
          const open = list.classList.toggle('all');
          more.ariaExpanded = String(open);
          more.textContent = open ? 'Fewer questions' : (more.dataset['label'] ?? '');
        };
      }
      const own = list.querySelector<HTMLButtonElement>('.own');
      if (own) own.onclick = () => input.focus();

      answers.forEach((answer) => (answer.hidden = true));
      signed.hidden = true;
      hello.hidden = false;
      asker.hidden = false;
    }
  }

  customElements.define('ask-me', AskMe);
</script>

<style>
  /* Toolkit's white card, holding the greeting or an answer, the question pills and the field. */
  .ask {
    --glow:
      0 0 0 1px var(--color-chip), 0 8px 24px -6px var(--color-accent-glow),
      0 0 16px var(--color-accent-glow);

    display: grid;
    gap: 20px;
  }

  .top {
    display: grid;
    gap: var(--space-4);
    align-content: center;
    min-height: 170px;
  }

  .hello {
    display: grid;
    gap: 18px;
    justify-items: center;
    text-align: center;
  }

  .hello p {
    margin: 0;
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
  }

  .hello em {
    color: var(--color-accent);
    font-family: var(--font-serif);
  }

  /* The ball: the living sky (SkyGradient), soft-edged, with a glassy highlight and a glow. */
  .orb {
    position: relative;
    display: block;
    width: 84px;
    height: 84px;
    overflow: hidden;
    border-radius: 50%;
    box-shadow:
      0 0 24px 6px var(--color-accent-glow),
      0 0 60px 16px var(--color-accent-glow);
    filter: blur(1.5px);
    isolation: isolate;
  }

  .orb::after {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 36% 30%, var(--color-surface), transparent 62%);
    content: '';
    opacity: 0.7;
  }

  .orb-sky {
    position: absolute;
    inset: -6px;
    opacity: 0.8;
    filter: blur(5px);
  }

  /*
   * The ball floats in place: a slow bob over a soft shadow that shrinks and fades as it rises.
   * A loop, so the footer's pause holds it; under reduced motion it keeps still (global.css).
   */
  .float {
    position: relative;
    display: grid;
    justify-items: center;
  }

  .float .orb {
    animation: ask-orb-float 5s ease-in-out infinite;
  }

  .orb-shadow {
    position: absolute;
    bottom: -12px;
    width: 70%;
    height: 9px;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--color-accent) 30%, transparent),
      transparent
    );
    animation: ask-orb-shadow 5s ease-in-out infinite;
  }

  @keyframes ask-orb-float {
    0%,
    100% {
      translate: 0 0;
    }

    50% {
      translate: 0 -8px;
    }
  }

  @keyframes ask-orb-shadow {
    0%,
    100% {
      opacity: 0.9;
      scale: 1;
    }

    50% {
      opacity: 0.5;
      scale: 0.75;
    }
  }

  /* The small ball that signs an answer. */
  .orb-small {
    flex: none;
    width: 26px;
    height: 26px;
    box-shadow: 0 0 10px 2px var(--color-accent-glow);
    filter: none;
  }

  /* An answer, in the greeting's place; without JavaScript every answer shows, spaced apart. */
  .answers {
    display: grid;
    gap: var(--space-6);
  }

  .answer {
    display: grid;
    gap: var(--space-3);
    animation: answer-in 400ms var(--ease-out);
  }

  @keyframes answer-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* A one-off entrance, so it finishes even with animations paused (global.css). */
  :global(.motion-paused) .answer {
    animation-play-state: running !important;
  }

  .asked {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .answer p {
    margin: 0;
    line-height: var(--leading-body);
  }

  .signed {
    display: flex;
    gap: 10px;
    align-items: center;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .signed b {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  /*
   * When nothing answers the question: it's quoted back, with one clear button to email it and, in
   * the small print, the call as the other way. Centred, like the greeting whose place it takes
   * (an answer, being text to read, stays left-aligned).
   */
  .miss {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
    text-align: center;
  }

  .quoted {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
  }

  .miss p {
    max-width: 38ch;
    margin: 0;
    color: var(--color-text-muted);
    text-wrap: balance;
  }

  .fine,
  .not {
    font-size: var(--text-sm);
  }

  /* Under an answer found by typing: the question as typed can still be sent. */
  .not {
    margin: 0;
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--color-shell);
    color: var(--color-text-muted);
  }

  .fine a,
  .not a {
    color: var(--color-accent);
    font-weight: var(--weight-medium);
  }

  /* The questions, as pills that wrap; a faded pill doesn't fit what's typed. */
  .asker {
    display: grid;
    gap: 20px;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin: 0;
    padding: 4px 0;
    list-style: none;
  }

  .pills button {
    padding: 8px 14px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: var(--glow);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  .pills button:hover,
  .pills [aria-pressed='true'] {
    background: var(--color-chip);
    color: var(--color-accent-hover);
  }

  /* Still readable: about 5.2:1 on the white card. */
  .pills .faded {
    opacity: 0.6;
  }

  /* "N more questions" (phones only, below) in the pale sky; "Ask your own" in the accent. */
  .more-item {
    display: none;
  }

  .pills .more {
    background: var(--color-chip);
    color: var(--color-accent-hover);
    font-weight: var(--weight-medium);
  }

  .pills .own,
  .pills .own:hover {
    background: var(--color-accent);
    box-shadow: none;
    color: var(--color-on-accent);
    font-weight: var(--weight-medium);
  }

  .pills .own:hover {
    background: var(--color-accent-hover);
  }

  /* The field, with its round send arrow. */
  .field {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 6px 6px 6px 20px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: var(--glow);
  }

  /* Typing, the whole field wears the site's focus ring (it shows in forced colours too). */
  .field:has(input:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }

  /* No width of its own (a text box is about 20 characters wide by default, which on a phone pushed
     the page wider than the screen): it grows to fill the field instead. */
  input {
    flex: 1;
    width: 0;
    min-width: 0;
    padding: 8px 0;
    border: 0;
    background: none;
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-base);
  }

  /* The field wears the ring (above) where :has() can; elsewhere the text box keeps its own. */
  @supports selector(:has(*)) {
    input:focus {
      outline: none;
    }
  }

  input::placeholder {
    color: var(--color-text-muted);
  }

  .send {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-accent-hover);
    color: var(--color-on-accent);
    cursor: pointer;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .send:hover {
    transform: scale(1.06);
  }

  /*
   * On phones the card keeps short: a smaller ball and greeting, and the first three questions with
   * a pill that opens the rest in place, rather than seven lines of pills.
   */
  @media (width < 40rem) {
    .top {
      min-height: 0;
    }

    .hello {
      gap: 12px;
      padding-block: 8px;
    }

    .hello p {
      font-size: var(--text-xl);
    }

    .orb {
      width: 60px;
      height: 60px;
    }

    .orb-shadow {
      bottom: -9px;
      height: 7px;
    }

    .orb-small {
      width: 22px;
      height: 22px;
    }

    /* Three questions, then a pill that opens the rest in place: a short card, nothing sideways. */
    .pills {
      gap: 8px;
      justify-content: start;
    }

    /* The Toolkit's phone pill size, so the closing pair ("more", "Ask your own") share a row. */
    .pills button {
      padding: 7px 12px;
      font-size: var(--text-xs);
      text-align: start;
    }

    .more-item {
      display: block;
    }

    .pills:not(.all, .typing) .extra {
      display: none;
    }

    .quoted {
      font-size: var(--text-lg);
    }

    /* The email button takes the card's width, the clearest thing on it. */
    .miss .btn {
      justify-self: stretch;
      text-align: center;
    }
  }
</style>
