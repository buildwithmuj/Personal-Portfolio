---
import { withBase } from '../../lib/paths.ts';
import Shell from '../Shell.astro';

interface Props {
  heading: string;
  intro: string;
  questions: { question: string; answer: string }[];
  name: string;
  email: string;
  avatar?: string | undefined;
}

const { heading, intro, questions, name, email, avatar } = Astro.props;
const firstName = name.split(' ')[0];
---

{/*
  Interview me, as "Ask me": a box that looks like an AI prompt and isn't one. As the visitor
  types, it suggests the owner's own written questions (src/lib/ask.ts); picking one shows its
  answer, signed by the owner. A question with no written answer becomes an email to the owner.
  Without JavaScript, every question and answer shows in turn.
*/}
<Shell id="interview" heading={heading} intro={intro} collapsible="open" icon="interview">
  <ask-me class="ask" data-email={email}>
    <div class="asker" hidden>
      <div class="prompt">
        <input
          type="text"
          role="combobox"
          aria-label="Ask me a question"
          aria-controls="ask-list"
          aria-expanded="false"
          aria-autocomplete="list"
          autocomplete="off"
          placeholder="Ask me anything…"
        />
        <span class="no-ai" aria-hidden="true">
          No AI
        </span>
        <ul
          id="ask-list"
          class="suggest"
          role="listbox"
          aria-label="Questions I've answered"
          hidden
        >
          {questions.map(({ question }, index) => (
            <li id={`ask-${index}`} role="option" aria-selected="false">
              {question}
            </li>
          ))}
        </ul>
      </div>
      <div class="miss" hidden>
        <p>No written answer for that one yet. Ask me directly and I'll reply myself.</p>
        <a class="btn btn-primary" href={`mailto:${email}`}>
          Send me this question
        </a>
      </div>
    </div>
    <div class="answers" aria-live="polite">
      {questions.map(({ question, answer }) => (
        <article class="answer">
          <h3 class="asked">{question}</h3>
          <p>{answer}</p>
          <p class="signed">
            {avatar && <img src={withBase(avatar)} alt="" width="32" height="32" loading="lazy" />}
            <span>
              Answered by <b>{firstName}</b>, not an AI
            </span>
          </p>
        </article>
      ))}
    </div>
  </ask-me>
</Shell>

<script>
  import { askMailto, matchQuestions, queryWords } from '../../lib/ask.ts';

  // The prompt, its suggestions and one answer at a time. Arrow keys move through the
  // suggestions, Enter picks one and Escape closes them; a query nothing answers offers an email.
  class AskMe extends HTMLElement {
    connectedCallback() {
      const input = this.querySelector('input');
      const list = this.querySelector('ul');
      const miss = this.querySelector<HTMLElement>('.miss');
      const send = this.querySelector<HTMLAnchorElement>('.miss a');
      const box = this.querySelector<HTMLElement>('.answers');
      if (!input || !list || !miss || !send || !box) return;
      const options = [...list.children] as HTMLElement[];
      const answers = [...this.querySelectorAll<HTMLElement>('.answer')];
      const items = answers.map(({ children }) => ({
        question: children[0]?.textContent ?? '',
        answer: children[1]?.textContent ?? '',
      }));
      let shown: number[] = [];
      let active = -1;

      const open = (isOpen: boolean) => {
        list.hidden = !isOpen;
        input.ariaExpanded = String(isOpen);
      };
      const mark = (index: number) => {
        active = index;
        options.forEach((option, at) => (option.ariaSelected = String(shown[index] === at)));
        if (index < 0) input.removeAttribute('aria-activedescendant');
        else input.setAttribute('aria-activedescendant', `ask-${shown[index]}`);
      };
      // An unanswered question sets the last answer aside, so the offer to email stands alone.
      const unanswered = (isUnanswered: boolean) => {
        miss.hidden = !isUnanswered;
        box.hidden = isUnanswered;
      };
      const pick = (index: number) => {
        answers.forEach((answer, at) => (answer.hidden = at !== index));
        input.value = items[index]?.question ?? '';
        unanswered(false);
        open(false);
      };
      const filter = () => {
        const typed = queryWords(input.value).length > 0;
        shown = matchQuestions(input.value, items);
        options.forEach((option, at) => (option.hidden = !shown.includes(at)));
        list.append(...shown.map((index) => options[index] as HTMLElement));
        unanswered(typed && !shown.length);
        send.href = askMailto(this.dataset['email'] ?? '', input.value.trim());
        open(shown.length > 0);
        mark(typed && shown.length ? 0 : -1);
      };

      input.onfocus = () => {
        filter();
        input.select();
      };
      input.oninput = filter;
      input.onblur = () => open(false);
      input.onkeydown = (event) => {
        const { key } = event;
        const step = key === 'ArrowDown' ? 1 : key === 'ArrowUp' ? -1 : 0;
        if (key === 'Escape') open(false);
        else if (step) {
          event.preventDefault();
          if (list.hidden) filter();
          if (shown.length) mark((active + step + shown.length) % shown.length);
        } else if (key === 'Enter' && !list.hidden && shown.length) {
          event.preventDefault();
          pick(shown[Math.max(active, 0)] ?? 0);
        }
      };
      // Pressing down on a suggestion would blur the box before the click lands; keep focus.
      list.onmousedown = (event) => event.preventDefault();
      list.onclick = ({ target }) => {
        const option = (target as Element).closest('li');
        if (option) pick(options.indexOf(option));
      };

      pick(0);
      input.value = '';
      (this.firstElementChild as HTMLElement).hidden = false;
    }
  }

  customElements.define('ask-me', AskMe);
</script>

<style>
  .ask {
    display: grid;
    gap: var(--space-4);
  }

  /* The prompt: a white field with a soft focus ring and its "No AI" badge. */
  .prompt {
    position: relative;
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 12px 14px 12px 18px;
    border-radius: 18px;
    background: var(--color-surface);
    box-shadow: var(--shadow-secondary);
  }

  .prompt:focus-within {
    box-shadow:
      var(--shadow-secondary),
      0 0 0 3px var(--color-accent-glow);
  }

  input {
    flex: 1;
    min-width: 0;
    padding: 4px 0;
    border: 0;
    background: none;
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-base);
  }

  input:focus {
    outline: none;
  }

  input::placeholder {
    color: var(--color-text-muted);
  }

  .no-ai {
    flex: none;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-chip);
    color: var(--color-accent-hover);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  /* The suggestions drop over what's below, so the page never shifts as they open. */
  .suggest {
    position: absolute;
    z-index: 5;
    inset: calc(100% + 8px) 0 auto;
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 6px;
    border-radius: 18px;
    background: var(--color-surface);
    box-shadow:
      var(--shadow-secondary),
      0 20px 40px -14px var(--watch-shadow);
    list-style: none;
  }

  [role='option'] {
    padding: 10px 12px;
    border-radius: 12px;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  [role='option']:hover,
  [role='option'][aria-selected='true'] {
    background: var(--color-chip);
    color: var(--color-text);
  }

  /* When nothing answers the question: an offer to send it by email. */
  .miss {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    border-radius: 18px;
    background: var(--color-surface);
    box-shadow: var(--shadow-secondary);
  }

  .miss p {
    max-width: 34ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* The answer, signed. */
  .answers {
    display: grid;
    gap: var(--space-4);
  }

  .answer {
    display: grid;
    gap: var(--space-3);
    padding: 22px 24px;
    border-radius: 22px;
    background: var(--color-surface);
    box-shadow: var(--shadow-secondary);
    animation: answer-in 400ms var(--ease-out);
  }

  @keyframes answer-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* A one-off entrance, so it finishes even with animations paused (global.css). */
  :global(.motion-paused) .answer {
    animation-play-state: running !important;
  }

  .asked {
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .answer p {
    margin: 0;
    line-height: var(--leading-body);
  }

  .answer .signed {
    display: flex;
    gap: 10px;
    align-items: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .signed img {
    border-radius: 50%;
    background: var(--gradient-sky);
  }

  .signed b {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }
</style>
