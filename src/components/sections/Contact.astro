---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../lib/paths.ts';
import { socialLabels } from '../../lib/social.ts';
import BookingPanel from '../BookingPanel.astro';
import CopyEmail from '../CopyEmail.astro';
import Shell from '../Shell.astro';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
}

const { profile } = Astro.props;
---

<Shell
  id="contact"
  heading={profile.sections.contact.heading}
  intro={profile.sections.contact.intro}
>
  <div class="fields">
    <p class="field" data-reveal="rise">
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="m3.5 6.5 8.5 6 8.5-6"></path>
      </svg>
      <a class="email" href={`mailto:${profile.email}`}>
        {profile.email}
      </a>
      <CopyEmail email={profile.email} />
    </p>
    <p class="field" data-reveal="rise">
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M7 3h7l5 5v13H7z"></path>
        <path d="M14 3v5h5M10 13h6M10 17h6"></path>
      </svg>
      <a href={withBase('/cv')}>View CV</a>
    </p>
    <div class="field wide" data-reveal="rise">
      <span class="muted">Elsewhere</span>
      <ul class="socials" role="list">
        {profile.socials.map((social) => (
          <li>
            <a href={social.url}>{socialLabels[social.platform]}</a>
          </li>
        ))}
      </ul>
    </div>
    <div class="wide booking" data-reveal="rise">
      <BookingPanel url={profile.bookingUrl} name={profile.name} />
    </div>
  </div>
</Shell>

<style>
  /* Modelled on the reference's contact form: white 52px fields, 20px apart, then a full-width button. */
  .fields {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .field {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) 10px;
    align-items: center;
    max-width: none;
    min-height: 52px;
    padding: 8px 20px;
    border-radius: var(--radius-image);
    background: var(--color-surface);
  }

  .wide {
    grid-column: 1 / -1;
  }

  .field svg {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .field a {
    color: var(--color-text);
    text-decoration: none;
  }

  .field a:hover {
    text-decoration: underline;
  }

  .email {
    overflow-wrap: anywhere;
  }

  .muted {
    color: var(--color-text-muted);
  }

  .end {
    margin-inline-start: auto;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    padding: 0;
    list-style: none;
  }

  .booking {
    margin-block-start: var(--space-2);
  }

  @media (width < 40rem) {
    .fields {
      grid-template-columns: 1fr;
    }
  }
</style>
