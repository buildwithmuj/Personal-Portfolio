---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../lib/paths.ts';
import { socialLabels } from '../../lib/social.ts';
import BookingPanel from '../BookingPanel.astro';
import Icon from '../Icon.astro';
import Shell from '../Shell.astro';
import SocialIcon from '../SocialIcon.astro';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
}

const { profile } = Astro.props;
---

{/*
  Let's work together, invitation first: under the sky, a card that leads with the call (the
  availability, a big "Let's talk it through.", the booking button and a "Drop an email" button
  beside it), then one quiet line with the CV and the social links.
*/}
<Shell
  id="contact"
  heading={profile.sections.contact.heading}
  intro={profile.sections.contact.intro}
  sky
>
  <div class="invite" data-reveal="rise">
    {profile.availability && (
      <p class="availability">
        <span class="dot" aria-hidden="true"></span>
        {profile.availability}
      </p>
    )}
    <p class="big">
      Let's talk it <em>through.</em>
    </p>
    <div class="actions">
      <BookingPanel url={profile.bookingUrl} name={profile.name} />
      <a class="btn btn-secondary mail" href={`mailto:${profile.email}`}>
        <Icon name="send-mail" size={22} class="fly" />
        Drop an email
      </a>
    </div>
    <p class="meta">A 30-minute call, booked in a couple of clicks.</p>
  </div>
  <div class="details" data-reveal="rise">
    <ul class="socials" role="list">
      <li>
        <a class="social" href={withBase('/cv')} aria-label="View CV" title="View CV" data-cv>
          <Icon name="cv" />
        </a>
      </li>
      {profile.socials.map((social) => (
        <li>
          <a class="social" href={social.url} aria-label={socialLabels[social.platform]}>
            <SocialIcon platform={social.platform} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</Shell>

<style>
  .invite {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding: 30px;
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-secondary);
  }

  .availability {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    margin: 0;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: var(--shadow-secondary);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-available);
    box-shadow: 0 0 0 4px var(--color-available-glow);
  }

  .big {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.5rem);
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
  }

  .big em {
    color: var(--color-accent);
    font-family: var(--font-serif);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: flex-start;
    justify-self: stretch;
  }

  /* Open, the calendar takes the whole row, and the email button moves beneath it. */
  .actions > :global(booking-panel:has(details[open])) {
    flex-basis: 100%;
  }

  /* Shaped like the booking button, in white, with an envelope that flies forward on hover. */
  .mail {
    min-height: 44px;
    border-radius: var(--radius-pill);
  }

  .fly {
    transition: translate var(--duration-base) var(--ease-standard);
  }

  .mail:hover .fly {
    translate: 3px 0;
  }

  .meta {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* The quiet line: the CV (it opens over the page) and the social links, as icon chips. */
  .details {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    align-items: center;
    margin-block-start: var(--space-6);
  }

  .socials {
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social {
    display: grid;
    place-items: center;
    width: var(--icon-button);
    height: var(--icon-button);
    border-radius: var(--radius-icon);
    background: var(--color-surface);
    box-shadow: var(--shadow-secondary);
    color: var(--color-text);
  }

  .social:hover {
    color: var(--color-accent);
  }

  @media (width < 40rem) {
    .invite {
      padding: 24px 22px;
    }

    /* On phones the two buttons stack, each the card's full width. */
    .actions > :global(*) {
      flex-basis: 100%;
    }
  }
</style>
