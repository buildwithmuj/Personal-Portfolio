---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../lib/paths.ts';
import Shell from '../Shell.astro';
import Stats from '../Stats.astro';
import VoiceIntro from '../VoiceIntro.astro';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
}

const { profile } = Astro.props;
---

<Shell id="about" labelledBy="about-heading">
  <div class="about">
    <h2 id="about-heading" class="label">
      About me
    </h2>
    <div class="body">
      <p class="statement">
        <span>{profile.about}</span>
      </p>
      <ul class="contact-row" role="list">
        {profile.voiceIntro && <VoiceIntro src={withBase(profile.voiceIntro)} />}
        <li>
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"></path>
          </svg>
          <a href={withBase('/cv.pdf')} download>
            Download CV
          </a>
        </li>
      </ul>
      <Stats stats={profile.stats} />
    </div>
  </div>
</Shell>

<style>
  /* Open layout: the label sits in a narrow left column, the statement and stats on the right. */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: var(--space-8) 64px;
  }

  .label {
    padding-block-start: 0.4em;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
  }

  .statement {
    max-width: 36rem;
    margin-block-end: var(--space-8);
    font-size: clamp(1.375rem, 1.05rem + 1vw, 2rem);
    font-weight: var(--weight-medium);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) 20px;
    align-items: center;
    margin-block-end: 64px;
    padding: 0;
    list-style: none;
  }

  .contact-row > :global(li) {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--text-sm);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
  }

  .contact-row svg {
    color: var(--color-accent);
  }

  .contact-row a {
    color: var(--color-text);
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .contact-row a:hover {
    text-decoration: underline;
  }

  /*
   * The statement fills from muted to full colour in reading order as it scrolls into view. The
   * gradient spans the whole inline text, so it runs line by line. Without scroll-driven animation
   * support, or with reduced motion, the text is simply full colour.
   */
  @keyframes fill {
    from {
      background-size:
        0% 100%,
        100% 100%;
    }

    to {
      background-size:
        100% 100%,
        100% 100%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .statement {
        view-timeline-name: --statement;
      }

      .statement span {
        background:
          linear-gradient(var(--color-text), var(--color-text)) 0 0 / 0% 100% no-repeat,
          linear-gradient(var(--color-text-muted), var(--color-text-muted));
        background-clip: text;
        color: transparent;
        animation: fill linear both;
        animation-timeline: --statement;
        animation-range: cover 15% contain 35%;
      }
    }
  }

  @media (width < 56rem) {
    .about {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }

  @media (width < 40rem) {
    .contact-row {
      margin-block-end: var(--space-8);
    }
  }
</style>
