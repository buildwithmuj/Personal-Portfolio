---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../lib/paths.ts';
import DayReminders from '../DayReminders.astro';
import Shell from '../Shell.astro';
import Stats from '../Stats.astro';
import VoiceIntro from '../VoiceIntro.astro';
import Icon from '../Icon.astro';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
}

const { profile } = Astro.props;
---

<Shell id="about" labelledBy="about-heading" inset>
  <div class="card about">
    <h2 id="about-heading" class="label">
      About me
    </h2>
    <p class="statement">{profile.about}</p>
    <ul class="contact-row" role="list">
      {profile.voiceIntro && <VoiceIntro src={withBase(profile.voiceIntro)} />}
      <li>
        <Icon name="cv" size={20} class="row-icon" />
        <a href={withBase('/cv.pdf')} data-cv>
          View CV
        </a>
      </li>
    </ul>
    <Stats stats={profile.stats} />
    {profile.day.length > 0 && (
      <div class="day">
        <DayReminders
          tasks={profile.day}
          place={profile.locationLabel}
          timeZone={profile.timeZone}
        />
      </div>
    )}
  </div>
</Shell>

<style>
  /* Measured from the reference's "About my self." card at 1440px. */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: var(--shell-pad-top) 40px 46px;
  }

  .label {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
  }

  .statement {
    max-width: 34rem;
    margin-block: 15px 31px;
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    letter-spacing: -0.011em;
    line-height: 26px;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) 20px;
    align-items: center;
    margin: 0 0 60px;
    padding: 0;
    list-style: none;
  }

  .contact-row > :global(li) {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--text-sm);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
  }

  .contact-row svg {
    color: var(--color-accent);
  }

  .contact-row a {
    color: var(--color-text);
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .contact-row a:hover {
    text-decoration: underline;
  }

  /* The typical day (DayReminders), under the stats. */
  .day {
    margin-block-start: var(--space-8);
  }

  @media (width < 40rem) {
    .about {
      padding: 40px 24px 36px;
    }

    .contact-row {
      margin-block-end: var(--space-8);
    }
  }
</style>
