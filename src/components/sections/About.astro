---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../lib/paths.ts';
import DayReminders from '../DayReminders.astro';
import Shell from '../Shell.astro';
import Stats from '../Stats.astro';
import VoiceIntro from '../VoiceIntro.astro';
import Icon from '../Icon.astro';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
}

const { profile } = Astro.props;
// The statement's greeting, up to the owner's job title, shows in full from the start; the rest
// reads itself in. If the title isn't in the statement, all of it reads itself in.
const titleEnd = profile.about.indexOf(profile.jobTitle);
const split = titleEnd < 0 ? 0 : titleEnd + profile.jobTitle.length;
const lead = profile.about.slice(0, split);
const rest = profile.about.slice(split);
---

<Shell id="about" labelledBy="about-heading" inset>
  <div class="card about">
    <h2 id="about-heading" class="label">
      About me
    </h2>
    <p class="statement">
      {lead && <span class="lead">{lead}</span>}
      <span class="rest">{rest}</span>
    </p>
    <ul class="contact-row" role="list">
      {profile.voiceIntro && <VoiceIntro src={withBase(profile.voiceIntro)} />}
      <li>
        <Icon name="document" size={20} class="row-icon" />
        <a href={withBase('/cv')}>View CV</a>
      </li>
    </ul>
    <Stats stats={profile.stats} />
    {profile.day.length > 0 && (
      <div class="day">
        <DayReminders
          tasks={profile.day}
          place={profile.locationLabel}
          timeZone={profile.timeZone}
        />
      </div>
    )}
  </div>
</Shell>

<style>
  /* Measured from the reference's "About my self." card at 1440px. */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: var(--shell-pad-top) 40px 46px;
  }

  .label {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
  }

  .statement {
    max-width: 34rem;
    margin-block: 15px 31px;
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    letter-spacing: -0.011em;
    line-height: 26px;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) 20px;
    align-items: center;
    margin: 0 0 60px;
    padding: 0;
    list-style: none;
  }

  .contact-row > :global(li) {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--text-sm);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
  }

  .contact-row svg {
    color: var(--color-accent);
  }

  .contact-row a {
    color: var(--color-text);
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .contact-row a:hover {
    text-decoration: underline;
  }

  /* The typical day (DayReminders), under the stats. */
  .day {
    margin-block-start: var(--space-8);
  }

  /*
   * The statement reads itself in: after the greeting, which is full colour from the start, it starts
   * a light grey and fills to full colour in reading order as it scrolls up the screen, from the
   * lower middle (just below where it sits on load, even on a tall screen) over a short stretch of
   * scrolling. The gradient spans the whole inline text, so it runs line by line. Without
   * scroll-driven animation support, or with reduced motion, the text is simply full colour.
   */
  @keyframes fill {
    from {
      background-size:
        0% 100%,
        100% 100%;
    }

    to {
      background-size:
        100% 100%,
        100% 100%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .statement {
        view-timeline-name: --statement;
      }

      .statement .rest {
        background:
          linear-gradient(var(--color-text), var(--color-text)) 0 0 / 0% 100% no-repeat,
          linear-gradient(var(--color-text-unread), var(--color-text-unread));
        background-clip: text;
        color: transparent;
        animation: fill linear both;
      }

      /* In a rule of its own, so the minifier can't fold it into the shorthand (see ScrollTop). */
      .about .statement .rest {
        animation-timeline: --statement;
        animation-range: cover 40% cover 58%;
      }
    }
  }

  /* With animations paused, which holds only loops (global.css), the statement still fills. */
  :global(.motion-paused) .statement .rest {
    animation-play-state: running !important;
  }

  @media (width < 40rem) {
    .about {
      padding: 40px 24px 36px;
    }

    .contact-row {
      margin-block-end: var(--space-8);
    }
  }
</style>
