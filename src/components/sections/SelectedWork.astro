---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../lib/paths.ts';
import Shell from '../Shell.astro';
import Switch from '../Switch.astro';
import WorkGrid from '../WorkGrid.astro';

interface Props {
  studies: CollectionEntry<'caseStudies'>[];
  heading: string;
  intro: string;
}

const { studies, heading, intro } = Astro.props;
---

<Shell id="work" heading={heading} intro={intro} join="bottom">
  <Switch
    slot="actions"
    name="work-filter"
    label="Show"
    options={[
      { value: 'client', label: 'Work' },
      { value: 'product', label: 'Personal projects' },
    ]}
  />
  <WorkGrid studies={studies} limit={4} />
  <p class="more">
    <a class="btn btn-secondary" href={withBase('/projects')}>
      View all
    </a>
  </p>
</Shell>

<style>
  .more {
    display: flex;
    justify-content: center;
    max-width: none;
    margin-block-start: 40px;
  }
</style>
