---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../lib/paths.ts';
import { socialLabels } from '../../lib/social.ts';
import ProofStrip from '../ProofStrip.astro';
import Shell from '../Shell.astro';
import AvailabilityPill from '../AvailabilityPill.astro';
import SkyGradient from '../SkyGradient.astro';
import SocialIcon from '../SocialIcon.astro';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
}

const { profile } = Astro.props;
// Screen readers get every role once, as a sentence; the visible line cycles through them.
const rolesSentence = new Intl.ListFormat('en-GB', { type: 'conjunction' }).format(profile.roles);
// The headline's closing words (profile.headlineAccent) are set in the editorial serif.
const headlineWords = profile.headline.split(/\s+/);
const accentWords = profile.headlineAccent?.split(/\s+/) ?? [];
const accentFrom =
  accentWords.length > 0 && profile.headline.endsWith(profile.headlineAccent ?? '')
    ? headlineWords.length - accentWords.length
    : headlineWords.length;
// On phones the pill shows a shorter line whose last word rotates (AvailabilityPill.astro).
const short = profile.availabilityShort;
// The workflow line-art in the sky band: five tangled lines run into the social links, as into an
// automation, and leave as clean parallel lines (a 1000 × 200 box, stretched to the band).
const flow = [
  'M0 150C80 150 110 30 200 45S320 160 400 92H600C650 92 660 60 710 60H1000',
  'M0 30C70 30 120 170 210 150S330 40 400 96H600C650 96 660 80 710 80H1000',
  'M0 185C90 185 100 80 190 110S300 20 400 100H1000',
  'M0 95C60 95 140 190 230 140S320 60 400 104H600C650 104 660 120 710 120H1000',
  'M0 10C100 10 90 120 180 90S340 180 400 108H600C650 108 660 140 710 140H1000',
];
---

<Shell id="top" labelledBy="hero-name" hero>
  <div class="card hero">
    <div class="identity">
      {profile.avatar && (
        <div class="avatar">
          <SkyGradient class="avatar-sky" />
          <img src={withBase(profile.avatar)} alt="" width="90" height="90" />
        </div>
      )}
      <div class="who">
        <h1 id="hero-name">{profile.name}</h1>
        {profile.availability && (
          <AvailabilityPill text={profile.availability} short={short} class="hero-pill" />
        )}
        <p class="roles">
          <span class="visually-hidden">{rolesSentence}</span>
          <role-rotator
            class="rotator"
            aria-hidden="true"
            data-roles={JSON.stringify(profile.roles)}
          >
            <span>{profile.roles[0]}</span>
          </role-rotator>
        </p>
      </div>
    </div>
    <p class="headline">
      {headlineWords.map((word, index) => (
        <>
          {index > 0 && ' '}
          <span class:list={['w', { accent: index >= accentFrom }]}>
            <span>{word}</span>
          </span>
        </>
      ))}
    </p>
    <p class="subline">{profile.subline}</p>
    <p class="actions">
      <a class="btn btn-primary" href="#work">
        See my work
      </a>
      <a class="btn btn-secondary" href="#contact">
        Book a call
      </a>
    </p>
    <ProofStrip label={profile.proof.label} items={profile.proof.items} />
    <SkyGradient class="cover" />
    <svg
      class="flow"
      viewBox="0 0 1000 200"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      {flow.map((d) => (
        <path d={d} pathLength="1" />
      ))}
      {flow.map((d) => (
        <path class="pulse" d={d} pathLength="1" />
      ))}
    </svg>
    <ul class="band-socials" role="list">
      {profile.socials.map((social) => (
        <li>
          <a
            class="band-icon"
            href={social.url}
            aria-label={`${profile.name} on ${socialLabels[social.platform]}`}
          >
            <SocialIcon platform={social.platform} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</Shell>

<script>
  // Cycles the visible role every few seconds by sliding it through the clipped line. Without
  // JavaScript, or with reduced motion, the first role stays put.
  class RoleRotator extends HTMLElement {
    connectedCallback(): void {
      const line = this.querySelector('span');
      const roles = JSON.parse(this.dataset['roles'] ?? '[]') as string[];
      if (!line || roles.length < 2) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      let index = 0;
      const timing = {
        duration: 250,
        easing: 'cubic-bezier(0.2, 0, 0, 1)',
        fill: 'forwards' as const,
      };
      window.setInterval(async () => {
        if (document.documentElement.classList.contains('motion-paused')) return;
        await line.animate([{ transform: 'none' }, { transform: 'translateY(-110%)' }], timing)
          .finished;
        index = (index + 1) % roles.length;
        line.textContent = roles[index] ?? '';
        line.animate([{ transform: 'translateY(110%)' }, { transform: 'none' }], timing);
      }, 2600);
    }
  }

  customElements.define('role-rotator', RoleRotator);
</script>

<style>
  .hero {
    --cover: 128px;

    position: relative;
    display: grid;
    gap: var(--space-6);
    padding: var(--hero-card-pad);
    overflow: hidden;
    isolation: isolate;
  }

  .hero::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: radial-gradient(60% 70% at 85% 10%, var(--color-accent-glow), transparent 70%);
    content: '';
  }

  /* A living Blue sky cover band (SkyGradient); the avatar overlaps its lower edge like a profile photo. */
  .cover {
    position: absolute;
    z-index: -1;
    inset: 0 0 auto;
    height: var(--cover);
  }

  /*
   * The workflow line-art over the sky: white hairlines draw themselves in once, then a light runs
   * along each now and then, from the tangle through the social links and out along the clean side.
   */
  .flow {
    position: absolute;
    z-index: -1;
    inset: 0 0 auto;
    width: 100%;
    height: var(--cover);
    fill: none;
    stroke: var(--color-flow);
    stroke-linecap: round;
    stroke-width: 1.2;
    pointer-events: none;
  }

  .flow path {
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    animation: flow-draw 2s var(--ease-out) 300ms both;
  }

  .flow .pulse {
    stroke: var(--color-flow-pulse);
    stroke-width: 2;
    stroke-dasharray: 0.06 1.2;
    stroke-dashoffset: 0.06;
    animation: flow-pulse 4.5s linear 2.4s infinite;
  }

  .flow .pulse:nth-of-type(7) {
    animation-delay: 3.8s;
  }

  .flow .pulse:nth-of-type(8) {
    animation-delay: 5s;
  }

  .flow .pulse:nth-of-type(9) {
    animation-delay: 3.2s;
  }

  .flow .pulse:nth-of-type(10) {
    animation-delay: 5.7s;
  }

  @keyframes flow-draw {
    from {
      stroke-dashoffset: 1;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes flow-pulse {
    to {
      stroke-dashoffset: -1;
    }
  }

  /* The drawing-in is a one-off entrance, so it finishes even with animations paused. */
  :global(.motion-paused) .flow path:not(.pulse) {
    animation-play-state: running !important;
  }

  /* The social links, centred in the sky band. */
  .band-socials {
    position: absolute;
    inset: calc(var(--cover) / 2) 0 auto;
    display: flex;
    gap: var(--space-2);
    justify-content: center;
    margin: 0;
    padding: 0;
    translate: 0 -50%;
    list-style: none;
  }

  .band-icon {
    display: grid;
    place-items: center;
    width: var(--icon-button);
    height: var(--icon-button);
    border-radius: var(--radius-icon);
    background: var(--color-surface);
    box-shadow: var(--shadow-secondary);
    color: var(--color-text);
  }

  .band-icon:hover {
    color: var(--color-accent);
  }

  /*
   * The availability pill (AvailabilityPill.astro) sits level with the name at the card's right
   * edge; on phones, where the row is too narrow, at the band's top right.
   */

  /* The avatar overlaps the band by about a third, so the name sits clear of the band's edge. */
  .identity {
    position: relative;
    display: flex;
    gap: var(--space-4);
    align-items: flex-end;
    margin-block-start: calc(
      var(--cover) - var(--avatar) / 2 - var(--hero-card-pad) + var(--space-4)
    );
  }

  /* The name and the availability pill share the first row; the role line runs below both. */
  .who {
    display: grid;
    flex: 1;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0 var(--space-4);
    align-items: center;
    min-width: 0;
  }

  /* The photo is cut out of its backdrop, so a small live sky (SkyGradient) shows behind it. */
  .avatar {
    position: relative;
    flex: none;
    width: var(--avatar);
    height: var(--avatar);
    overflow: hidden;
    border-radius: 50%;
    box-shadow: 0 0 0 4px var(--color-surface);
    isolation: isolate;
  }

  .avatar-sky {
    position: absolute;
    inset: 0;
  }

  .avatar img {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1 {
    font-size: var(--text-xl);
  }

  .roles {
    grid-column: 1 / -1;
    height: 1.5em;
    overflow: hidden;
    color: var(--color-text-muted);
  }

  .rotator {
    display: block;
  }

  .rotator > span {
    display: block;
  }

  /* On load, the card's pieces rise in turn and the headline's words slide up (transform only). */
  @keyframes hero-in {
    from {
      transform: translateY(24px);
    }
  }

  @keyframes word-up {
    from {
      transform: translateY(110%);
    }
  }

  .hero > * {
    animation: hero-in 900ms var(--ease-out) both;
  }

  .hero > :nth-child(2) {
    animation-delay: 80ms;
  }

  .hero > :nth-child(3) {
    animation-delay: 160ms;
  }

  .hero > :nth-child(4) {
    animation-delay: 240ms;
  }

  .hero > :nth-child(5) {
    animation-delay: 320ms;
  }

  .hero > :nth-child(6) {
    animation-delay: 400ms;
  }

  /* The sky band and its line-art are there from the first frame; only the content rises in. */
  .hero > :is(.cover, .flow) {
    animation: none;
  }

  .headline .w > span {
    animation: word-up 900ms var(--ease-out) both;
    animation-delay: calc(200ms + var(--i, 0) * 45ms);
  }

  /* One-off entrances finish even with animations paused, which holds only loops (global.css). */
  :global(.motion-paused) .hero > *,
  :global(.motion-paused) .headline .w > span {
    animation-play-state: running !important;
  }

  .headline {
    max-width: 34rem;
    font-size: var(--text-hero);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  /* The headline's closing words in an editorial italic serif. */
  .headline .w.accent > span {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: var(--weight-regular);
    letter-spacing: 0;
  }

  .subline {
    max-width: 34rem;
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (width < 40rem) {
    /* A taller band: the pill gets a row of its own, the social links sit a little lower. */
    .hero {
      --cover: 136px;
    }

    .band-socials {
      inset-block-start: calc(var(--cover) * 0.56);
    }

    /* Phones keep the hero calm: the sky, without the workflow line-art and its pulses. */
    .flow {
      display: none;
    }

    /* As in the reference, the pill sits 12px in from the card's top right (from the identity row). */
    .hero-pill {
      position: absolute;
      inset-block-start: calc(var(--avatar) / 2 - var(--cover) - var(--space-1));
      inset-inline-end: calc(var(--space-3) - var(--hero-card-pad));
    }

    /* With the pill out of the row, the name and role line take its full width. */
    .who {
      grid-template-columns: minmax(0, 1fr);
    }

    .actions {
      flex-direction: column;
    }

    .actions .btn {
      width: 100%;
      min-height: 44px;
    }
  }
</style>
