---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../lib/paths.ts';
import ProofStrip from '../ProofStrip.astro';
import Shell from '../Shell.astro';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
}

const { profile } = Astro.props;
// Screen readers get every role once, as a sentence; the visible line cycles through them.
const rolesSentence = new Intl.ListFormat('en-GB', { type: 'conjunction' }).format(profile.roles);
---

<Shell id="top" labelledBy="hero-name" hero>
  <div class="card hero">
    <div class="identity">
      {profile.avatar && (
        <img class="avatar" src={withBase(profile.avatar)} alt="" width="90" height="90" />
      )}
      <div>
        <h1 id="hero-name">{profile.name}</h1>
        <p class="roles">
          <span class="visually-hidden">{rolesSentence}</span>
          <role-rotator
            class="rotator"
            aria-hidden="true"
            data-roles={JSON.stringify(profile.roles)}
          >
            <span>{profile.roles[0]}</span>
          </role-rotator>
        </p>
      </div>
    </div>
    <p class="headline">
      {profile.headline.split(/\s+/).map((word, index) => (
        <>
          {index > 0 && ' '}
          <span class="w">
            <span>{word}</span>
          </span>
        </>
      ))}
    </p>
    <p class="subline">{profile.subline}</p>
    <p class="actions">
      <a class="btn btn-primary" href="#work">
        See my work
      </a>
      <a class="btn btn-secondary" href="#contact">
        Book a call
      </a>
    </p>
    <ProofStrip label={profile.proof.label} items={profile.proof.items} />
  </div>
</Shell>

<script>
  // Cycles the visible role every few seconds by sliding it through the clipped line. Without
  // JavaScript, or with reduced motion, the first role stays put.
  class RoleRotator extends HTMLElement {
    connectedCallback(): void {
      const line = this.querySelector('span');
      const roles = JSON.parse(this.dataset['roles'] ?? '[]') as string[];
      if (!line || roles.length < 2) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      let index = 0;
      const timing = {
        duration: 250,
        easing: 'cubic-bezier(0.2, 0, 0, 1)',
        fill: 'forwards' as const,
      };
      window.setInterval(async () => {
        await line.animate([{ transform: 'none' }, { transform: 'translateY(-110%)' }], timing)
          .finished;
        index = (index + 1) % roles.length;
        line.textContent = roles[index] ?? '';
        line.animate([{ transform: 'translateY(110%)' }, { transform: 'none' }], timing);
      }, 2600);
    }
  }

  customElements.define('role-rotator', RoleRotator);
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    gap: var(--space-6);
    padding: var(--hero-card-pad);
    overflow: hidden;
    isolation: isolate;
  }

  .hero::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: radial-gradient(60% 70% at 85% 10%, var(--color-accent-glow), transparent 70%);
    content: '';
  }

  .identity {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    margin-block-start: var(--space-4);
  }

  .avatar {
    width: var(--avatar);
    height: var(--avatar);
    border-radius: 50%;
    object-fit: cover;
  }

  h1 {
    font-size: var(--text-xl);
  }

  .roles {
    height: 1.5em;
    overflow: hidden;
    color: var(--color-text-muted);
  }

  .rotator {
    display: block;
  }

  .rotator > span {
    display: block;
  }

  /* On load, the card's pieces rise in turn and the headline's words slide up (transform only). */
  @keyframes hero-in {
    from {
      transform: translateY(24px);
    }
  }

  @keyframes word-up {
    from {
      transform: translateY(110%);
    }
  }

  .hero > * {
    animation: hero-in 900ms var(--ease-out) both;
  }

  .hero > :nth-child(2) {
    animation-delay: 80ms;
  }

  .hero > :nth-child(3) {
    animation-delay: 160ms;
  }

  .hero > :nth-child(4) {
    animation-delay: 240ms;
  }

  .hero > :nth-child(5) {
    animation-delay: 320ms;
  }

  .hero > :nth-child(6) {
    animation-delay: 400ms;
  }

  .headline .w > span {
    animation: word-up 900ms var(--ease-out) both;
    animation-delay: calc(200ms + var(--i, 0) * 45ms);
  }

  .headline {
    max-width: 34rem;
    font-size: var(--text-hero);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .subline {
    max-width: 34rem;
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (width < 40rem) {
    .identity {
      margin-block-start: var(--space-8);
    }

    .actions {
      flex-direction: column;
    }

    .actions .btn {
      width: 100%;
      min-height: 44px;
    }
  }
</style>
