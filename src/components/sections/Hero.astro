---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../lib/paths.ts';
import ProofStrip from '../ProofStrip.astro';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
}

const { profile } = Astro.props;
// Screen readers get every role once, as a sentence; the visible line cycles through them.
const rolesSentence = new Intl.ListFormat('en-GB', { type: 'conjunction' }).format(profile.roles);
---

<section id="top" class="hero-band" aria-labelledby="hero-name">
  <div class="container hero">
    <div class="copy">
      <div class="who">
        <h1 id="hero-name">{profile.name}</h1>
        <p class="roles">
          <span class="visually-hidden">{rolesSentence}</span>
          <role-rotator
            class="rotator"
            aria-hidden="true"
            data-roles={JSON.stringify(profile.roles)}
          >
            <span>{profile.roles[0]}</span>
          </role-rotator>
        </p>
      </div>
      <p class="headline">
        {profile.headline.split(/\s+/).map((word, index) => (
          <>
            {index > 0 && ' '}
            <span class="w">
              <span>{word}</span>
            </span>
          </>
        ))}
      </p>
      <p class="subline">{profile.subline}</p>
      <p class="actions">
        <a class="btn btn-primary" href="#work">
          See my work
        </a>
        <a class="btn btn-secondary" href="#contact">
          Book a call
        </a>
      </p>
    </div>
    {profile.avatar && (
      <figure class="portrait">
        <img
          src={withBase(profile.avatar)}
          alt={`Portrait of ${profile.name}`}
          width="640"
          height="800"
          fetchpriority="high"
        />
        {profile.availability && (
          <figcaption class="badge">
            <span class="dot" aria-hidden="true"></span>
            {profile.availability}
          </figcaption>
        )}
      </figure>
    )}
  </div>
  <div class="container proof-row">
    <ProofStrip label={profile.proof.label} items={profile.proof.items} />
  </div>
</section>

<script>
  // Cycles the visible role every few seconds by sliding it through the clipped line. Without
  // JavaScript, or with reduced motion, the first role stays put.
  class RoleRotator extends HTMLElement {
    connectedCallback(): void {
      const line = this.querySelector('span');
      const roles = JSON.parse(this.dataset['roles'] ?? '[]') as string[];
      if (!line || roles.length < 2) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      let index = 0;
      const timing = {
        duration: 250,
        easing: 'cubic-bezier(0.2, 0, 0, 1)',
        fill: 'forwards' as const,
      };
      window.setInterval(async () => {
        await line.animate([{ transform: 'none' }, { transform: 'translateY(-110%)' }], timing)
          .finished;
        index = (index + 1) % roles.length;
        line.textContent = roles[index] ?? '';
        line.animate([{ transform: 'translateY(110%)' }, { transform: 'none' }], timing);
      }, 2600);
    }
  }

  customElements.define('role-rotator', RoleRotator);
</script>

<style>
  /*
   * Split hero: a large headline on the left, a tall portrait on the right. The page's one bold
   * moment; everything below stays quiet.
   */
  .hero-band {
    padding-block: 72px 0;

    /* The portrait's glow may reach past the page edge on narrow screens; never scroll sideways. */
    overflow-x: clip;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr);
    gap: 64px;
    align-items: center;
  }

  .copy {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }

  h1 {
    font-size: var(--text-lg);
  }

  .roles {
    height: 1.5em;
    overflow: hidden;
    color: var(--color-text-muted);
  }

  .rotator,
  .rotator > span {
    display: block;
  }

  .headline {
    max-width: 18ch;
    font-size: var(--text-display);
    font-weight: var(--weight-medium);
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .subline {
    max-width: 34rem;
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-2);
  }

  .portrait {
    position: relative;
    isolation: isolate;
    animation: portrait-in 1100ms var(--ease-out) 150ms both;
  }

  /* A soft indigo glow behind the portrait. */
  .portrait::before {
    position: absolute;
    z-index: -1;
    inset: -12% -16% -8%;
    background: radial-gradient(closest-side, var(--color-accent-glow), transparent);
    content: '';
  }

  .portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    border-radius: 28px;
    object-fit: cover;
  }

  .badge {
    position: absolute;
    inset-block-end: var(--space-6);
    inset-inline-start: -28px;
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    padding: 8px 16px 8px 14px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    box-shadow: 0 12px 32px -12px var(--color-grid-line);
    color: var(--color-status-text);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentcolor;
  }

  .proof-row {
    margin-block-start: 72px;
    padding-block: var(--space-8) 0;
    border-block-start: 1px solid var(--color-hairline);
  }

  /* On load, the copy rises in piece by piece and the headline's words slide up (transform only). */
  @keyframes hero-in {
    from {
      transform: translateY(24px);
    }
  }

  @keyframes word-up {
    from {
      transform: translateY(110%);
    }
  }

  @keyframes portrait-in {
    from {
      transform: translateY(32px) scale(0.96);
    }
  }

  .copy > * {
    animation: hero-in 900ms var(--ease-out) both;
  }

  .copy > :nth-child(2) {
    animation-delay: 80ms;
  }

  .copy > :nth-child(3) {
    animation-delay: 200ms;
  }

  .copy > :nth-child(4) {
    animation-delay: 280ms;
  }

  .headline .w > span {
    animation: word-up 900ms var(--ease-out) both;
    animation-delay: calc(120ms + var(--i, 0) * 45ms);
  }

  @media (width < 56rem) {
    .hero-band {
      padding-block-start: 40px;
    }

    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .portrait {
      order: -1;
      max-width: 420px;
    }

    .portrait img {
      aspect-ratio: 1;
    }

    .badge {
      inset-inline-start: var(--space-4);
      inset-block-end: var(--space-4);
    }

    .proof-row {
      margin-block-start: 48px;
    }
  }

  @media (width < 40rem) {
    .actions {
      flex-direction: column;
      width: 100%;
    }

    .actions .btn {
      width: 100%;
      min-height: 44px;
    }
  }
</style>
