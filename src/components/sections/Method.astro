---
import type { CollectionEntry } from 'astro:content';
import Shell from '../Shell.astro';
import Switch from '../Switch.astro';

interface Props {
  steps: CollectionEntry<'method'>['data'][];
  heading: string;
  intro: string;
}

const { steps, heading, intro } = Astro.props;
const tracks = (['process', 'product'] as const).map((track) => ({
  track,
  steps: steps.filter((step) => step.track === track),
}));
---

<Shell id="method" heading={heading} intro={intro}>
  <Switch
    slot="actions"
    name="method-track"
    label="Show"
    options={[
      { value: 'process', label: 'Processes' },
      { value: 'product', label: 'Products' },
    ]}
  />
  {tracks.map((group) => (
    <ol class="steps" role="list" data-track={group.track}>
      {group.steps.map((step, index) => (
        <li class="card step" data-reveal="rise">
          <span class="number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  ))}
</Shell>

<style>
  /* Measured from the reference's "Services I provide" cards. */
  .steps {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .steps > li {
    grid-column: span 2;
  }

  .steps > li:nth-child(n + 4) {
    grid-column: span 3;
  }

  /* The Process optimisation | Building products switch picks which track shows. */
  :global(section:has(input[name='method-track'][value='product']:checked))
    .steps[data-track='process'],
  :global(section:has(input[name='method-track'][value='process']:checked))
    .steps[data-track='product'] {
    display: none;
  }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    justify-content: space-between;
    min-height: 240px;
    overflow: hidden;
    isolation: isolate;
  }

  /*
   * A slowly drifting indigo glow in the top half of each card. It fades out before the title and
   * description, so the text always sits on the plain card. Only transform animates (composited).
   */
  .step::before {
    position: absolute;
    z-index: -1;
    inset: -40% -20% 30%;
    background:
      radial-gradient(45% 60% at 78% 38%, var(--color-blob-1), transparent 70%),
      radial-gradient(40% 55% at 52% 22%, var(--color-blob-2), transparent 70%),
      radial-gradient(40% 50% at 95% 70%, var(--color-blob-3), transparent 70%);
    content: '';
    mask-image: linear-gradient(to bottom, var(--color-text) 50%, transparent 85%);
    animation: drift 14s ease-in-out infinite alternate;
  }

  .step:nth-child(2)::before {
    animation-direction: alternate-reverse;
    animation-delay: -4s;
  }

  .step:nth-child(3)::before {
    animation-delay: -8s;
  }

  .step:nth-child(4)::before {
    animation-direction: alternate-reverse;
    animation-delay: -11s;
  }

  .step:nth-child(5)::before {
    animation-delay: -2s;
  }

  @keyframes drift {
    from {
      transform: translate3d(-6%, -4%, 0) rotate(0deg) scale(1);
    }

    to {
      transform: translate3d(6%, 5%, 0) rotate(14deg) scale(1.15);
    }
  }

  .number {
    color: var(--color-accent);
    font-size: var(--text-2xl);
    letter-spacing: -0.01em;
    line-height: var(--leading-tight);
  }

  h3 {
    margin-block-end: var(--space-4);
    font-size: var(--text-xl);
    font-weight: var(--weight-regular);
    line-height: var(--leading-snug);
  }

  p {
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .step::before {
      animation: none;
    }
  }

  @media (width < 56rem) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }

    .steps > li,
    .steps > li:nth-child(n + 4) {
      grid-column: auto;
    }

    .steps > li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (width < 40rem) {
    .steps {
      grid-template-columns: 1fr;
    }

    .step {
      min-height: 200px;
    }
  }
</style>
