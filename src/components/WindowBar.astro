---
/**
 * A Windows window's title bar: minimise, maximise and close at its right. Minimise and close work.
 * In the Toolkit each shows another group (`to`, Skills.astro's script), so closing one window
 * brings up the next, and there's no title, since the tab already names what's inside. In What
 * people say they put the window away by collapsing the section (Testimonials.astro's script), and
 * a quiet title sits at the left. Maximise is only the look, so it's hidden from assistive
 * technology and doesn't react to the pointer. Without JavaScript the buttons stay disabled.
 */
interface Props {
  title?: string;
  minimise: { to?: string; label: string };
  close: { to?: string; label: string };
}

const { title, minimise, close } = Astro.props;
---

<div class="window-bar">
  {title && <span class="name">{title}</span>}
  <button type="button" data-show={minimise.to} aria-label={minimise.label} disabled>
    <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
      <path d="M0 5h10" stroke="currentColor"></path>
    </svg>
  </button>
  <span aria-hidden="true">
    <svg width="10" height="10" viewBox="0 0 10 10">
      <rect x="0.5" y="0.5" width="9" height="9" rx="1.5" fill="none" stroke="currentColor"></rect>
    </svg>
  </span>
  <button class="close" type="button" data-show={close.to} aria-label={close.label} disabled>
    <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
      <path d="M0 0l10 10M10 0L0 10" stroke="currentColor"></path>
    </svg>
  </button>
</div>

<style>
  .window-bar {
    display: flex;
    justify-content: flex-end;
    border-block-end: 1px solid var(--color-shell);
  }

  .window-bar > * {
    display: grid;
    place-items: center;
    width: 46px;
    height: 32px;
    color: var(--color-text);
  }

  .window-bar > .name {
    width: auto;
    margin-inline-end: auto;
    padding-inline-start: 14px;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
    transition:
      background-color 150ms var(--ease-standard),
      color 150ms var(--ease-standard);
  }

  button:disabled {
    cursor: default;
  }

  /* Inside the button, where the Toolkit card's rounded, clipped corner can't cut it off. */
  button:focus-visible {
    outline-offset: -3px;
  }

  /* As on Windows: a faint grey under the pointer, and close in red. */
  button:not(:disabled):hover {
    background: var(--win-hover);
  }

  .close:not(:disabled):hover {
    background: var(--win-close);
    color: var(--color-on-accent);
  }
</style>
