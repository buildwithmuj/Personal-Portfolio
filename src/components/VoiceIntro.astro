---
/**
 * "Play my intro" for the About row. The audio downloads only when the visitor presses play. The item
 * stays hidden without JavaScript, like the copy-email button.
 */
interface Props {
  src: string;
}

const { src } = Astro.props;
---

<li class="voice" hidden>
  <voice-intro data-src={src}>
    <button type="button">
      <svg
        class="play"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M10 8.8v6.4l5.2-3.2z" fill="currentColor"></path>
      </svg>
      <svg
        class="pause"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M10 9v6M14 9v6"></path>
      </svg>
      <span data-label>Play my intro</span>
    </button>
  </voice-intro>
</li>

<script>
  class VoiceIntro extends HTMLElement {
    connectedCallback(): void {
      const button = this.querySelector('button');
      const label = this.querySelector('[data-label]');
      const src = this.dataset['src'];
      if (!button || !label || !src) return;
      let audio: HTMLAudioElement | undefined;
      const show = (playing: boolean) => {
        this.toggleAttribute('data-playing', playing);
        label.textContent = playing ? 'Pause intro' : 'Play my intro';
      };
      button.addEventListener('click', () => {
        if (!audio) {
          audio = new Audio(src);
          audio.addEventListener('play', () => show(true));
          audio.addEventListener('pause', () => show(false));
          audio.addEventListener('ended', () => show(false));
        }
        if (audio.paused) void audio.play();
        else audio.pause();
      });
      this.closest('li')?.removeAttribute('hidden');
    }
  }

  customElements.define('voice-intro', VoiceIntro);
</script>

<style>
  button {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
  }

  svg {
    color: var(--color-accent);
  }

  button:hover span {
    text-decoration: underline;
  }

  .pause,
  voice-intro[data-playing] .play {
    display: none;
  }

  voice-intro[data-playing] .pause {
    display: block;
  }
</style>
