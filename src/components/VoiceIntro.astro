---
import Icon from './Icon.astro';
/**
 * A play button for the owner's voice: "Play my intro" in the About row (a list item), and "Hear my
 * answer" under each recorded answer in Ask me (a paragraph). The audio downloads only when
 * the visitor presses play, and one recording plays at a time. It stays hidden without JavaScript.
 */
interface Props {
  src: string;
  as?: 'li' | 'p';
  play?: string;
  pause?: string;
}

const { src, as: Tag = 'li', play = 'Play my intro', pause = 'Pause intro' } = Astro.props;
---

<Tag class="voice" hidden>
  <voice-intro data-src={src} data-play={play} data-pause={pause}>
    <button type="button">
      <Icon name="play-circle" size={20} class="play" />
      <Icon name="pause-circle" size={20} class="pause" />
      <span data-label>{play}</span>
      <span class="bars" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
  </voice-intro>
</Tag>

<script>
  // While the intro plays, the label becomes a row of bars that move with the voice: an analyser
  // reads the audio's loudness per frequency band each frame. Under reduced motion, or without
  // Web Audio, the label simply reads its pause label ("Pause intro"). Starting one recording
  // pauses any other.
  let current: HTMLAudioElement | undefined;

  class VoiceIntro extends HTMLElement {
    connectedCallback(): void {
      const button = this.querySelector('button');
      const label = this.querySelector<HTMLElement>('[data-label]');
      const bars = [...this.querySelectorAll<HTMLElement>('.bars > span')];
      const src = this.dataset['src'];
      if (!button || !label || !src) return;
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let audio: HTMLAudioElement | undefined;
      let analyser: AnalyserNode | undefined;
      let levels: Uint8Array<ArrayBuffer> | undefined;
      let frame = 0;

      const draw = () => {
        if (!analyser || !levels) return;
        analyser.getByteFrequencyData(levels);
        bars.forEach((bar, index) => {
          const level = (levels?.[index + 1] ?? 0) / 255;
          bar.style.transform = `scaleY(${0.15 + level * 0.85})`;
        });
        frame = requestAnimationFrame(draw);
      };

      const listen = (element: HTMLAudioElement) => {
        if (still || !('AudioContext' in window)) return;
        const context = new AudioContext();
        analyser = context.createAnalyser();
        analyser.fftSize = 64;
        analyser.smoothingTimeConstant = 0.7;
        context.createMediaElementSource(element).connect(analyser);
        analyser.connect(context.destination);
        levels = new Uint8Array(analyser.frequencyBinCount);
        element.addEventListener('play', () => void context.resume());
      };

      const show = (playing: boolean) => {
        const animate = playing && Boolean(analyser);
        this.toggleAttribute('data-playing', playing);
        this.toggleAttribute('data-bars', animate);
        label.textContent = (playing ? this.dataset['pause'] : this.dataset['play']) ?? '';
        label.classList.toggle('visually-hidden', animate);
        cancelAnimationFrame(frame);
        if (animate) draw();
      };

      button.addEventListener('click', () => {
        if (!audio) {
          audio = new Audio(src);
          listen(audio);
          audio.addEventListener('play', () => {
            if (current !== audio) current?.pause();
            current = audio;
            show(true);
          });
          audio.addEventListener('pause', () => show(false));
          audio.addEventListener('ended', () => show(false));
        }
        // A file that fails to load or decode says so, instead of failing silently. A pause straight
        // after play only cancels the play request (an AbortError), which is no failure.
        if (audio.paused) {
          audio.play().catch((error: Error) => {
            if (error.name === 'AbortError') return;
            show(false);
            label.textContent = 'Audio unavailable';
          });
        } else audio.pause();
      });
      this.parentElement?.removeAttribute('hidden');
    }
  }

  customElements.define('voice-intro', VoiceIntro);
</script>

<style>
  /*
   * A custom element is inline by default, which would wrap the button in a line of text, taller
   * than the button, and lift it a couple of pixels above View CV beside it.
   */
  voice-intro {
    display: flex;
  }

  button {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
  }

  svg {
    color: var(--color-accent);
  }

  button:hover [data-label] {
    text-decoration: underline;
  }

  .pause,
  voice-intro[data-playing] .play {
    display: none;
  }

  voice-intro[data-playing] .pause {
    display: block;
  }

  /* The sound bars replace the label while the intro plays. */
  .bars {
    display: none;
    gap: 3px;
    align-items: center;
    height: 18px;
  }

  voice-intro[data-bars] .bars {
    display: inline-flex;
  }

  .bars > span {
    width: 3px;
    height: 100%;
    border-radius: 2px;
    background: var(--color-accent);
    transform: scaleY(0.15);
    transition: transform 80ms linear;
  }
</style>
