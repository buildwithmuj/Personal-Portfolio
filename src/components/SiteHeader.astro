---
interface Props {
  name: string;
}

const { name } = Astro.props;
const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container inner">
    <a class="home" href="/">
      {name}
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-6);
  }

  .home {
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }
</style>
