---
import Shell from '../components/Shell.astro';
import Switch from '../components/Switch.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Base from '../layouts/Base.astro';
import { getCaseStudies, getProfile } from '../lib/content.ts';

const studies = await getCaseStudies();
const profile = await getProfile();
---

<Base title="All work" description={`Every case study and personal project by ${profile.name}.`}>
  <Shell
    id="all-work"
    heading="All work"
    headingLevel={1}
    intro={profile.sections.work.intro}
    reveal={false}
  >
    <Switch
      slot="actions"
      name="work-filter"
      label="Show"
      options={[
        { value: 'client', label: 'Work' },
        { value: 'product', label: 'Personal projects' },
      ]}
    />
    <WorkGrid studies={studies} headingLevel={2} />
  </Shell>
</Base>
