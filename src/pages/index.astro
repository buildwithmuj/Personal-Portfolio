---
import About from '../components/sections/About.astro';
import Hero from '../components/sections/Hero.astro';
import Method from '../components/sections/Method.astro';
import SelectedWork from '../components/sections/SelectedWork.astro';
import Base from '../layouts/Base.astro';
import { featuredStudies } from '../lib/case-studies.ts';
import { getCaseStudies, getMethod, getProfile } from '../lib/content.ts';
import { personJsonLd } from '../lib/structured-data.ts';

const profile = await getProfile();
if (!Astro.site) throw new Error('`site` must be set in astro.config.ts');
const structuredData = personJsonLd({
  name: profile.name,
  jobTitle: profile.jobTitle,
  worksFor: profile.worksFor,
  url: Astro.site.href,
  email: profile.email,
  sameAs: profile.socials.map((social) => social.url),
});
const featured = featuredStudies(await getCaseStudies());
const method = await getMethod();
---

<Base structuredData={structuredData}>
  <Hero profile={profile} />
  <About profile={profile} />
  {featured.length > 0 && (
    <SelectedWork
      studies={featured}
      heading={profile.sections.work.heading}
      intro={profile.sections.work.intro}
    />
  )}
  <Method
    steps={method}
    heading={profile.sections.method.heading}
    intro={profile.sections.method.intro}
  />
</Base>
