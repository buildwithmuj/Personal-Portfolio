---
import About from '../components/sections/About.astro';
import Contact from '../components/sections/Contact.astro';
import Hero from '../components/sections/Hero.astro';
import Interview from '../components/sections/Interview.astro';
import SelectedWork from '../components/sections/SelectedWork.astro';
import Skills from '../components/sections/Skills.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import CvViewer from '../components/CvViewer.astro';
import Base from '../layouts/Base.astro';
import { featuredStudies } from '../lib/case-studies.ts';
import {
  getCaseStudies,
  getProfile,
  getSkills,
  getTestimonials,
  visibleInterview,
} from '../lib/content.ts';
import { withBase } from '../lib/paths.ts';
import { personJsonLd } from '../lib/structured-data.ts';

const profile = await getProfile();
if (!Astro.site) throw new Error('`site` must be set in astro.config.ts');
const structuredData = personJsonLd({
  name: profile.name,
  jobTitle: profile.jobTitle,
  worksFor: profile.worksFor,
  url: new URL(withBase('/'), Astro.site).href,
  email: profile.email,
  sameAs: profile.socials.map((social) => social.url),
});
const featured = featuredStudies(await getCaseStudies());
const skills = await getSkills();
const testimonials = await getTestimonials();
const interview = visibleInterview(profile);
const interviewCopy = profile.sections.interview;
---

<Base structuredData={structuredData}>
  <Hero profile={profile} />
  <About profile={profile} />
  {featured.length > 0 && (
    <SelectedWork
      studies={featured}
      heading={profile.sections.work.heading}
      intro={profile.sections.work.intro}
    />
  )}
  <Skills
    skills={skills}
    heading={profile.sections.skills.heading}
    intro={profile.sections.skills.intro}
  />
  {interview && interviewCopy && (
    <Interview
      heading={interviewCopy.heading}
      intro={interviewCopy.intro}
      questions={interview.questions}
      name={profile.name}
      email={profile.email}
    />
  )}
  {testimonials.length > 0 && (
    <Testimonials
      testimonials={testimonials}
      heading={profile.sections.testimonials.heading}
      intro={profile.sections.testimonials.intro}
      owner={{ name: profile.name, avatar: profile.avatar }}
    />
  )}
  <Contact profile={profile} />
  <CvViewer />
</Base>
