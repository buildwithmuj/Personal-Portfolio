---
import About from '../components/sections/About.astro';
import ExperienceSkills from '../components/sections/ExperienceSkills.astro';
import Hero from '../components/sections/Hero.astro';
import Method from '../components/sections/Method.astro';
import SelectedWork from '../components/sections/SelectedWork.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Base from '../layouts/Base.astro';
import { featuredStudies } from '../lib/case-studies.ts';
import {
  getCaseStudies,
  getExperience,
  getMethod,
  getProfile,
  getSkills,
  getTestimonials,
} from '../lib/content.ts';
import { personJsonLd } from '../lib/structured-data.ts';

const profile = await getProfile();
if (!Astro.site) throw new Error('`site` must be set in astro.config.ts');
const structuredData = personJsonLd({
  name: profile.name,
  jobTitle: profile.jobTitle,
  worksFor: profile.worksFor,
  url: Astro.site.href,
  email: profile.email,
  sameAs: profile.socials.map((social) => social.url),
});
const featured = featuredStudies(await getCaseStudies());
const method = await getMethod();
const testimonials = await getTestimonials();
const roles = await getExperience();
const skills = await getSkills();
---

<Base structuredData={structuredData}>
  <Hero profile={profile} />
  <About profile={profile} />
  {featured.length > 0 && (
    <SelectedWork
      studies={featured}
      heading={profile.sections.work.heading}
      intro={profile.sections.work.intro}
    />
  )}
  <Method
    steps={method}
    heading={profile.sections.method.heading}
    intro={profile.sections.method.intro}
  />
  {testimonials.length > 0 && (
    <Testimonials
      testimonials={testimonials}
      heading={profile.sections.testimonials.heading}
      intro={profile.sections.testimonials.intro}
    />
  )}
  <ExperienceSkills
    roles={roles}
    skills={skills}
    years={profile.stats[0]?.value ?? ''}
    heading={profile.sections.experience.heading}
    intro={profile.sections.experience.intro}
  />
</Base>
