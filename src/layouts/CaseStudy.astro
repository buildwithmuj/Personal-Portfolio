---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BackLink from '../components/BackLink.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Shell from '../components/Shell.astro';
import TagList from '../components/TagList.astro';
import { caseStudyLabel } from '../lib/case-studies.ts';
import { withBase } from '../lib/paths.ts';
import Base from './Base.astro';

interface Props {
  study: CollectionEntry<'caseStudies'>;
  /** The study after this one, for the "Next case study" card (none when it would be itself). */
  next?: CollectionEntry<'caseStudies'> | undefined;
  ogImageUrl: string;
  structuredData: string;
}

const { study, next, ogImageUrl, structuredData } = Astro.props;
const { title, summary, role, timeframe, employer, tags, links, cover, coverAlt } = study.data;
---

<Base
  title={title}
  description={summary}
  image={{ url: ogImageUrl, alt: coverAlt }}
  type="article"
  structuredData={structuredData}
>
  <Shell id="case-study" labelledBy="case-study-title">
    <BackLink slot="lead" />
    <article class="case-study">
      <header class="head">
        <p class="label">{caseStudyLabel(study.data)}</p>
        <h1 id="case-study-title">{title}</h1>
        <p class="summary">{summary}</p>
        <dl class="facts">
          <div>
            <dt>Role</dt>
            <dd>{role}</dd>
          </div>
          <div>
            <dt>Timeframe</dt>
            <dd>{timeframe}</dd>
          </div>
          {employer && (
            <div>
              <dt>Employer</dt>
              <dd>{employer}</dd>
            </div>
          )}
        </dl>
        <TagList tags={tags} />
      </header>
      <div class="cover sky-grade">
        <Image
          src={cover}
          alt={coverAlt}
          widths={[640, 1280]}
          sizes="(min-width: 48rem) 696px, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="card body">
        <slot />
      </div>
      {links.length > 0 && (
        <section class="links" aria-labelledby="links-heading">
          <h2 id="links-heading">Links</h2>
          <ul role="list">
            {links.map((link) => (
              <li>
                <a href={link.url}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
      {next && next.id !== study.id && (
        <nav class="next" aria-labelledby="next-heading">
          <p id="next-heading" class="next-label">
            Next case study
          </p>
          <CaseStudyCard
            href={withBase(`/work/${next.id}`)}
            title={next.data.title}
            label={caseStudyLabel(next.data)}
            cover={next.data.cover}
            coverAlt={next.data.coverAlt}
            headingLevel={2}
          />
        </nav>
      )}
      <p>
        <a class="btn btn-secondary" href={withBase('/projects')}>
          Back to all work
        </a>
      </p>
    </article>
  </Shell>
  {/* Reading progress: fixed, so it can sit last (the page's first child gets the top bar's padding). */}
  <div class="read-progress" aria-hidden="true"></div>
</Base>

<style>
  /*
   * Reading progress, a scroll-driven bar (no script) at the top of the window. It follows
   * the scroll, not the clock, so pausing animations leaves it running. Without scroll timelines it
   * stays hidden.
   */
  .read-progress {
    position: fixed;
    z-index: 20;
    inset: 0 0 auto;
    height: 3px;
    background: var(--color-accent);
    transform-origin: 0 50%;
    scale: 0 1;
  }

  @keyframes read-progress {
    to {
      scale: 1 1;
    }
  }

  @supports (animation-timeline: scroll()) {
    .read-progress {
      animation: read-progress linear both;
    }

    /* Own rule, more specific: the shorthand can't reset the timeline (see ScrollTop). */
    :global(body) .read-progress {
      animation-timeline: scroll(root);
    }
  }

  :global(.motion-paused) .read-progress {
    animation-play-state: running !important;
  }

  .next {
    display: grid;
    gap: var(--space-3);
    max-width: 24rem;
  }

  .next-label {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .case-study {
    display: grid;
    gap: var(--space-8);
  }

  .head {
    display: grid;
    gap: var(--space-3);
  }

  h1 {
    font-size: var(--text-hero);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .summary {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  dt {
    color: var(--color-text-muted);
  }

  dd {
    margin: 0;
    font-weight: var(--weight-medium);
  }

  .cover {
    overflow: hidden;
    border-radius: var(--radius-image);
  }

  .cover img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .body {
    display: grid;
    gap: var(--space-4);
    font-size: var(--text-base);
  }

  .body :global(h2) {
    font-size: var(--text-xl);
  }

  .body :global(p),
  .body :global(li) {
    color: var(--color-text-muted);
  }

  .links ul {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .links h2 {
    margin-block-end: var(--space-2);
    font-size: var(--text-xl);
  }
</style>
