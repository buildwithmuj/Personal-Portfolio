---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BackLink from '../components/BackLink.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Shell from '../components/Shell.astro';
import { caseStudyLabel } from '../lib/case-studies.ts';
import { withBase } from '../lib/paths.ts';
import Base from './Base.astro';

interface Props {
  study: CollectionEntry<'caseStudies'>;
  /** The next four studies after this one, in order and wrapping round, for the cards at its end. */
  more: CollectionEntry<'caseStudies'>[];
  ogImageUrl: string;
  ogImageSize: { width: number; height: number };
  structuredData: string;
}

const { study, more, ogImageUrl, ogImageSize, structuredData } = Astro.props;
const { title, summary, role, employer, tags, stats, links, cover, coverAlt } = study.data;
---

<Base
  title={title}
  description={summary}
  image={{ url: ogImageUrl, alt: coverAlt, ...ogImageSize }}
  type="article"
  structuredData={structuredData}
>
  <Shell id="case-study" labelledBy="case-study-title">
    <BackLink slot="lead" />
    <article class="case-study">
      {/* The head is three lines: what it is, its title, and one line about it. */}
      <header class="head">
        <p class="label">{caseStudyLabel(study.data)}</p>
        <h1 id="case-study-title">{title}</h1>
        <p class="summary">{summary}</p>
      </header>
      <div class="cover sky-grade">
        <Image
          src={cover}
          alt={coverAlt}
          widths={[640, 1280]}
          sizes="(min-width: 48rem) 696px, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      {/* The facts, in one row on the page itself: the role, who it was with, and what it involved. */}
      <dl class="facts">
        <div>
          <dt>Role</dt>
          <dd>{role}</dd>
        </div>
        {employer && (
          <div>
            <dt>With</dt>
            <dd>{employer}</dd>
          </div>
        )}
        {tags.length > 0 && (
          <div>
            <dt>Focus</dt>
            <dd>{tags.join(', ')}</dd>
          </div>
        )}
      </dl>
      {stats.length > 0 && (
        <ul class="stats" role="list">
          {stats.map(({ value, label }) => (
            <li>
              <b>{value}</b>
              {label}
            </li>
          ))}
        </ul>
      )}
      {/* The story, as numbered steps: each heading at the left, what it covers beside it. */}
      <div class="card body">
        <slot />
      </div>
      {links.length > 0 && (
        <section class="links" aria-labelledby="links-heading">
          <h2 id="links-heading">Links</h2>
          <ul role="list">
            {links.map((link) => (
              <li>
                <a href={link.url}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
      {more.length > 0 && (
        <nav class="more" aria-labelledby="more-heading">
          <h2 id="more-heading" class="more-label">
            More case studies
          </h2>
          <ul class="more-row" role="list">
            {more.map((other) => (
              <li>
                <CaseStudyCard
                  href={withBase(`/work/${other.id}`)}
                  title={other.data.title}
                  label={caseStudyLabel(other.data)}
                  cover={other.data.cover}
                  coverAlt={other.data.coverAlt}
                  small
                />
              </li>
            ))}
          </ul>
        </nav>
      )}
      <p>
        <a class="btn btn-secondary" href={withBase('/projects')}>
          Back to all work
        </a>
      </p>
    </article>
  </Shell>
  {/* Reading progress: fixed, so it can sit last (the page's first child gets the top bar's padding). */}
  <div class="read-progress" aria-hidden="true"></div>
</Base>

<style>
  /*
   * Reading progress, a scroll-driven bar (no script) at the top of the window. It follows
   * the scroll, not the clock, so pausing animations leaves it running. Without scroll timelines it
   * stays hidden.
   */
  .read-progress {
    position: fixed;
    z-index: 20;
    inset: 0 0 auto;
    height: 3px;
    background: var(--color-accent);
    transform-origin: 0 50%;
    scale: 0 1;
  }

  @keyframes read-progress {
    to {
      scale: 1 1;
    }
  }

  @supports (animation-timeline: scroll()) {
    .read-progress {
      animation: read-progress linear both;
    }

    /* Own rule, more specific: the shorthand can't reset the timeline (see ScrollTop). */
    :global(body) .read-progress {
      animation-timeline: scroll(root);
    }
  }

  :global(.motion-paused) .read-progress {
    animation-play-state: running !important;
  }

  /*
   * The next four case studies, small, four in a row. On phones they're a swipe row, like Selected
   * work's deck: each card rests at the same inset, the last included, one card per swipe.
   */
  .more {
    display: grid;
    gap: var(--space-4);
    container-type: inline-size;
  }

  .more-label {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
  }

  .more-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width < 40rem) {
    .more-row {
      grid-template-columns: none;
      grid-auto-columns: 70cqi;
      grid-auto-flow: column;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--shell-pad));
      padding: 4px calc(var(--shell-pad) + 30cqi) 8px var(--shell-pad);
      overscroll-behavior-x: contain;
      scroll-padding-inline: var(--shell-pad);
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .more-row > li {
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
  }

  .case-study {
    display: grid;
    gap: var(--space-8);
  }

  .head {
    display: grid;
    gap: var(--space-3);
  }

  h1 {
    font-size: var(--text-hero);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .summary {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  /* No card of their own: the story's is the only one on the page. */
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    margin: 0;
  }

  dt {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  dd {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  /* Figures, where there are real ones: a large number in the accent over what it counts. */
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-16);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stats li {
    max-width: 14rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .stats b {
    display: block;
    color: var(--color-accent);
    font-size: var(--text-2xl);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
  }

  /* A band, not a poster: the story starts within the first screen. */
  .cover {
    overflow: hidden;
    border-radius: var(--radius-image);
  }

  .cover img {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
  }

  /*
   * The story's headings run down the left, each numbered, with what they cover beside them and a
   * hairline between one step and the next. The words are whatever the case study holds (paragraphs,
   * lists, figures), so they're placed by the grid itself: a heading takes the first column, and
   * everything up to the next heading follows in the second.
   */
  .body {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    row-gap: var(--space-3);
    font-size: var(--text-base);
    counter-reset: step;
  }

  .body > :global(*) {
    grid-column: 2;
  }

  .body > :global(h2) {
    grid-column: 1;
    padding-inline-end: var(--space-6);
    font-size: var(--text-lg);
    counter-increment: step;
  }

  .body > :global(h2)::before {
    display: block;
    margin-block-end: 2px;
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.08em;
    content: counter(step, decimal-leading-zero);
  }

  .body > :global(h2 ~ h2),
  .body > :global(h2 ~ h2 + *) {
    margin-block-start: var(--space-3);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--color-shell);
  }

  @media (width < 48rem) {
    .stats {
      column-gap: var(--space-8);
    }

    .body {
      grid-template-columns: minmax(0, 1fr);
    }

    .body > :global(*),
    .body > :global(h2) {
      grid-column: 1;
    }

    .body > :global(h2 ~ h2 + *) {
      margin-block-start: 0;
      padding-block-start: 0;
      border-block-start: 0;
    }
  }

  .body :global(p),
  .body :global(li) {
    color: var(--color-text-muted);
  }

  .links ul {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .links h2 {
    margin-block-end: var(--space-2);
    font-size: var(--text-xl);
  }
</style>
