---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BackLink from '../components/BackLink.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Shell from '../components/Shell.astro';
import TagList from '../components/TagList.astro';
import { caseStudyLabel } from '../lib/case-studies.ts';
import { withBase } from '../lib/paths.ts';
import Base from './Base.astro';

interface Props {
  study: CollectionEntry<'caseStudies'>;
  /** The next four studies after this one, in order and wrapping round, for the cards at its end. */
  more: CollectionEntry<'caseStudies'>[];
  ogImageUrl: string;
  ogImageSize: { width: number; height: number };
  structuredData: string;
}

const { study, more, ogImageUrl, ogImageSize, structuredData } = Astro.props;
const { title, summary, role, employer, tags, links, cover, coverAlt } = study.data;
---

<Base
  title={title}
  description={summary}
  image={{ url: ogImageUrl, alt: coverAlt, ...ogImageSize }}
  type="article"
  structuredData={structuredData}
>
  <Shell id="case-study" labelledBy="case-study-title">
    <BackLink slot="lead" />
    <article class="case-study">
      <header class="head">
        <p class="label">{caseStudyLabel(study.data)}</p>
        <h1 id="case-study-title">{title}</h1>
        <p class="summary">{summary}</p>
        <dl class="facts">
          <div>
            <dt>Role</dt>
            <dd>{role}</dd>
          </div>
          {employer && (
            <div>
              <dt>Employer</dt>
              <dd>{employer}</dd>
            </div>
          )}
        </dl>
        <TagList tags={tags} />
      </header>
      <div class="cover sky-grade">
        <Image
          src={cover}
          alt={coverAlt}
          widths={[640, 1280]}
          sizes="(min-width: 48rem) 696px, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="card body">
        <slot />
      </div>
      {links.length > 0 && (
        <section class="links" aria-labelledby="links-heading">
          <h2 id="links-heading">Links</h2>
          <ul role="list">
            {links.map((link) => (
              <li>
                <a href={link.url}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
      {more.length > 0 && (
        <nav class="more" aria-labelledby="more-heading">
          <h2 id="more-heading" class="more-label">
            More case studies
          </h2>
          <ul class="more-row" role="list">
            {more.map((other) => (
              <li>
                <CaseStudyCard
                  href={withBase(`/work/${other.id}`)}
                  title={other.data.title}
                  label={caseStudyLabel(other.data)}
                  cover={other.data.cover}
                  coverAlt={other.data.coverAlt}
                  small
                />
              </li>
            ))}
          </ul>
        </nav>
      )}
      <p>
        <a class="btn btn-secondary" href={withBase('/projects')}>
          Back to all work
        </a>
      </p>
    </article>
  </Shell>
  {/* Reading progress: fixed, so it can sit last (the page's first child gets the top bar's padding). */}
  <div class="read-progress" aria-hidden="true"></div>
</Base>

<style>
  /*
   * Reading progress, a scroll-driven bar (no script) at the top of the window. It follows
   * the scroll, not the clock, so pausing animations leaves it running. Without scroll timelines it
   * stays hidden.
   */
  .read-progress {
    position: fixed;
    z-index: 20;
    inset: 0 0 auto;
    height: 3px;
    background: var(--color-accent);
    transform-origin: 0 50%;
    scale: 0 1;
  }

  @keyframes read-progress {
    to {
      scale: 1 1;
    }
  }

  @supports (animation-timeline: scroll()) {
    .read-progress {
      animation: read-progress linear both;
    }

    /* Own rule, more specific: the shorthand can't reset the timeline (see ScrollTop). */
    :global(body) .read-progress {
      animation-timeline: scroll(root);
    }
  }

  :global(.motion-paused) .read-progress {
    animation-play-state: running !important;
  }

  /*
   * The next four case studies, small, four in a row. On phones they're a swipe row, like Selected
   * work's deck: each card rests at the same inset, the last included, one card per swipe.
   */
  .more {
    display: grid;
    gap: var(--space-4);
    container-type: inline-size;
  }

  .more-label {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
  }

  .more-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width < 40rem) {
    .more-row {
      grid-template-columns: none;
      grid-auto-columns: 70cqi;
      grid-auto-flow: column;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--shell-pad));
      padding: 4px calc(var(--shell-pad) + 30cqi) 8px var(--shell-pad);
      overscroll-behavior-x: contain;
      scroll-padding-inline: var(--shell-pad);
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .more-row > li {
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
  }

  .case-study {
    display: grid;
    gap: var(--space-8);
  }

  .head {
    display: grid;
    gap: var(--space-3);
  }

  h1 {
    font-size: var(--text-hero);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .summary {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  dt {
    color: var(--color-text-muted);
  }

  dd {
    margin: 0;
    font-weight: var(--weight-medium);
  }

  .cover {
    overflow: hidden;
    border-radius: var(--radius-image);
  }

  .cover img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .body {
    display: grid;
    gap: var(--space-4);
    font-size: var(--text-base);
  }

  .body :global(h2) {
    font-size: var(--text-xl);
  }

  .body :global(p),
  .body :global(li) {
    color: var(--color-text-muted);
  }

  .links ul {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .links h2 {
    margin-block-end: var(--space-2);
    font-size: var(--text-xl);
  }
</style>
