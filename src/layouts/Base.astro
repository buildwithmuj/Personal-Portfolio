---
import '../styles/tokens.css';
import '../styles/global.css';
import { Font } from 'astro:assets';
import Seo from '../components/Seo.astro';
import Footer from '../components/Footer.astro';
import TopBar from '../components/TopBar.astro';
import { getProfile } from '../lib/content.ts';
import { isProduction } from '../lib/mode.ts';

interface Props {
  title?: string;
  description?: string;
  image?: { url: string; alt: string };
  type?: 'website' | 'article';
  structuredData?: string;
  noindex?: boolean;
}

const { title, description, image, type = 'website', structuredData, noindex } = Astro.props;
const profile = await getProfile();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-mona" preload />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Seo
      {...(title ? { title } : {})}
      siteName={profile.name}
      headline={profile.titleTagline}
      path={Astro.url.pathname}
      description={description ?? profile.seo.description}
      image={image ?? { url: profile.seo.image, alt: profile.seo.imageAlt }}
      noindex={noindex === true || !isProduction}
      type={type}
      {...(structuredData ? { structuredData } : {})}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="container page">
      <TopBar profile={profile} />
      <main id="main" tabindex="-1" class="stack">
        <slot />
      </main>
      <Footer name={profile.name} />
    </div>
  </body>
</html>

<style>
  .page {
    padding-block-start: var(--bar-offset);
  }
</style>
