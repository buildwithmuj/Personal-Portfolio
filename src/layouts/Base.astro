---
import '../styles/tokens.css';
import '../styles/global.css';
import { Font } from 'astro:assets';
import Seo from '../components/Seo.astro';
import Footer from '../components/Footer.astro';
import ScrollTop from '../components/ScrollTop.astro';
import TopBar from '../components/TopBar.astro';
import VisitCount from '../components/VisitCount.astro';
import { readFileSync } from 'node:fs';
import { getProfile } from '../lib/content.ts';
import { isProduction } from '../lib/mode.ts';
import { MOTION_SCRIPT } from '../lib/motion.ts';
import { withBase } from '../lib/paths.ts';

interface Props {
  title?: string;
  description?: string;
  image?: { url: string; alt: string; width?: number; height?: number };
  type?: 'website' | 'article';
  structuredData?: string;
  noindex?: boolean;
}

const { title, description, image, type = 'website', structuredData, noindex } = Astro.props;
const profile = await getProfile();
// The default link-preview image's size, from its PNG header, so previews can draw it at once.
const ogPng = readFileSync(`public${profile.seo.image}`);
const ogSize = { width: ogPng.readUInt32BE(16), height: ogPng.readUInt32BE(20) };
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- GitHub Pages can't send headers; this one works from markup (spec §15, 2026-09-26). -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {/* Paused animations stay paused from the first frame (src/lib/motion.ts). */}
    <script is:inline set:html={MOTION_SCRIPT}></script>
    <Font cssVariable="--font-mona" preload />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <Seo
      {...(title ? { title } : {})}
      siteName={profile.name}
      headline={profile.titleTagline}
      path={Astro.url.pathname}
      description={description ?? profile.seo.description}
      image={
        image ?? {
          url: withBase(profile.seo.image),
          alt: profile.seo.imageAlt,
          ...ogSize,
        }
      }
      noindex={noindex === true || !isProduction}
      type={type}
      {...(structuredData ? { structuredData } : {})}
    />
  </head>
  <body id="home">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="container page">
      <TopBar profile={profile} />
      <main id="main" tabindex="-1" class="stack">
        <slot />
      </main>
      <Footer name={profile.name} />
    </div>
    <ScrollTop />
    <VisitCount />
    <script>
      // Scroll reveals (global.css). Anything already on screen stays put; the rest rises in on entry.
      if (
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
        'IntersectionObserver' in window
      ) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('in');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        for (const element of document.querySelectorAll('[data-reveal]')) {
          if (element.getBoundingClientRect().top < window.innerHeight) element.classList.add('in');
          else observer.observe(element);
        }
        document.documentElement.classList.add('reveal-ready');
      }
    </script>
  </body>
</html>

<style>
  .page {
    padding-block-start: var(--bar-offset);
  }
</style>
